// The shared structs of the Settings tab (M7 Task 1). Change them only through the orchestrator.

export enum SetKind { none, pill, switch, segmented, select, slider, colour, save, key, mic, text }
export enum BlockKind { row, wall, about, slint, note, model }

// face: the font-family for the font select ("" = the UI font)
export struct SetOption { id: string, name: string, face: string }
// alt: show label-alt instead (Mark, then Marked); both words are laid out in one cell
// icon: path data (24 unit box); with an empty label it is a square icon button. tip: said on hover. warn: the
// icon in the warning colour.
export struct SetButton { id: string, label: string, label-alt: string, off: bool, alt: bool, icon: string, tip: string, warn: bool }
export struct SetRow {
    id: string, icon: string, label: string, sub: string, sub-tip: string, row-tip: string,
    warn: bool, off: bool, tap: bool,
    block: BlockKind, kind: SetKind,
    on: bool,                                   // a switch
    value: string, options: [SetOption],        // segmented and select: the chosen id; pill: the text
    num: int, num-max: int, num-text: string,   // slider
    reset: bool,                                // a Reset link before the control
    colour: color, code: string, code-wide: bool,   // colour field: swatch colour, code text, 172 px field
    save-dirty: bool, save-title: string,
    placeholder: string,                        // text: the faint words while it is empty
    buttons: [SetButton],
    note: string,                               // BlockKind.note and about text
    y: length, h: length,                       // inside the panel, snapped
    flash: float,                               // 0..1, the flash fill alpha scale
    // The Dictation page (M8 Task 25). `value` is the key text or the chosen microphone; `num` the download percentage.
    capturing: bool,                            // key: the field waits for a key
    testing: bool,                              // mic: the meter is live
    limited: bool,                              // language select: the model picks its own language
    vendor: string,                             // model block: "openai" or "nvidia"
    size-text: string, recommended: bool, badge: string,
    state: string,                              // model block: absent, downloading, installed or active
    button-title: string,                       // the tooltip of the Uninstall or Disable button
    // A plugin's card (2026-11-08): its brand logo (path data, filled in logo-fill on a white tile); "" draws icon.
    logo: string, logo-fill: color,
}
export struct SetSection {
    id: string, title: string, tag: string,
    action-save: bool, action-dirty: bool, action-title: string,
    title-y: length, panel-y: length, panel-h: length,
    rows: [SetRow],
}
export struct RailItem { id: string, label: string, icon: string, end: bool, chosen: bool, y: length }
export struct SetHit { id: string, icon: string, label: string, sub: string, where: string, selected: bool, y: length }
export struct WallCard {
    id: string, name: string, on: bool, edit: bool, edit-name: string,
    bg: color, fg: color, cursor: color, green: color, yellow: color, blue: color, cyan: color, red: color,
    x: length, y: length,
    // the laid-out width (whole device pixel edges); 0 draws the card's own 196
    w: length,
}
export struct HelpRowData {
    key: string, name: string, command: string, header: string,
    keys: bool, danger: bool, active: bool, striped: bool, copied: bool, failed: bool,
}
export struct HelpChip { id: string, name: string, on: bool }
// one colour well of the theme editor
export struct EditorWell { key: string, label: string, text: string, colour: color, wide: bool, open: bool }

// What one Dictation model row drew, for the e2e (and the row's own tests): its mark and name, and each of its
// two buttons' rectangle (in the row) and look. Lengths are css px, relative to the row.
export struct RowLook {
    id: string, row-h: length,
    mark-x: length, mark-y: length, mark-w: length, mark-h: length, name-x: length,
    b0-id: string, b0-x: length, b0-y: length, b0-w: length, b0-h: length,
    b0-fill: color, b0-edge: color, b0-radius: length, b0-ink: color,
    b1-id: string, b1-x: length, b1-y: length, b1-w: length, b1-h: length,
    b1-fill: color, b1-edge: color, b1-radius: length, b1-ink: color,
}

// A plugin's details sheet (plugin_sheet.slint): one level of a dropdown tile (tone 0 plain, 1 the brand's usual, 2
// amber), and one tile (kind 0 toggle, 1 dropdown, 2 fact). caps: the label in capitals. value: a dropdown's level id
// or a fact; value-name: what is shown; chosen: the level's index; words: the permission's words in Settings.
export struct SheetOption { id: string, name: string, tone: int }
export struct SheetTile {
    key: string, label: string, caps: string, kind: int, on: bool, value: string, value-name: string, tone: int,
    chosen: int, options: [SheetOption], detail: string, words: string,
}
