// Settings > Machines (remote sessions PR 7): the table of linked machines and the Add a machine dialog. The owner's
// picks (2026-11-12 mockups): no subtext; a table with Machine (the system's logo and the name), Address, Flare, Status
// and a menu (Test, Remove). Machine pairing PR 1 (approved mockup 2026-11-14, rule 1237): "+ Add a machine" opens a
// Flare dialog (the Dialog look): a Machine drop-down (nearby computers, then the SSH config hosts, then "Type an
// address"), Cancel and Add, and one red line when the check failed.
//
// The rows are SetRow data (types.slint): a machine's `label` is its name, `value` its address (or SSH host), `note`
// the Flare version, `state` its status word (unknown, checking, linked, failed), `badge` the status's words, `sub` the
// line of a failed check (one small grey line under the row, never a tooltip: owner rule 2026-11-13), and `vendor` its
// system (mac, pc, ""). The dialog draws a MachineAddLook (types.slint).

import { Theme, Px, SettingsInk, SettingsFixed, SettingsShape } from "../theme.slint";
import { Glyphs } from "../glyphs.slint";
import { SetRow, SetOption, MachineAddLook } from "types.slint";
import { SetTextField } from "controls.slint";
import { SetSelect, SelectMenu } from "select.slint";
import { DialogButton } from "../dialog.slint";

// The columns' left edges as parts of the row's width, shared by the heading and the rows.
global MachineCols {
    out property <float> host: 0.36;
    out property <float> flare: 0.58;
    out property <float> status: 0.72;
    out property <length> pad: 14px;
    out property <length> menu-w: 40px;
}

// A machine's system: the Apple logo for a Mac, the Windows logo for a PC, nothing when it is not known.
export component MachineLogo inherits Path {
    in property <string> os;
    in property <length> size: 15px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.os == "mac" ? Glyphs.logo-mac : root.os == "pc" ? Glyphs.logo-pc : "";
    fill: Theme.text;
    visible: root.os != "";
}

// A column's name.
component MachineHeadText inherits Text {
    font-family: Theme.font-ui;
    font-size: 12px;
    color: Theme.dim;
    vertical-alignment: center;
    overflow: elide;
}

// One line of the heading: the four column names.
export component SetMachineHead inherits Rectangle {
    in property <bool> first;
    MachineHeadText { x: MachineCols.pad; width: root.width * MachineCols.host - MachineCols.pad - 8px; height: root.height; text: "Machine"; }
    MachineHeadText { x: root.width * MachineCols.host; width: root.width * (MachineCols.flare - MachineCols.host) - 8px; height: root.height; text: "Address"; }
    MachineHeadText { x: root.width * MachineCols.flare; width: root.width * (MachineCols.status - MachineCols.flare) - 8px; height: root.height; text: "Flare"; }
    MachineHeadText { x: root.width * MachineCols.status; width: root.width * (1 - MachineCols.status) - MachineCols.menu-w; height: root.height; text: "Status"; }
}

// One linked machine. A machine that is Not linked is 18 px taller: its columns keep the top 50 px (`band`) and the
// reason is one grey line under them, from the name's left edge to the menu, elided rather than wrapped.
export component SetMachineRow inherits Rectangle {
    in property <SetRow> data;
    in property <bool> menu-open;
    callback menu-request(length, length, length, length);
    property <length> band: root.data.sub != "" ? root.height - 18px : root.height;

    // The rule between machines, edge to edge (a table).
    Rectangle {
        y: 0px;
        width: parent.width;
        height: Px.hair();
        background: Theme.line;
    }
    HorizontalLayout {
        x: MachineCols.pad;
        width: root.width * MachineCols.host - MachineCols.pad - 8px;
        y: 0px;
        height: root.band;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            MachineLogo { os: root.data.vendor; }
        }
        Text {
            text: root.data.label;
            font-family: Theme.font-ui;
            font-size: 13.5px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Text {
        x: root.width * MachineCols.host;
        width: root.width * (MachineCols.flare - MachineCols.host) - 8px;
        y: 0px;
        height: root.band;
        text: root.data.value;
        font-family: SettingsFixed.font-mono;
        font-size: 12.5px;
        color: Theme.text-soft;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.width * MachineCols.flare;
        width: root.width * (MachineCols.status - MachineCols.flare) - 8px;
        y: 0px;
        height: root.band;
        text: root.data.note;
        font-family: Theme.font-ui;
        font-size: 13px;
        color: Theme.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    status := HorizontalLayout {
        x: root.width * MachineCols.status;
        width: root.width * (1 - MachineCols.status) - MachineCols.menu-w;
        y: 0px;
        height: root.band;
        spacing: 7px;
        alignment: start;
        property <color> ink: root.data.state == "linked" ? SettingsFixed.copied
            : root.data.state == "failed" ? Theme.danger-fill : Theme.dim;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: status.ink;
                visible: root.data.state != "unknown";
            }
        }
        Text {
            text: root.data.badge;
            font-family: Theme.font-ui;
            font-size: 13px;
            font-weight: 500;
            color: status.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Why the last check failed: one grey line in the settings' sub line style, from the name's left edge (the logo and
    // its 8 px gap in) to the menu. Words only: no tooltip.
    if root.data.sub != "": Text {
        x: MachineCols.pad + 23px;
        y: Px.snap(root.band - 6px);
        width: root.width - MachineCols.pad - 23px - MachineCols.menu-w;
        height: 16px;
        text: root.data.sub;
        font-family: Theme.font-ui;
        font-size: 11.5px;
        color: SettingsInk.sub;
        vertical-alignment: center;
        overflow: elide;
    }
    // The ⋯ menu: Test and Remove (the Select menu, opened under the button).
    more := Rectangle {
        x: root.width - MachineCols.menu-w + 4px;
        y: Px.snap((root.band - 30px) / 2);
        width: 30px;
        height: 30px;
        border-radius: SettingsShape.radius-sm;
        background: mta.has-hover || root.menu-open ? Theme.hover : transparent;
        accessible-role: AccessibleRole.button;
        accessible-label: "More for " + root.data.label;
        accessible-action-default => { root.menu-request(more.absolute-position.x - 120px + more.width, more.absolute-position.y, 120px, more.height); }
        for i in 3: Rectangle {
            x: Px.snap(more.width / 2 - 1.6px + (i - 1) * 6px);
            y: Px.snap(more.height / 2 - 1.6px);
            width: 3.2px;
            height: 3.2px;
            border-radius: 1.6px;
            background: Theme.text-soft;
        }
        mta := TouchArea {
            clicked => { root.menu-request(more.absolute-position.x - 120px + more.width, more.absolute-position.y, 120px, more.height); }
        }
    }
}

// A field's name over it in the dialog: 12 px, dim (the mockup's `.lbl`).
component MachineFieldLabel inherits Text {
    font-family: Theme.font-ui;
    font-size: 12px;
    color: Theme.dim;
    overflow: elide;
}

// The Add a machine dialog (machine pairing PR 1, rule 1237), in the Dialog look (dialog.slint): a 380 px box on the
// scrim, the title, the Machine drop-down ("Pick a machine" until a pick), the Address and User fields while "Type an
// address" is picked, the red line of a failed check, Cancel and Add. Machine pairing PR 3 adds "Code shown on <name>"
// under the drop-down for a nearby computer. Escape and a press outside cancel unless a check runs; Enter adds once
// Add can be pressed. The drop-down's menu is drawn inside the dialog, above it (the Settings Select menu's state:
// the window's own menu stays closed while the dialog is open). Labelled controls have no tooltip.
export component MachineAddDialog inherits Rectangle {
    in property <bool> open;
    in property <MachineAddLook> look;
    in property <bool> menu-open;
    in property <[SetOption]> menu-options;
    in property <string> menu-value;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-w;
    in property <length> menu-h;
    in-out property <int> menu-highlight: -1;
    callback pick-request(length, length, length, length);
    callback menu-chosen(string);
    callback menu-dismissed();
    callback menu-key(string);
    callback address-edited(string);
    callback user-edited(string);
    callback cancel();
    callback add();
    out property <length> box-x: box.x;
    out property <length> box-y: box.y;
    out property <length> box-w: box.width;
    out property <length> box-h: box.height;
    out property <length> pick-x: machine.absolute-position.x;
    out property <length> pick-y: machine.absolute-position.y;
    out property <length> pick-w: machine.width;
    out property <length> add-x: add-btn.absolute-position.x;
    out property <length> add-y: add-btn.absolute-position.y;
    out property <length> add-w: add-btn.width;
    out property <length> cancel-x: cancel-btn.absolute-position.x;
    out property <length> cancel-y: cancel-btn.absolute-position.y;
    out property <length> cancel-w: cancel-btn.width;
    out property <bool> pick-has-focus: machine.keyboard-focus || fs.has-focus;

    visible: root.open;
    width: 100%;
    height: 100%;
    changed open => {
        if root.open {
            machine.focus-me();
        }
    }
    // A pick closed the menu: the keys go back to the drop-down (the Address field takes them itself when it shows).
    changed menu-open => {
        if !root.menu-open && root.open && !root.look.typing {
            machine.focus-me();
        }
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if e.text == Key.Escape {
                if !root.look.busy {
                    root.cancel();
                }
                return accept;
            }
            if e.text == Key.Return {
                if root.look.can-add {
                    root.add();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.scrim;
        }
        // A press outside the box cancels, unless a check runs.
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && !root.look.busy {
                    root.cancel();
                }
            }
        }
        box := Rectangle {
            width: min(380px, root.width - 48px);
            height: col.preferred-height;
            x: Px.snap((root.width - self.width) / 2);
            y: Px.snap((root.height - self.height) / 2);
            background: Theme.side-flat;
            border-radius: 2px;
            border-width: Px.hair();
            border-color: Theme.divider;
            drop-shadow-offset-y: 24px;
            drop-shadow-blur: 70px;
            drop-shadow-color: SettingsFixed.modal-shadow;
            // Swallows presses inside the box, so they never reach the scrim.
            TouchArea {
                width: parent.width;
                height: parent.height;
            }
            col := VerticalLayout {
                padding: 20px;
                alignment: start;
                Text {
                    text: "Add a machine";
                    font-family: Theme.font-ui;
                    font-size: 14.5px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Rectangle { height: 16px; }
                MachineFieldLabel { text: "Machine"; }
                Rectangle { height: 6px; }
                machine := SetSelect {
                    options: root.look.options;
                    value: root.look.pick;
                    placeholder: "Pick a machine";
                    label: "Machine";
                    sub: "";
                    disabled: root.look.busy;
                    open: root.menu-open;
                    open-request(x, y, w, h) => { root.pick-request(Px.snap(x), Px.snap(y), Px.snap(x + w) - Px.snap(x), Px.snap(y + h) - Px.snap(y)); }
                }
                if root.look.typing: VerticalLayout {
                    init => { address.focus-me(); }
                    Rectangle { height: 14px; }
                    MachineFieldLabel { text: "Address"; }
                    Rectangle { height: 6px; }
                    address := SetTextField {
                        width: box.width - 40px;
                        text: root.look.address;
                        placeholder: "Name or IP address";
                        label: "Address";
                        sub: "";
                        off: root.look.busy;
                        edited(t) => { root.address-edited(t); }
                        accepted => {
                            if root.look.can-add {
                                root.add();
                            }
                        }
                    }
                    Rectangle { height: 14px; }
                    MachineFieldLabel { text: "User"; }
                    Rectangle { height: 6px; }
                    SetTextField {
                        width: box.width - 40px;
                        text: root.look.user;
                        placeholder: "Optional";
                        label: "User";
                        sub: "";
                        off: root.look.busy;
                        edited(t) => { root.user-edited(t); }
                        accepted => {
                            if root.look.can-add {
                                root.add();
                            }
                        }
                    }
                }
                // The red line of a failed check: a red dot and the words (the mockup's "Wrong code" line).
                if root.look.error != "": VerticalLayout {
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 7px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.danger-fill;
                            }
                        }
                        Text {
                            text: root.look.error;
                            font-family: Theme.font-ui;
                            font-size: 12.5px;
                            color: Theme.text;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { height: 20px; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    cancel-btn := DialogButton {
                        label: "Cancel";
                        enabled: !root.look.busy;
                        clicked => { root.cancel(); }
                    }
                    add-btn := DialogButton {
                        label: root.look.busy ? "Checking" : "Add";
                        is-primary: true;
                        enabled: root.look.can-add;
                        clicked => { root.add(); }
                    }
                }
            }
        }
    }
    SelectMenu {
        width: parent.width;
        height: parent.height;
        open: root.menu-open;
        options: root.menu-options;
        value: root.menu-value;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-w: root.menu-w;
        menu-h: root.menu-h;
        highlight <=> root.menu-highlight;
        chosen(id) => { root.menu-chosen(id); }
        dismissed => { root.menu-dismissed(); }
        key(k) => { root.menu-key(k); }
    }
}

// The test window: one heading and one machine row, on sample data the test sets.
export component MachinesPreview inherits Window {
    preferred-width: 760px;
    preferred-height: 220px;
    in property <SetRow> machine;
    out property <int> menus: 0;
    background: Theme.ground;
    SetMachineHead { x: 0px; y: 0px; width: root.width; height: 34px; first: true; }
    // The machine's `h` when the test sets one (68 for a Not linked machine with its reason line), else 50.
    mrow := SetMachineRow {
        x: 0px;
        y: 34px;
        width: root.width;
        height: root.machine.h > 0px ? root.machine.h : 50px;
        data: root.machine;
        menu-request(x, y, w, h) => { root.menus += 1; }
    }
}

// The dialog's test window: the dialog over a stand-in page, its menu run the way the controller runs it (opened under
// the drop-down, a pick sets the look's pick), and counts of what it reported.
export component MachineAddPreview inherits Window {
    preferred-width: 900px;
    preferred-height: 600px;
    background: Theme.ground;
    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = self.win-scale; }
    init => { Px.scale = self.win-scale; }
    in-out property <bool> open;
    in-out property <MachineAddLook> look;
    in-out property <bool> menu-open;
    in-out property <int> adds;
    in-out property <int> cancels;
    in-out property <string> address-typed;
    in-out property <string> user-typed;
    in-out property <string> picked;
    in-out property <int> behind-clicks;
    out property <length> box-x: dlg.box-x;
    out property <length> box-y: dlg.box-y;
    out property <length> box-w: dlg.box-w;
    out property <length> box-h: dlg.box-h;
    out property <length> pick-x: dlg.pick-x;
    out property <length> pick-y: dlg.pick-y;
    out property <length> pick-w: dlg.pick-w;
    out property <length> add-x: dlg.add-x;
    out property <length> add-y: dlg.add-y;
    out property <length> add-w: dlg.add-w;
    out property <length> cancel-x: dlg.cancel-x;
    out property <length> cancel-y: dlg.cancel-y;
    out property <length> cancel-w: dlg.cancel-w;
    property <length> mx;
    property <length> my;
    property <length> mw;

    TouchArea {
        clicked => { root.behind-clicks += 1; }
    }
    dlg := MachineAddDialog {
        open: root.open;
        look: root.look;
        menu-open: root.menu-open;
        menu-options: root.look.options;
        menu-value: root.look.pick;
        menu-x: root.mx;
        menu-y: root.my + 4px;
        menu-w: root.mw;
        menu-h: root.look.options.length * SettingsShape.option-h + 4px;
        pick-request(x, y, w, h) => {
            root.mx = x;
            root.my = y + h;
            root.mw = w;
            root.menu-open = true;
        }
        menu-chosen(id) => {
            root.menu-open = false;
            root.picked = id;
        }
        menu-dismissed => { root.menu-open = false; }
        address-edited(t) => { root.address-typed = t; }
        user-edited(t) => { root.user-typed = t; }
        cancel => { root.cancels += 1; }
        add => { root.adds += 1; }
    }
}
