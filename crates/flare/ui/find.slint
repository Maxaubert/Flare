// The find bar (Milestone 5, Task 17): Prism Terminal TermFind.tsx drawn in whole device pixels.
// A box 12 px from the top right of its parent: input, readout, previous, next, close. No shadow.
import { Theme, Px } from "theme.slint";
import { Glyphs } from "glyphs.slint";

component FindButton inherits Rectangle {
    in property <string> path;
    in property <string> label;
    in property <bool> live: true;
    callback activated();

    width: Px.snap(20px);
    height: Px.snap(20px);
    border-radius: Theme.radius-button;
    background: root.live && ta.has-hover ? Theme.hover : transparent;
    opacity: root.live ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;

    Path {
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: transparent;
        stroke: root.live && ta.has-hover ? Theme.text : Theme.icon;
        stroke-width: 2.2 * 12px / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea {
        enabled: root.live;
        clicked => { root.activated(); }
    }
}

export component FindBar inherits Rectangle {
    in property <bool> open;
    in-out property <string> query;
    in property <string> readout;              // "", "none", "1000+", "3 of 12"
    in property <bool> can-step;               // false: previous and next are dimmed and do nothing
    out property <bool> input-has-focus: input.has-focus;
    callback query-edited(string);             // every edit
    callback next();
    callback previous();
    callback close();
    public function focus-input() {
        input.focus();
        input.select-all();
    }

    changed open => {
        if (root.open) {
            root.focus-input();
        }
    }

    // The readout is at least 52 px wide and grows with its text, so the box grows with it.
    property <length> readout-w: max(52px, measure.preferred-width);

    bar := Rectangle {
        visible: root.open;
        width: Px.snap(16px + 180px + 6px + root.readout-w + 6px + 20px + 6px + 20px + 6px + 20px) + 2 * Px.hair();
        height: Px.snap(28px) + 2 * Px.hair();
        x: Px.snap(root.width - self.width - 12px);
        y: Px.snap(12px);
        background: Theme.side-flat;
        border-radius: Theme.radius-sm;
        border-width: Px.hair();
        border-color: Theme.divider;

        // Swallows a press on the bar itself so it never reaches the grid beneath
        // (declared first, so the input and the buttons stay above it).
        TouchArea { }

        // The input, its placeholder and the keys that belong to the bar.
        FocusScope {
            x: Px.hair() + Px.snap(8px);
            y: Px.hair() + Px.snap(4px);
            width: Px.snap(180px);
            height: Px.snap(20px);
            capture-key-pressed(event) => {
                if (event.text == Key.Return) {
                    if (event.modifiers.shift) {
                        root.previous();
                    } else {
                        root.next();
                    }
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.query;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: "Find in terminal";
                edited => { root.query-edited(self.text); }
            }
            if input.text == "" : Text {
                width: parent.width;
                height: parent.height;
                text: "Find in terminal";
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.dim2;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // The readout, right-aligned in a box at least 52 px wide.
        Rectangle {
            x: Px.hair() + Px.snap(8px + 180px + 6px);
            y: Px.hair() + Px.snap(4px);
            width: Px.snap(root.readout-w);
            height: Px.snap(20px);
            measure := Text {
                x: parent.width - self.width;
                width: self.preferred-width;
                height: parent.height;
                text: root.readout;
                font-family: Theme.font-ui;
                font-size: 11px;
                color: Theme.dim2;
                vertical-alignment: center;
                horizontal-alignment: right;
                wrap: no-wrap;
            }
        }

        FindButton {
            x: bar.width - Px.hair() - Px.snap(8px + 20px + 6px + 20px + 6px + 20px);
            y: Px.hair() + Px.snap(4px);
            path: Glyphs.chevron-up;
            label: "Previous match";
            live: root.can-step;
            activated => { root.previous(); }
        }
        FindButton {
            x: bar.width - Px.hair() - Px.snap(8px + 20px + 6px + 20px);
            y: Px.hair() + Px.snap(4px);
            path: Glyphs.chevron-down;
            label: "Next match";
            live: root.can-step;
            activated => { root.next(); }
        }
        FindButton {
            x: bar.width - Px.hair() - Px.snap(8px + 20px);
            y: Px.hair() + Px.snap(4px);
            path: Glyphs.close;
            label: "Close find";
            activated => { root.close(); }
        }
    }
}

// The bar alone in an 800 x 400 window, for the component tests and the screenshots.
export component FindBarPreview inherits Window {
    preferred-width: 800px;
    preferred-height: 400px;
    background: Theme.ground;

    in-out property <bool> open: true;
    in-out property <string> query;
    in-out property <string> readout;
    in-out property <bool> can-step;
    out property <bool> input-has-focus: bar.input-has-focus;
    in-out property <string> last-query;
    in-out property <int> next-count;
    in-out property <int> previous-count;
    in-out property <int> close-count;
    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = self.win-scale; }
    init => { Px.scale = self.win-scale; }
    public function focus-input() { bar.focus-input(); }

    bar := FindBar {
        width: root.width;
        height: root.height;
        open: root.open;
        query <=> root.query;
        readout: root.readout;
        can-step: root.can-step;
        query-edited(q) => { root.last-query = q; }
        next => { root.next-count += 1; }
        previous => { root.previous-count += 1; }
        close => { root.close-count += 1; }
    }
}
