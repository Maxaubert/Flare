// The tab marks (M6 Task 24). Source: PT TabMark.tsx, AgentIcon.tsx, marks.css.
// Every thickness and edge is a whole number of device pixels (Px.snap); the motion values come from
// the Rust mark clock through MarkMotion, so a still window draws a still mark.
import { Theme, Px } from "theme.slint";
import { Glyphs } from "glyphs.slint";

// Slint fits a Path's viewbox into (width - stroke) x (height - stroke), inset by half the stroke, so a stroked
// Path below is made one stroke wider than its mark and placed half a stroke up and left: the viewbox then maps
// exactly onto the mark's own pixels, as an SVG would.

export global MarkMotion {
    in property <bool> still: false;
    in property <angle> spin: 0deg;
    in property <float> breathe: 1.0;
    // The run bar's eased travel, 0..1.
    in property <float> run: 0.0;
    // The rainbow's slide in css px, 0..114.
    in property <float> flow: 0.0;
    in property <float> pulse: 1.0;
    // The seven floored stops, or empty.
    in property <[color]> rainbow: [];
    // The agent icons' motions (flare_agent::icon_motion, picked by a plugin): the hop's rise (a fraction of the
    // icon's size, up negative) and squash, Clawd's shut eyes, O6's turn and fade, O1's turn, O4's size and fade,
    // and A1's colour for each path of agy's arch (empty until the clock runs).
    in property <float> hop-y: 0.0;
    in property <float> hop-sx: 1.0;
    in property <float> hop-sy: 1.0;
    in property <bool> blink: false;
    in property <angle> spin-fade: 0deg;
    in property <float> fade: 1.0;
    in property <angle> turn: 0deg;
    in property <float> grow: 1.0;
    in property <float> grow-alpha: 1.0;
    in property <[color]> agy-flow: [];
}

// ONE mono mark at a tab's end (Ring). state: 1 working (spinner), 2 question (breathing dot),
// 3 finished (check), 4 failed (cross). ink is the name's ink. It is a 12 x 12 px slot; the parent
// centres it in its own box (the strip's end box is 16, the sidebar's 18, the icon tab's corner disc 15).
export component MarkRing inherits Rectangle {
    in property <int> state;
    in property <color> ink;
    width: 12px;
    height: 12px;

    // The spinner: a 12 px circle (centreline radius 5, line 2), the top quarter turning; still, the
    // top and right quarters stand.
    property <angle> arc-from: MarkMotion.still ? -135deg : MarkMotion.spin - 135deg;
    property <angle> arc-to: MarkMotion.still ? 44.9deg : MarkMotion.spin - 45deg;

    if root.state == 1 : Path {
        x: -1px;
        y: -1px;
        width: 14px;
        height: 14px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M11 6a5 5 0 1 1-10 0a5 5 0 1 1 10 0z";
        fill: transparent;
        stroke: root.ink.with-alpha(0.24);
        stroke-width: 2px;
    }
    if root.state == 1 : Path {
        x: -1px;
        y: -1px;
        width: 14px;
        height: 14px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M" + (6 + 5 * cos(root.arc-from)) + " " + (6 + 5 * sin(root.arc-from))
            + "A5 5 0 0 1 " + (6 + 5 * cos(root.arc-to)) + " " + (6 + 5 * sin(root.arc-to));
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2px;
        stroke-line-cap: butt;
    }
    // The question: a 7 px dot that breathes.
    if root.state == 2 : Rectangle {
        width: Px.snap(7px);
        height: Px.snap(7px);
        x: Px.snap((12px - self.width) / 2);
        y: Px.snap((12px - self.height) / 2);
        border-radius: self.width / 2;
        background: root.ink;
        opacity: MarkMotion.still ? 1.0 : MarkMotion.breathe;
    }
    // The check: 12 px, line 2.4 of 16 units.
    if root.state == 3 : Path {
        x: -0.9px;
        y: -0.9px;
        width: 13.8px;
        height: 13.8px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Glyphs.check;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.4 * 12px / 16;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    // The cross: 10 px centred in the slot, line 2.4 of 16 units.
    if root.state == 4 : Path {
        x: Px.snap(1px) - 0.75px;
        y: Px.snap(1px) - 0.75px;
        width: 11.5px;
        height: 11.5px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: Glyphs.cross;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.4 * 10px / 16;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// The Bar mark along a tab's foot. kind 2 line, 3 run. The parent places it at the foot and gives it
// the tab's width.
export component MarkBar inherits Rectangle {
    in property <int> kind;
    in property <int> state;
    in property <color> colour;
    in property <bool> rainbow;
    clip: true;
    height: Px.snap(3px);

    property <length> w: root.width;
    // The seven stops of the rainbow, or the line colour when there are none.
    property <bool> ribbon-on: root.kind == 2 && root.rainbow && root.state == 3;
    property <bool> have: MarkMotion.rainbow.length >= 7;
    property <color> s0: root.have ? MarkMotion.rainbow[0] : root.colour;
    property <color> s1: root.have ? MarkMotion.rainbow[1] : root.colour;
    property <color> s2: root.have ? MarkMotion.rainbow[2] : root.colour;
    property <color> s3: root.have ? MarkMotion.rainbow[3] : root.colour;
    property <color> s4: root.have ? MarkMotion.rainbow[4] : root.colour;
    property <color> s5: root.have ? MarkMotion.rainbow[5] : root.colour;
    property <color> s6: root.have ? MarkMotion.rainbow[6] : root.colour;

    // Stop k of the tile; stop 7 is stop 0 again so the tile loops.
    pure function stop(k: int) -> color {
        return k == 0 ? root.s0 : k == 1 ? root.s1 : k == 2 ? root.s2 : k == 3 ? root.s3
            : k == 4 ? root.s4 : k == 5 ? root.s5 : k == 6 ? root.s6 : root.s0;
    }

    // The run: a bar 42% of the line, round ended, travelling from one bar left of the line to its end.
    if root.kind == 3 : Rectangle {
        width: MarkMotion.still ? root.w : Px.snap(root.w * 0.42);
        x: MarkMotion.still ? 0px : Px.snap(-0.42 * root.w + MarkMotion.run * 1.42 * root.w);
        y: 0px;
        height: root.height;
        border-radius: self.height / 2;
        background: root.colour;
    }
    // The line: the whole width in the colour; a question line breathes.
    if root.kind == 2 && !root.ribbon-on : Rectangle {
        width: root.w;
        height: root.height;
        background: root.colour;
        opacity: (root.state == 2 && !MarkMotion.still) ? MarkMotion.breathe : 1.0;
    }
    // The finished rainbow: six tiles of one tab (114 px) each sliding right one tile per lap.
    // Every edge of the ribbon and its 42 pieces is a whole device pixel (Task 34: at 175% a piece
    // ending mid-pixel left a column of the ground between two pieces in the software renderer).
    if root.ribbon-on : Rectangle {
        x: Px.snap((MarkMotion.still || !root.have) ? -114px : -114px + MarkMotion.flow * 1px);
        y: 0px;
        width: 6 * 114px;
        height: root.height;
        // One two-stop gradient per seventh of a tile: the software renderer drops the spans of a
        // gradient with eight stops, a two-stop one is exact in both renderers.
        for i in 42 : Rectangle {
            x: Px.snap(i * (114px / 7));
            width: Px.snap((i + 1) * (114px / 7)) - Px.snap(i * (114px / 7));
            height: root.height;
            background: @linear-gradient(90deg, root.stop(mod(i, 7)), root.stop(mod(i, 7) + 1));
        }
    }
}

// The agent's icon on a tab, 18 px: kind 0 shell (the >_ prompt, stroke 2.2, ink), 1 claude (Clawd,
// Theme.clawd), 2 codex (the OpenAI mark, ink), 3 agy (the pixel arch, one path per Theme.agy colour),
// 4 settings (the cog, stroke 1.7, ink).
// motion (owner 2026-10-26, flare_agent::icon_motion::IconMotion::code): 0 still, 1 hop-blink, 2 spin-fade,
// 3 rainbow-flow, 4 hop, 5 spin, 6 breathe. The window gives it only to a working agent's tab, and every frame comes
// from the mark clock (MarkMotion), never an animate: still with the clock stood (animation effects off) the icon
// is drawn as it is still. The hop and the breath move the icon's box (exact in both renderers); a turn is a
// transform, which the software renderer leaves out (the icon then only fades).
export component AgentIcon inherits Rectangle {
    in property <int> kind;
    in property <color> ink;
    in property <length> size: 18px;
    in property <int> motion: 0;
    width: size;
    height: size;

    property <int> m: MarkMotion.still ? 0 : root.motion;
    property <bool> hops: root.m == 1 || root.m == 4;
    property <float> sx: root.hops ? MarkMotion.hop-sx : root.m == 6 ? MarkMotion.grow : 1.0;
    property <float> sy: root.hops ? MarkMotion.hop-sy : root.m == 6 ? MarkMotion.grow : 1.0;
    property <bool> flows: root.m == 3 && MarkMotion.agy-flow.length >= 10;

    if root.kind == 0 : Path {
        x: -2.2 * root.size / 48;
        y: -2.2 * root.size / 48;
        width: root.size + 2.2 * root.size / 24;
        height: root.size + 2.2 * root.size / 24;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Glyphs.prompt;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 2.2 * root.size / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    // The moving box on whole device pixels of the window (owner 2026-11-13, "keep squash, snap to pixels";
    // flare_agent::icon_motion::icon_box is the rule): the rest size, the squashed size and the rise each round to
    // whole device pixels, and the box's edges land on whole device pixels wherever the icon sits, so no frame
    // smears across a fraction. The box keeps its centre across; a hop squashes about its art's feet, which stay on
    // the rest line (plus the rise), the breath keeps its centre down. feet: the lowest edge of the art in its view
    // box, as a fraction of the box's height (flare_agent::icon::CLAWD_FEET, AGY_FEET, OPENAI_FEET).
    property <float> feet: root.kind == 1 ? (10.04 + 2.5) / 17 : root.kind == 3 ? (8.02 + 1.5) / 11 : 1.0;
    property <length> ax: Px.snap(root.absolute-position.x);
    property <length> ay: Px.snap(root.absolute-position.y);
    property <length> rest: Px.snap(root.size);
    property <length> box-w: Px.snap(root.size * root.sx);
    property <length> box-h: Px.snap(root.size * root.sy);
    property <length> box-left: Px.snap(root.ax + (root.rest - root.box-w) / 2);
    property <length> box-top: root.hops
        ? root.ay + Px.snap(root.feet * root.rest) - Px.snap(root.feet * root.box-h) + Px.snap(MarkMotion.hop-y * root.size)
        : Px.snap(root.ay + (root.rest - root.box-h) / 2);
    property <bool> shut: root.kind == 1 && root.m == 1 && MarkMotion.blink;

    // The agent's mark, in the box the motion squashes and lifts. Each path fills the box
    // (fit: fill; the default contain scales both ways by the smaller), so the hop squashes and stretches.
    if root.kind >= 1 && root.kind <= 3 : body := Rectangle {
        width: root.box-w;
        height: root.box-h;
        x: root.box-left - root.absolute-position.x;
        y: root.box-top - root.absolute-position.y;
        opacity: root.m == 2 ? MarkMotion.fade : root.m == 6 ? MarkMotion.grow-alpha : 1.0;
        transform-rotation: root.m == 2 ? MarkMotion.spin-fade : root.m == 5 ? MarkMotion.turn : 0deg;

        if root.kind == 1 : Path {
            width: body.width;
            height: body.height;
            fit: fill;
            viewbox-x: 0.5;
            viewbox-y: -2.5;
            viewbox-width: 17;
            viewbox-height: 17;
            // H1's blink swaps in Clawd with his eyes shut: one shape, no lid laid over the body to leave a seam.
            commands: root.shut ? Glyphs.clawd-shut : Glyphs.clawd;
            fill: Theme.clawd;
        }
        if root.kind == 2 : Path {
            width: body.width;
            height: body.height;
            fit: fill;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Glyphs.openai;
            fill: root.ink;
        }
        if root.kind == 3 : Rectangle {
            for cells[i] in Glyphs.agy : Path {
                width: body.width;
                height: body.height;
                fit: fill;
                viewbox-x: -0.5;
                viewbox-y: -1.5;
                viewbox-width: 11;
                viewbox-height: 11;
                commands: cells;
                // A1: each path's colour flows along the arch.
                fill: root.flows ? MarkMotion.agy-flow[i] : Theme.agy[i];
            }
        }
    }
    if root.kind == 4 : Path {
        x: -1.7 * root.size / 48;
        y: -1.7 * root.size / 48;
        width: root.size + 1.7 * root.size / 24;
        height: root.size + 1.7 * root.size / 24;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Glyphs.cog;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.7 * root.size / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// The test window: a tab (tab-w x 36) with a Bar at its foot when mark-kind >= 2, a 16 px end box at
// (100, 10) holding a Ring when mark-kind == 1, the icon tab's 15 px corner disc at (300, 10) holding a
// Ring, and an AgentIcon at (340, 9).
export component MarkPreview inherits Window {
    in property <int> mark-kind;
    in property <int> mark-state;
    in property <color> mark-color: Theme.accent;
    in property <bool> mark-rainbow;
    in property <color> ink: Theme.text;
    in property <color> ground: Theme.ground;
    in property <length> tab-w: 150px;
    in property <int> icon-kind;
    in property <int> icon-motion;
    width: 400px;
    height: 36px;
    background: root.ground;

    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = root.win-scale; }
    init => { Px.scale = root.win-scale; }

    if root.mark-kind >= 2 : MarkBar {
        x: 0px;
        y: 36px - self.height;
        width: Px.snap(root.tab-w);
        kind: root.mark-kind;
        state: root.mark-state;
        colour: root.mark-color;
        rainbow: root.mark-rainbow;
    }
    if root.mark-kind == 1 : Rectangle {
        x: 100px;
        y: 10px;
        width: 16px;
        height: 16px;
        MarkRing {
            x: Px.snap((parent.width - self.width) / 2);
            y: Px.snap((parent.height - self.height) / 2);
            state: root.mark-state;
            ink: root.ink;
        }
    }
    Rectangle {
        x: 300px;
        y: 10px;
        width: 15px;
        height: 15px;
        border-radius: 7.5px;
        background: Theme.tabs;
        if root.mark-kind == 1 : MarkRing {
            x: Px.snap((parent.width - self.width) / 2);
            y: Px.snap((parent.height - self.height) / 2);
            state: root.mark-state;
            ink: root.ink;
        }
    }
    AgentIcon {
        x: 340px;
        y: 9px;
        kind: root.icon-kind;
        ink: root.ink;
        motion: root.icon-motion;
    }
}

// The dictation mark (M8 Task 23): a 13 px microphone in accent-hi at a tab's end while dictation is listening or
// transcribing into that tab (PT DictationTabMark.tsx). It sits in a 16 px end box, centred by its parent, and is
// absent from the tree while idle. The paste target's tab wears it even with another tab in front.
export component DictationTabMark inherits Rectangle {
    // Dictation is listening or transcribing into this tab.
    in property <bool> active: false;
    // True while listening, false while transcribing (the accessible name).
    in property <bool> listening: true;
    width: 16px;
    height: 16px;

    if root.active : Path {
        x: Px.snap((root.width - self.width) / 2);
        y: Px.snap((root.height - self.height) / 2);
        width: 13px;
        height: 13px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M9 2a3 3 0 0 1 6 0v8a3 3 0 0 1-6 0z M5 10a7 7 0 0 0 14 0 M12 17v4 M8 21h8";
        fill: transparent;
        stroke: Theme.accent-hi;
        stroke-width: 2px * 13 / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
        accessible-role: image;
        accessible-label: root.listening ? "Listening" : "Transcribing";
    }
}

// The dictation mark on a target tab, with another tab in front, in a 400 x 36 window (the component tests).
export component DictationTabMarkPreview inherits Window {
    preferred-width: 400px;
    preferred-height: 36px;
    background: Theme.ground;

    in-out property <bool> active;
    in-out property <bool> listening: true;
    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = root.win-scale; }
    init => { Px.scale = root.win-scale; }

    // The paste target's tab (0 to 250) and the tab in front (250 to 400).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 250px;
        height: 36px;
        background: Theme.tabs;
        DictationTabMark {
            x: 228px;
            y: 10px;
            active: root.active;
            listening: root.listening;
        }
    }
    Rectangle {
        x: 250px;
        y: 0px;
        width: 150px;
        height: 36px;
        background: Theme.control;
    }
}
// The dictation mark on the real strip tab and the real sidebar card, for the scaling images (M8 Task 35). A strip
// (400 x 36 css px: the paste target's tab with its icon band, name and end box, a tab in front of it) or, with
// `sidebar`, the column (260 x 148: three 46 px cards, the middle one the target). Same metrics as tabs.slint's tab
// (18 px icon at 10, name at 34, 18 px end box 10 from the edge) and sidebar.slint's card (8 px margins, 46 px icon
// band, 18 px end box 8 from the edge).
export component DictationTabMarkScene inherits Window {
    in property <bool> sidebar: false;
    in property <bool> active: true;
    in property <bool> listening: true;
    preferred-width: root.sidebar ? 260px : 400px;
    preferred-height: root.sidebar ? 148px : 36px;
    background: root.sidebar ? Theme.side : Theme.ground;
    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = root.win-scale; }
    init => { Px.scale = root.win-scale; }

    if !root.sidebar : Rectangle {
        Rectangle {
            x: 0px;
            y: 0px;
            width: 250px;
            height: 36px;
            background: Theme.tabs;
            AgentIcon { x: 10px; y: 9px; kind: 0; ink: Theme.dim; }
            Text {
                x: 34px;
                y: 0px;
                width: 250px - 34px - 10px - 18px - 6px;
                height: 36px;
                text: "Flare";
                font-size: 12px;
                font-family: Theme.font-ui;
                color: Theme.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            DictationTabMark {
                x: 250px - 10px - 18px + 1px;
                y: 10px;
                active: root.active;
                listening: root.listening;
            }
            Rectangle { x: 250px - Px.hair(); y: 0px; width: Px.hair(); height: 36px; background: Theme.divider; }
        }
        Rectangle {
            x: 250px;
            y: 0px;
            width: 150px;
            height: 36px;
            background: Theme.tab-active;
            AgentIcon { x: 10px; y: 9px; kind: 0; ink: Theme.text; }
            Text {
                x: 34px;
                y: 0px;
                width: 150px - 34px - 10px - 18px - 6px;
                height: 36px;
                text: "Atlas";
                font-size: 12px;
                font-family: Theme.font-ui;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 0px; y: 0px; width: 150px; height: Px.snap(2px); background: Theme.accent-hi; }
        }
    }

    if root.sidebar : Rectangle {
        for name[i] in ["Atlas", "Flare", "Sonara"] : Rectangle {
            x: 8px;
            y: i * 46px + 5px;
            width: 260px - 16px;
            height: 46px;
            border-radius: 8px;
            clip: true;
            background: i == 0 ? Theme.accent-hi.with-alpha(0.14) : Theme.text.with-alpha(0.03);
            Rectangle {
                x: 0px;
                y: 0px;
                width: 46px;
                height: 46px;
                background: Theme.text.with-alpha(0.05);
                AgentIcon { x: 14px; y: 14px; kind: 0; ink: Theme.side-text; }
            }
            VerticalLayout {
                x: 56px;
                y: 0px;
                width: 260px - 16px - 56px - 8px - 18px - 10px;
                height: 46px;
                alignment: center;
                padding-top: 4px;
                padding-bottom: 4px;
                Text {
                    text: name;
                    color: Theme.side-text;
                    font-size: 13px;
                    font-weight: i == 0 ? 600 : 400;
                    overflow: elide;
                }
                Text {
                    text: "Github";
                    color: Theme.side-dim;
                    font-size: 11.5px;
                    overflow: elide;
                }
            }
            if i == 1 : DictationTabMark {
                x: 260px - 16px - 8px - 18px + 1px;
                y: 15px;
                active: root.active;
                listening: root.listening;
            }
        }
    }
}
