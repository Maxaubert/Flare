// One of the title bar's buttons (PT TitleBar.tsx: h-7 w-8, rounded, an
// SVG icon on a 24-unit viewbox drawn with a round-capped stroke).
component TitleButton inherits Rectangle {
    in property <string> commands;
    in property <length> icon-size: 13px;
    in property <float> stroke-units: 1.8;
    in property <bool> danger: false;
    // Drawn on the picked Secondary (the bar beside the sidebar): the inks held on that fill.
    in property <bool> on-secondary: false;
    in property <string> label;
    // A tooltip, when the button has one (the Command help button).
    in property <string> tip-text;
    callback clicked();
    callback tip(string, length, length, length, length);
    width: 32px;
    height: 28px;
    border-radius: Theme.radius-button;
    background: ta.has-hover ? (root.danger ? Theme.close-hover : Theme.hover-hi) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    // Slint fits the path into its box LESS the stroke, so the box is the icon grown by one stroke
    // (still centred): the 24 units then cover `icon-size` as the svg does (M9 Task 41).
    Path {
        width: root.icon-size + self.stroke-width;
        height: root.icon-size + self.stroke-width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: ta.has-hover ? (root.danger ? #ffffff : (root.on-secondary ? Theme.secondary-text : Theme.text)) : (root.on-secondary ? Theme.secondary-icon : Theme.icon);
        // Under glass the stroke is at least two device pixels (audit V7), so it never anti-aliases away.
        stroke-width: max(root.stroke-units * root.icon-size / 24, Theme.glyph-stroke-floor * 1phx);
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    // The keyboard focus ring (PT focus-visible:ring-2 ring-accent-hi): 2 px, drawn outside the box.
    // A click never takes the focus, so the ring is for the keyboard only, as :focus-visible is.
    if keys.has-focus : ring := Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: Theme.radius-button + 2px;
        border-width: 2px;
        border-color: Theme.accent-hi;
        background: transparent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if (root.tip-text != "") {
                if (self.has-hover) {
                    root.tip(root.tip-text, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
                } else {
                    root.tip("", 0px, 0px, 0px, 0px);
                }
            }
        }
    }
    // Zero-sized, so it never takes a pointer: the Tab key reaches it, Space and Enter press the button.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    out property <bool> keyboard-focused: keys.has-focus;
}

// The plugins' corner of the title bar (plugins phase 4): the Plugins button that opens the sections as a dropdown
// (horizontal tabs only, while any plugin has a section), then each plugin's top-bar button (three at most), in
// Flare's outlined chips. Its width is what it draws plus the gap that keeps it apart from the window buttons, and
// nothing when it draws nothing.
component PluginBar inherits Rectangle {
    // False draws nothing (the other bar's corner is the one on show).
    in property <bool> shown: true;
    in property <bool> menu-shown;
    in property <bool> menu-open;
    in property <[PluginButton]> buttons;
    in property <color> ink;
    callback menu-clicked();
    callback clicked(int);
    callback tip(string, length, length, length, length);
    property <int> n: root.shown ? root.buttons.length : 0;
    property <length> menu-w: (root.shown && root.menu-shown) ? Px.snap(menu-label.preferred-width + 20px) : 0px;
    property <length> first-x: root.menu-w > 0 && root.n > 0 ? root.menu-w + 4px : root.menu-w;
    property <length> content-w: root.first-x + root.n * 26px + max(0, root.n - 1) * 4px;
    // The gap kept on the right, apart from the update chip and the window buttons (which add their own 8).
    out property <length> gap: 10px;
    width: root.content-w > 0 ? Px.snap(root.content-w + root.gap) : 0px;
    visible: root.content-w > 0;
    menu-chip := Rectangle {
        x: 0px;
        y: Px.snap((root.height - 22px) / 2);
        height: 22px;
        width: root.menu-w;
        visible: root.menu-w > 0;
        border-radius: 11px;
        border-width: Px.hair();
        border-color: root.menu-open ? Theme.accent-hi : root.ink.with-alpha(0.38);
        background: mta.has-hover || root.menu-open ? Theme.hover-hi : transparent;
        accessible-role: button;
        accessible-label: "Plugins";
        accessible-action-default => { root.menu-clicked(); }
        menu-label := Text {
            text: "Plugins";
            font-family: Theme.font-ui;
            font-size: 11.5px;
            color: root.ink;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        mta := TouchArea {
            clicked => { root.menu-clicked(); }
            changed has-hover => {
                if self.has-hover {
                    root.tip("The plugins' sections", menu-chip.absolute-position.x, menu-chip.absolute-position.y, menu-chip.width, menu-chip.height);
                } else {
                    root.tip("", 0px, 0px, 0px, 0px);
                }
            }
        }
    }
    for b[i] in root.buttons : PluginChip {
        x: root.first-x + i * 30px;
        y: Px.snap((root.height - 22px) / 2);
        width: 26px;
        height: 22px;
        visible: root.shown;
        cmd: b.cmd;
        letter: b.letter;
        tip-text: b.tip;
        on: b.checked;
        off: !b.enabled;
        ink: root.ink;
        clicked => { root.clicked(i); }
        tip(t, x, y, w, h) => { root.tip(t, x, y, w, h); }
    }
}

// The window buttons (command help while it is on, settings, minimise, maximise, close),
// `Px.snap`ped wide so the strip beside them starts and ends on whole device pixels. This width
// is the one source of truth for the strip's reserved space: 154 with four buttons, 190 with the
// Command help button before them (32 per button, 4 between, 8 and 6 at the ends).
component TitleButtons inherits Rectangle {
    in property <bool> on-secondary: false;
    in property <bool> help-visible;
    in property <string> help-tip;
    in property <string> settings-tip;
    callback help();
    callback settings();
    callback minimize();
    callback maximize();
    callback close();
    callback tip(string, length, length, length, length);
    width: Px.snap(root.help-visible ? 190px : 154px);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 4px;
        alignment: end;
        if root.help-visible: VerticalLayout {
            alignment: center;
            TitleButton {
                on-secondary: root.on-secondary;
                label: "Command help";
                tip-text: root.help-tip;
                icon-size: 15px;
                stroke-units: 1.8;
                commands: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18z M9.4 9.3a2.7 2.7 0 1 1 4 2.4c-.9.5-1.4 1.1-1.4 2.1 M12 17.2v.01";
                clicked => { root.help(); }
                tip(a, b, c, d, e) => { root.tip(a, b, c, d, e); }
            }
        }
        VerticalLayout {
            alignment: center;
            TitleButton {
                on-secondary: root.on-secondary;
                label: "Settings";
                tip-text: root.settings-tip;
                icon-size: 15px;
                stroke-units: 1.7;
                commands: Glyphs.cog;
                clicked => { root.settings(); }
                tip(a, b, c, d, e) => { root.tip(a, b, c, d, e); }
            }
        }
        VerticalLayout {
            alignment: center;
            TitleButton {
                on-secondary: root.on-secondary;
                label: "Minimize";
                commands: "M6 12h12";
                clicked => { root.minimize(); }
            }
        }
        VerticalLayout {
            alignment: center;
            TitleButton {
                on-secondary: root.on-secondary;
                label: "Maximize";
                commands: "M7.5 6h9a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-9a1.5 1.5 0 0 1-1.5-1.5v-9a1.5 1.5 0 0 1 1.5-1.5z";
                clicked => { root.maximize(); }
            }
        }
        VerticalLayout {
            alignment: center;
            TitleButton {
                on-secondary: root.on-secondary;
                label: "Close";
                danger: true;
                commands: "M7 7l10 10M17 7L7 17";
                clicked => { root.close(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Flare";
    no-frame: true;
    background: Theme.window-clear;
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 400px;
    forward-focus: keys;

    // ---- kept from M1/M2 ----
    in property <image> grid-image;
    in-out property <bool> overlay-visible: false;
    in property <string> overlay-text;
    out property <int> grid-phys-width: round(grid-box.width / 1phx);
    out property <int> grid-phys-height: round(grid-box.height / 1phx);
    out property <float> scale: 1px / 1phx;
    // The hairline the chrome draws, in device pixels (`Px.hair()`: the strip's bottom line, the
    // tab separators and the sidebar's edge all use it). The DPI probe reads it.
    out property <int> hair-phys: round(Px.hair() / 1phx);

    callback grid-resized(int, int, float);

    // The Settings view's focus requests (M7 Task 41): the Find field, the result list, a rail item.
    public function settings-focus-find() { settings-view.focus-find(); }
    public function settings-focus-list() { settings-view.focus-list(); }
    public function settings-focus-rail(i: int) { settings-view.focus-rail(i); }
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback toggle-grid-renderer();

    // ---- layout ----
    in property <bool> layout-vertical;
    in property <bool> has-tabs;
    in property <int> front-kind;
    in property <length> grid-frozen-width;
    // The resume skeleton over the front agent tab while its conversation resumes (M6).
    in property <bool> skeleton-shown: false;
    in property <bool> skeleton-leaving: false;
    // ---- the panel slot (Surfaces stage 1) ----
    // The front tab has an open panel. The slot shows only on a shell tab with room for it.
    in property <bool> panel-open;
    // What it shows: 0 a note, 1 an image, 2 a text file.
    in property <int> panel-kind;
    in property <string> panel-title;
    in property <string> panel-sub;
    in property <string> panel-note;
    in property <image> panel-picture;
    in property <image> panel-checker;
    in property <bool> panel-alpha;
    in-out property <bool> panel-actual;
    in property <[string]> panel-lines;
    in property <int> panel-max-cols;
    in property <string> panel-foot;
    // The conversation panels (stage 6): kinds 4 (Changes) and 5 (Tasks) of panel-kind.
    in property <[ConvoFileRow]> panel-convo-files;
    in property <[ConvoDiffRow]> panel-convo-rows;
    in property <int> panel-convo-max-cols;
    in property <string> panel-convo-selected;
    in property <[ConvoTaskRow]> panel-convo-tasks;
    out property <int> panel-convo-list-built: panel-slot.convo-list-built;
    out property <int> panel-convo-list-first: panel-slot.convo-list-first;
    out property <int> panel-convo-diff-built: panel-slot.convo-diff-built;
    out property <int> panel-convo-diff-first: panel-slot.convo-diff-first;
    out property <length> panel-convo-diff-row-h: panel-slot.convo-diff-row-h;
    out property <length> panel-convo-list-row-h: panel-slot.convo-list-row-h;
    out property <int> panel-convo-task-rows: panel-slot.convo-task-rows;
    out property <length> panel-convo-task-content-h: panel-slot.convo-task-content-h;
    callback panel-convo-select(string);
    callback panel-convo-open(string);
    callback panel-convo-toggle(string);
    // The Preview chip (stage 7): "localhost:5173" while the front tab has a local dev server to offer, else empty.
    in property <string> preview-chip-label;
    // The full origin the chip opens, as its tooltip.
    in property <string> preview-chip-tip;
    out property <length> preview-chip-x: preview-chip.absolute-position.x;
    out property <length> preview-chip-y: preview-chip.absolute-position.y;
    out property <length> preview-chip-w: preview-chip.width;
    out property <length> preview-chip-h: preview-chip.height;
    callback preview-chip-clicked();
    // The tab share of the page (0: not set, the default applies). The limits are the layout
    // maths of flare-surfaces, handed over once (`layout::MIN_SLOT` and the others).
    in property <float> panel-share: 0;
    in property <length> panel-min-slot: 240px;
    in property <length> panel-min-grid: 320px;
    in property <length> panel-usable-min: 120px;
    in property <float> panel-max-share: 0.7;
    in property <float> panel-default-share: 0.4;
    property <length> panel-slot-max: max(0px, min(page.width * root.panel-max-share, page.width - root.panel-min-grid));
    property <length> panel-slot-min: min(root.panel-min-slot, root.panel-slot-max);
    // The page has room for a slot at all.
    out property <bool> panel-fits: root.panel-slot-max >= root.panel-usable-min;
    // The slot is on the screen: open, on a shell tab, with room.
    out property <bool> panel-shown: root.panel-open && root.front-kind == 0 && root.panel-fits;
    // The slot settled width (the grid takes the rest) and what is drawn while the splitter moves.
    out property <length> panel-slot-w: !root.panel-shown ? 0px : Px.snap(min(max(page.width * ((root.panel-share > 0 && root.panel-share < 1) ? root.panel-share : root.panel-default-share), root.panel-slot-min), root.panel-slot-max));
    in-out property <bool> panel-splitting: false;
    in-out property <length> panel-drag-w: 0px;
    out property <length> panel-visible-w: root.panel-splitting ? root.panel-drag-w : root.panel-slot-w;
    out property <length> panel-slot-x: page.width - root.panel-visible-w;
    out property <length> panel-slot-top: panel-slot.absolute-position.y;
    out property <length> panel-slot-h: panel-slot.height;
    out property <length> panel-splitter-x: splitter.absolute-position.x;
    out property <length> panel-splitter-w: splitter.width;
    out property <length> panel-header-h: panel-slot.header-h;
    out property <length> panel-body-x: panel-slot.body-x;
    out property <length> panel-body-y: panel-slot.body-y;
    out property <length> panel-body-w: panel-slot.body-w;
    out property <length> panel-body-h: panel-slot.body-h;
    out property <length> panel-image-x: panel-slot.image-x;
    out property <length> panel-image-y: panel-slot.image-y;
    out property <length> panel-image-w: panel-slot.image-w;
    out property <length> panel-image-h: panel-slot.image-h;
    out property <bool> panel-image-zoomed: panel-slot.image-zoomed;
    out property <bool> panel-image-can-zoom: panel-slot.image-can-zoom;
    out property <length> panel-gutter-w: panel-slot.text-gutter-w;
    out property <int> panel-first-line: panel-slot.text-first-line;
    // Wrapping a text preview (2026-10-22): the columns that fit (the controller wraps to them at every width change, live while a drag moves it),
    // the rows' line numbers (0 on a continuation row), whether the rows are wrapped now, the setting, and the file's
    // line count for the gutter's width.
    out property <int> panel-wrap-cols: panel-slot.text-wrap-cols;
    in property <[int]> panel-line-nums;
    in property <bool> panel-wrapped;
    in property <int> panel-wrapped-cols;
    out property <length> panel-text-content-w: panel-slot.text-content-w;
    out property <length> panel-text-scroll-x: panel-slot.text-scroll-x;
    out property <length> panel-text-scroll-y: panel-slot.text-scroll-y;
    public function panel-scroll-to-row(row: int) { panel-slot.text-scroll-to-row(row); }
    public function panel-scroll-by(dx: length, dy: length) { panel-slot.text-scroll-by(dx, dy); }
    in property <bool> panel-wrap-on: true;
    in property <int> panel-number-count;
    out property <length> panel-wrap-button-x: panel-slot.wrap-button-x;
    out property <length> panel-wrap-button-y: panel-slot.wrap-button-y;
    out property <length> panel-wrap-button-w: panel-slot.wrap-button-w;
    callback panel-wrap-toggled();
    callback panel-wrap-cols-changed();
    changed panel-wrap-cols => { root.panel-wrap-cols-changed(); }
    // The slot went away while the splitter was held (a tab switched by key, the window too small, a page in front): the
    // hidden touch area never hears the release, so the grab is let go here or the next time the slot shows it would
    // still be drawn at the stale dragged width.
    changed panel-shown => {
        if (!root.panel-shown) { root.panel-splitting = false; }
    }
    // The panel has the keys; the window leaves the non-chord keys to it.
    out property <bool> panel-has-focus: panel-slot.has-focus;
    public function focus-panel() { panel-slot.focus-panel(); }
    // A different tab's (or session's) conversation panel opens at the top, not where the last one was scrolled.
    public function panel-convo-reset-scroll() { panel-slot.convo-reset-scroll(); }
    // The splitter drag ends: the share dragged so far is kept (the pointer's left button went up, or the grab was cancelled).
    public function end-splitter() {
        if (root.panel-splitting) {
            root.panel-splitting = false;
            root.panel-splitter-released(root.panel-drag-w / max(page.width, 1px));
        }
    }
    callback panel-close();
    callback panel-escape();
    callback panel-pressed();
    // The web panel (stage 3): what the bar shows, the still, and where the page sits.
    in property <string> panel-web-url;
    // A mini-app (stage 5): the page is the agent's own, so the bar (address, back, reload) is not drawn.
    in property <bool> panel-web-app;
    in property <bool> panel-web-loading;
    in property <bool> panel-web-can-back;
    in property <bool> panel-web-can-forward;
    in property <image> panel-web-still;
    in property <bool> panel-web-has-still;
    in property <bool> panel-web-missing-runtime;
    in property <string> panel-web-ribbon;
    out property <bool> panel-web-ribbon-shown: panel-slot.ribbon-shown;
    out property <length> panel-web-ribbon-w: panel-slot.ribbon-w;
    out property <length> panel-web-x: panel-slot.web-x;
    out property <length> panel-web-y: panel-slot.web-y;
    out property <length> panel-web-w: panel-slot.web-w;
    out property <length> panel-web-h: panel-slot.web-h;
    out property <length> panel-bar-h: panel-slot.bar-h;
    out property <bool> panel-web-input-focused: panel-slot.web-input-focused;
    out property <string> panel-web-draft: panel-slot.web-draft;
    out property <length> panel-web-field-x: panel-slot.web-field-x;
    out property <length> panel-web-field-w: panel-slot.web-field-w;
    public function focus-address() { panel-slot.focus-address(); }
    callback panel-web-back();
    callback panel-web-forward();
    callback panel-web-reload();
    callback panel-web-stop();
    callback panel-web-submit(string);
    callback panel-web-download();
    // The page moved or resized in the window (a layout change, a splitter drag, a new scale): the
    // browser window follows. And an overlay opened or closed: the browser window hides or shows.
    callback panel-web-moved();
    callback overlay-changed();
    changed panel-web-x => { root.panel-web-moved(); }
    changed panel-web-y => { root.panel-web-moved(); }
    changed panel-web-w => { root.panel-web-moved(); }
    changed panel-web-h => { root.panel-web-moved(); }
    // The splitter was let go: the slot share of the page.
    callback panel-splitter-released(float);
    // The page (right of the sidebar) in the window, for the probes and the layout tests.
    out property <length> page-w: page.width;
    out property <length> page-left: page.absolute-position.x;
    // The grid width: the page less the slot (held while the sidebar slides).
    property <length> grid-w: root.grid-frozen-width > 0px ? root.grid-frozen-width : page.width - root.panel-slot-w;
    // True while any Flare overlay is open. A web panel (stage 3) is a child window and paints
    // above Slint, so it hides while this is true. `flare_surfaces::overlay::Overlay::ALL` names the
    // terms; a test opens each one and a scan counts the terms.
    out property <bool> overlay-open: root.menu-open || root.overflow-open || root.plugins-open || root.dialog-open || root.update-open || root.update-notice != "" || root.front-kind == 1 || SettingsBridge.select-open || SettingsBridge.editor-open || SettingsBridge.ask-open || SettingsBridge.dict-ask-open || SettingsBridge.picker-open || HelpBridge.open || root.find-open || root.overlay-visible || root.carrying;
    changed overlay-open => { root.overlay-changed(); }

    // ---- tabs ----
    in property <[TabRow]> tab-rows;
    in property <StripGeom> strip-geom;
    in property <bool> carrying;
    in property <bool> drag-in-flight;
    // Whether the strip is window-drag (off while a file drag is in flight); read by the e2e probe.
    out property <bool> strip-has-move-area: strip.has-move-area;
    in property <string> new-tab-title;
    in property <string> find-tab-key;
    in property <string> new-key;
    in property <string> settings-key;
    // Command help (M7 Task 43): the title button, its key label and which of the panel and the
    // find bar was opened last (that one is on top in the corner).
    in property <bool> help-visible;
    in property <string> help-key;
    in property <bool> help-on-top;
    callback help-clicked();
    out property <int> strip-phys-width: strip.strip-phys-width;
    // ---- plugins (phase 4) ----
    // The sections' rows (the sidebar's, and the dropdown's in the horizontal layout), the top bar's buttons, and
    // whether the dropdown is open.
    in property <[PluginRow]> plugin-rows;
    in property <[PluginButton]> plugin-top-buttons;
    in property <bool> plugins-open;
    // Where the plugins' corner of whichever bar shows now ends on the right, and where the window buttons start.
    out property <length> plugin-bar-x: root.side-mode ? side-plugins.absolute-position.x : top-plugins.absolute-position.x;
    out property <length> plugin-bar-w: root.side-mode ? side-plugins.width : top-plugins.width;
    out property <length> title-buttons-x: root.side-mode ? side-buttons.absolute-position.x : top-buttons.absolute-position.x;
    out property <length> plugins-card-x: pdrop.card-x;
    out property <length> plugins-card-y: pdrop.card-y;
    out property <length> plugins-card-w: pdrop.card-w;
    out property <length> plugins-card-h: pdrop.card-h;
    out property <length> sidebar-sections-y: sb.sections-y;
    out property <length> sidebar-sections-h: sb.sections-h;
    callback plugins-clicked();
    callback plugins-dismissed();
    callback plugin-top-clicked(int);
    callback tab-hover-action(string, int);
    callback plugin-fold(string);
    callback plugin-header-menu(string, length, length);
    callback plugin-item(string, string, bool);
    // ---- sidebar ----
    in property <bool> sidebar-collapsed;
    in property <bool> sidebar-revealed;
    in property <length> sidebar-width: 220px;
    in property <bool> sidebar-sliding;
    // The slide, eased by the glue frame by frame (side_slide.rs); unset, the rest values.
    in property <length> sidebar-slot-now: root.sidebar-collapsed ? 0px : root.sidebar-width;
    in property <length> sidebar-slide-now: (root.sidebar-collapsed && !root.sidebar-revealed) ? -(root.sidebar-width + 10px) : 0px;
    // Where the slide is NOW (the eased slot width and panel x), for the e2e's per-frame series.
    out property <length> sidebar-slot-visual: sb.slot-visual;
    out property <length> sidebar-panel-left: sb.panel-left;
    in-out property <string> sidebar-find <=> sb.find-text;
    // ---- start screen ----
    in property <[Place]> places;
    in property <string> version-text;
    // ---- popups ----
    in property <bool> menu-open;
    in property <[MenuRow]> menu-rows;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <bool> overflow-open;
    in property <[OverflowRow]> overflow-rows;
    in property <length> overflow-right;
    in property <length> overflow-bottom;
    in-out property <string> overflow-query <=> ov.query;
    // The update chip, its notice and the update window (M9 Task 30). UpdateCtl pushes all of it.
    in property <bool> update-chip-shown;
    in property <string> update-chip-label;
    in property <string> update-chip-aria;
    in property <string> update-chip-tip;
    in property <bool> update-chip-busy;
    in property <string> update-notice;
    in property <bool> update-open;
    in property <string> update-title;
    in property <string> update-sub;
    in property <[NoteSection]> update-sections;
    in property <string> update-empty-note;
    in property <string> update-more;
    in property <string> update-status;
    in property <int> update-pct;
    in property <string> update-pct-text;
    in property <bool> update-running;
    in property <bool> update-active;
    in property <string> update-cancel-label: "Cancel";
    in property <bool> update-cancel-enabled: true;
    in property <string> update-cancel-tip;
    in property <bool> update-install-enabled: true;
    in property <length> update-notes-max-h: 184.8px;
    callback update-chip-clicked();
    callback update-install();
    callback update-cancel();
    callback update-abort();
    callback update-notice-dismissed();
    // Where the chip is now (the notice hangs under it), whichever bar holds it.
    out property <length> update-chip-x: root.side-mode ? side-chip.absolute-position.x : top-chip.absolute-position.x;
    out property <length> update-chip-y: root.side-mode ? side-chip.absolute-position.y : top-chip.absolute-position.y;
    out property <length> update-chip-w: root.side-mode ? side-chip.width : top-chip.width;
    out property <length> update-chip-h: top-chip.height;
    out property <length> update-notice-w: unote.width;
    out property <length> update-notice-h: unote.height;
    out property <bool> update-window-focus: uwin.chrome-has-focus;
    // The update window's boxes, for the e2e probe `update.window` (Task 39). All in window
    // coordinates, because the window covers the whole client area.
    out property <length> update-chip-icon-h: top-chip.icon-h;
    out property <int> update-focus-idx: uwin.focus-idx;
    out property <length> update-box-x: uwin.box-x;
    out property <length> update-box-y: uwin.box-y;
    out property <length> update-box-w: uwin.box-w;
    out property <length> update-box-h: uwin.box-h;
    out property <length> update-track-x: uwin.track-x;
    out property <length> update-track-y: uwin.track-y;
    out property <length> update-track-w: uwin.track-w;
    out property <length> update-track-h: uwin.track-h;
    out property <length> update-fill-w: uwin.fill-w;
    out property <length> update-notes-y: uwin.notes-y;
    out property <length> update-notes-h: uwin.notes-h;
    out property <length> update-notes-content-h: uwin.notes-content-h;
    out property <length> update-install-x: uwin.install-x;
    out property <length> update-install-y: uwin.install-y;
    out property <length> update-install-w: uwin.install-w;
    out property <length> update-install-h: uwin.install-h;
    out property <length> update-cancel-x: uwin.cancel-x;
    out property <length> update-cancel-y: uwin.cancel-y;
    out property <length> update-cancel-w: uwin.cancel-w;
    out property <length> update-cancel-h: uwin.cancel-h;
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <styled-text> dialog-body;
    in property <string> dialog-primary;
    in property <bool> dialog-danger;
    in property <bool> dialog-by-key;
    in property <bool> tip-visible;
    in property <string> tip-text;
    in property <length> tip-x;
    in property <length> tip-y;
    // Added beyond the contract: the side the tip was placed on (0 below, 1 above, 2 right, 3 left).
    in property <int> tip-side;
    out property <length> tip-w: tipbox.tip-w;
    out property <length> tip-h: tipbox.tip-h;
    // ---- focus ----
    // The overflow list focuses its field when it opens, so "open" stands for "its field has the keys".
    out property <bool> chrome-has-focus: sb.find-has-focus || root.overflow-open || root.dialog-open || root.update-open;
    public function focus-terminal() { keys.focus(); }
    public function focus-find() { find.focus-input(); }
    public function focus-sidebar-find() { sb.focus-find(); }
    public function focus-overflow-field() { ov.focus-field(); }
    public function menu-shown() { menu.shown(); }

    // ---- the grid pointer area, the find bar and the badge (Milestone 5) ----
    in property <MouseCursor> grid-cursor: MouseCursor.text;
    // kind: 0 down, 1 up, 2 move, 3 cancel; button: 0 left, 1 middle, 2 right, 3 other.
    // x and y are relative to the grid area, in logical pixels.
    callback grid-pointer(kind: int, button: int, x: length, y: length, ctrl: bool, shift: bool, alt: bool);
    in property <bool> find-open;
    in-out property <string> find-query;
    in property <string> find-readout;
    in property <bool> find-can-step;
    // A Slint text field has the keys: the find box or the Command help panel.
    out property <bool> find-input-focused: find.input-has-focus || help-panel.focused || panel-slot.web-input-focused;
    out property <length> help-sheet-w: help-panel.sheet-w;
    in-out property <length> help-viewport-y <=> help-panel.viewport-y;
    out property <length> title-buttons-w: top-buttons.width;
    // The find bar, the badge and the start screen in the window, for ui.rect.
    out property <length> find-bar-x: find.bar-x;
    out property <length> find-bar-y: find.bar-y;
    out property <length> find-bar-w: find.bar-w;
    out property <length> find-bar-h: find.bar-h;
    out property <length> badge-x: badge.x + badge.pill-x;
    out property <length> badge-y: badge.pill-y;
    out property <length> badge-w: badge.pill-w;
    out property <length> badge-h: badge.pill-h;
    out property <length> start-x: start-screen.absolute-position.x;
    out property <length> start-y: start-screen.absolute-position.y;
    out property <length> start-w: start-screen.width;
    out property <length> start-h: start-screen.height;
    out property <length> menu-panel-x: menu.panel-x;
    out property <length> menu-panel-y: menu.panel-y;
    out property <length> menu-w: menu.panel-w;
    out property <length> menu-h: menu.panel-h;
    out property <length> dialog-box-x: dlg.box-x;
    out property <length> dialog-box-y: dlg.box-y;
    out property <length> dialog-box-w: dlg.box-w;
    out property <length> dialog-box-h: dlg.box-h;
    out property <int> dialog-focus: dlg.focused-button;
    callback find-edited(string);
    callback find-next();
    callback find-prev();
    callback find-close();
    in property <int> copied-phase;
    // The terminal's scrollbar (M10 D11): the thumb as fractions of the track, set by scrollbar.rs.
    in property <bool> scroll-on: false;
    in property <float> scroll-top: 0;
    in property <float> scroll-len: 1;
    in property <bool> scroll-back: false;
    // The dictation pill (M8): fed from dictation_ctl::view() by dictation_ctl's host; 0 mounts nothing.
    in property <int> dict-phase: 0;
    in property <bool> dict-starting: false;
    in property <string> dict-live-text;
    in property <string> dict-message;
    in property <float> dict-level: 0;
    out property <length> scroll-strip-x: scroll-bar.strip-x;
    out property <length> scroll-strip-w: scroll-bar.strip-w;
    out property <length> scroll-thumb-x: scroll-bar.thumb-x;
    out property <length> scroll-thumb-y: scroll-bar.thumb-y;
    out property <length> scroll-thumb-w: scroll-bar.thumb-w;
    out property <length> scroll-thumb-h: scroll-bar.thumb-h;
    // The grid area's origin in the window.
    out property <length> grid-left: grid-box.absolute-position.x;
    // The switch question's three buttons in window pixels, x y w h each: Cancel, Discard, Save as Custom.
    out property <[length]> ask-rects: [
        ask.cancel-x, ask.cancel-y, ask.cancel-w, ask.cancel-h,
        ask.discard-x, ask.discard-y, ask.discard-w, ask.discard-h,
        ask.save-x, ask.save-y, ask.save-w, ask.save-h,
    ];
    out property <length> grid-top: grid-box.absolute-position.y;

    // ---- callbacks (UI -> Rust) ----
    callback strip-press(string, int, length, length);
    callback strip-moved(length);
    callback strip-released();
    callback side-press(string, int, length, length, length, length);
    callback side-moved(length);
    callback side-released();
    callback tab-closed(string);
    callback tab-menu(string, length, length);
    callback new-tab();
    callback plus-menu(length, length);
    callback more-clicked(length, length);
    callback settings-clicked();
    callback strip-resized(int);
    callback side-find-edited(string);
    callback side-find-accepted();
    callback side-find-escape();
    callback grip-moved(length);
    callback grip-released(length);
    callback place-picked(string);
    callback start-new();
    callback start-settings();
    callback start-github();
    callback menu-picked(int);
    callback menu-trailing(int);
    callback menu-dismissed();
    callback menu-outside-right(length, length);
    callback overflow-picked(string);
    callback overflow-row-menu(string, length, length);
    callback overflow-dismissed();
    callback overflow-outside-right(length, length);
    callback overflow-accepted();
    callback overflow-query-edited(string);
    callback dialog-cancel();
    callback dialog-confirm();
    callback tip-request(string, length, length, length, length);
    callback bar-double-clicked();
    callback title-pressed();

    init => { Px.scale = root.scale; }
    changed scale => {
        Px.scale = root.scale;
        SettingsBridge.scale-changed();
        root.grid-resized(root.grid-phys-width, root.grid-phys-height, root.scale);
        root.panel-web-moved();
    }
    changed grid-phys-width => { root.grid-resized(root.grid-phys-width, root.grid-phys-height, root.scale); }
    changed grid-phys-height => { root.grid-resized(root.grid-phys-width, root.grid-phys-height, root.scale); }
    changed strip-phys-width => { root.strip-resized(root.strip-phys-width); }

    property <bool> side-mode: root.layout-vertical && root.has-tabs;

    keys := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (event.text == Key.F12) {
                root.overlay-visible = !root.overlay-visible;
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 0;
            spacing: 0;

            // (1) THE TOP ROW (PT App.tsx data-title-bar="tabs"): mark, tab strip, buttons.
            Rectangle {
                height: root.side-mode ? 0px : Theme.bar-height;
                visible: !root.side-mode;
                background: Theme.tabs;
                HorizontalLayout {
                    padding: 0px;
                    spacing: 0px;
                    // TitleMark: pl-3.5 pr-3 around a 17px mark (43px), its full-height line INSIDE
                    // the box (PT's `after:right-0 after:w-px`): the line starts where css px 42 ends.
                    Rectangle {
                        width: Px.snap(42px) + Px.hair();
                        WindowMoveArea { }
                        AppMark {
                            x: Px.snap(14px);
                            y: (parent.height - self.height) / 2;
                            size: 17px;
                        }
                        Rectangle {
                            x: parent.width - Px.hair();
                            width: Px.hair();
                            background: Theme.divider;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        strip := TabStrip {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height - Px.hair();
                            visible: root.has-tabs && !root.side-mode;
                            rows: root.tab-rows;
                            geom: root.strip-geom;
                            new-tab-title: root.new-tab-title;
                            list-open: root.overflow-open;
                            drag-in-flight: root.drag-in-flight;
                            carrying: root.carrying;
                            press(a, b, c, d) => { root.title-pressed(); root.strip-press(a, b, c, d); }
                            drag-moved(a) => { root.strip-moved(a); }
                            drag-released() => { root.strip-released(); }
                            closed(a) => { root.tab-closed(a); }
                            tab-menu(a, b, c) => { root.tab-menu(a, b, c); }
                            new-tab() => { root.new-tab(); }
                            plus-menu(a, b) => { root.plus-menu(a, b); }
                            more-clicked(a, b) => { root.more-clicked(a, b); }
                            tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                            hover-action(a, b) => { root.tab-hover-action(a, b); }
                        }
                        // The empty part of the row after the + button: the window moves by it and a
                        // double click maximises (the strip's own move area swallows the event).
                        WindowMoveArea {
                            x: root.has-tabs ? (root.strip-geom.plus-x + root.strip-geom.plus-w) * 1phx : 0px;
                            y: 0px;
                            width: parent.width - self.x;
                            height: parent.height;
                            TouchArea {
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.down { root.title-pressed(); }
                                }
                                double-clicked => { root.bar-double-clicked(); }
                            }
                        }
                    }
                    // The plugins' corner (plugins phase 4), its own gap kept from the chip and the buttons.
                    top-plugins := PluginBar {
                        shown: !root.side-mode;
                        menu-shown: root.plugin-rows.length > 0;
                        menu-open: root.plugins-open;
                        buttons: root.plugin-top-buttons;
                        ink: Theme.text;
                        menu-clicked => { root.plugins-clicked(); }
                        clicked(i) => { root.plugin-top-clicked(i); }
                        tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                    }
                    // The update chip (M9 Task 30): 10 px left of the first BUTTON (PT `toNextControl`),
                    // in a slot that takes its width from the strip while an offer exists. The buttons'
                    // block opens with its own 8 px padding, so the slot adds only the other 2 (M9 Task
                    // 41: with the full 10 the chip sat 8 px further left than Prism Terminal's).
                    Rectangle {
                        width: (root.update-chip-shown && !root.side-mode) ? top-chip.chip-width + Px.snap(10px - 8px) : 0px;
                        top-chip := UpdateChip {
                            x: 0px;
                            y: Px.snap((Theme.bar-height - self.height) / 2);
                            width: self.chip-width;
                            height: 24px;
                            shown: root.update-chip-shown && !root.side-mode;
                            label: root.update-chip-label;
                            aria: root.update-chip-aria;
                            tip: root.update-chip-tip;
                            busy: root.update-chip-busy;
                            clicked => { root.update-chip-clicked(); }
                            tip-request(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                        }
                    }
                    top-buttons := TitleButtons {
                        help-visible: root.help-visible;
                        help-tip: "Command help (" + root.help-key + ")";
                        settings-tip: "Settings (" + root.settings-key + ")";
                        help => { root.help-clicked(); }
                        tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                        settings => { root.settings-clicked(); }
                        minimize => { root.minimize-clicked(); }
                        maximize => { root.maximize-clicked(); }
                        close => { root.close-clicked(); }
                    }
                }
                // border-b border-[var(--p-divider)]
                Rectangle {
                    y: parent.height - Px.hair();
                    height: Px.hair();
                    background: Theme.divider;
                }
            }

            // (2) THE BAR BESIDE THE SIDEBAR (tabs in the sidebar): mark, a handle, buttons.
            Rectangle {
                height: root.side-mode ? Theme.bar-height : 0px;
                visible: root.side-mode;
                background: Theme.secondary;
                // The TouchArea sits INSIDE the move area, as on the top row: as a sibling above it,
                // it took the press and the window never moved (owner bug 2026-10-21).
                WindowMoveArea {
                    TouchArea {
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down { root.title-pressed(); }
                        }
                        double-clicked => { root.bar-double-clicked(); }
                    }
                }
                AppMark {
                    x: Px.snap(16px);
                    y: (parent.height - self.height) / 2;
                    size: 17px;
                }
                side-plugins := PluginBar {
                    x: (root.update-chip-shown ? side-chip.x - Px.snap(10px) : side-buttons.x) - self.width;
                    y: 0px;
                    height: parent.height;
                    shown: root.side-mode;
                    menu-shown: false;
                    buttons: root.plugin-top-buttons;
                    ink: Theme.secondary-text;
                    clicked(i) => { root.plugin-top-clicked(i); }
                    tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                }
                side-chip := UpdateChip {
                    x: side-buttons.x - Px.snap(10px - 8px) - self.width;
                    y: Px.snap((Theme.bar-height - self.height) / 2);
                    width: self.chip-width;
                    height: 24px;
                    shown: root.update-chip-shown && root.side-mode;
                    label: root.update-chip-label;
                    aria: root.update-chip-aria;
                    tip: root.update-chip-tip;
                    busy: root.update-chip-busy;
                    clicked => { root.update-chip-clicked(); }
                    tip-request(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                }
                side-buttons := TitleButtons {
                    on-secondary: true;
                    x: parent.width - self.width;
                    help-visible: root.help-visible;
                    help-tip: "Command help (" + root.help-key + ")";
                        settings-tip: "Settings (" + root.settings-key + ")";
                    help => { root.help-clicked(); }
                    tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                    settings => { root.settings-clicked(); }
                    minimize => { root.minimize-clicked(); }
                    maximize => { root.maximize-clicked(); }
                    close => { root.close-clicked(); }
                }
            }

            // (3) THE BODY: the page column, then the sidebar slot over it.
            Rectangle {
                vertical-stretch: 1;
                clip: false;

                page := Rectangle {
                    x: root.side-mode ? sb.slot-visual : 0px;
                    y: 0px;
                    width: parent.width - self.x;
                    height: parent.height;
                    clip: true;
                    background: Theme.ground;

                    grid-box := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: root.grid-w;
                        height: parent.height;
                        clip: true;
                        visible: root.front-kind == 0;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.grid-image;
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        if root.skeleton-shown: ResumeSkeleton {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            leaving: root.skeleton-leaving;
                            ground: Theme.ground;
                            ink: Theme.text;
                        }
                        grid-touch := TouchArea {
                            mouse-cursor: root.grid-cursor;
                            pointer-event(e) => {
                                root.grid-pointer(
                                    e.kind == PointerEventKind.down ? 0 : (e.kind == PointerEventKind.up ? 1 : (e.kind == PointerEventKind.move ? 2 : 3)),
                                    e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.middle ? 1 : (e.button == PointerEventButton.right ? 2 : 3)),
                                    self.mouse-x, self.mouse-y,
                                    e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                            }
                        }
                        scroll-bar := TermScrollbar {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            on: root.scroll-on;
                            top: root.scroll-top;
                            len: root.scroll-len;
                            back: root.scroll-back;
                        }
                        dict-pill := DictationPill {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            phase: root.dict-phase;
                            starting: root.dict-starting;
                            live-text: root.dict-live-text;
                            message: root.dict-message;
                            level: root.dict-level;
                        }
                        // The "Preview" chip of a local dev server the tab started (stage 7).
                        preview-chip := PreviewChip {
                            x: parent.width - self.width - Px.snap(20px);
                            y: Px.snap(8px);
                            visible: root.preview-chip-label != "";
                            label: root.preview-chip-label;
                            tip-text: root.preview-chip-tip;
                            tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                            clicked => { root.preview-chip-clicked(); }
                        }
                    }
                    // The panel slot and its splitter (Surfaces stage 1), right of the grid. Declared before
                    // the help panel and the find bar, so those stay over it.
                    panel-slot := PanelSlot {
                        x: root.panel-slot-x;
                        y: 0px;
                        width: root.panel-visible-w;
                        height: parent.height;
                        open: root.panel-shown;
                        kind: root.panel-kind;
                        title: root.panel-title;
                        sub: root.panel-sub;
                        note: root.panel-note;
                        picture: root.panel-picture;
                        checker: root.panel-checker;
                        has-alpha: root.panel-alpha;
                        actual <=> root.panel-actual;
                        lines: root.panel-lines;
                        max-cols: root.panel-max-cols;
                        foot: root.panel-foot;
                        line-nums: root.panel-line-nums;
                        wrapped: root.panel-wrapped;
                        wrapped-cols: root.panel-wrapped-cols;
                        wrap-on: root.panel-wrap-on;
                        number-count: root.panel-number-count;
                        wrap-toggled => { root.panel-wrap-toggled(); }
                        convo-files: root.panel-convo-files;
                        convo-rows: root.panel-convo-rows;
                        convo-max-cols: root.panel-convo-max-cols;
                        convo-selected: root.panel-convo-selected;
                        convo-tasks: root.panel-convo-tasks;
                        convo-select(p) => { root.panel-convo-select(p); }
                        convo-open(p) => { root.panel-convo-open(p); }
                        convo-toggle(k) => { root.panel-convo-toggle(k); }
                        web-url: root.panel-web-url;
                        web-app: root.panel-web-app;
                        web-loading: root.panel-web-loading;
                        web-can-back: root.panel-web-can-back;
                        web-can-forward: root.panel-web-can-forward;
                        web-still: root.panel-web-still;
                        web-has-still: root.panel-web-has-still;
                        web-missing-runtime: root.panel-web-missing-runtime;
                        web-ribbon: root.panel-web-ribbon;
                        web-back => { root.panel-web-back(); }
                        web-forward => { root.panel-web-forward(); }
                        web-reload => { root.panel-web-reload(); }
                        web-stop => { root.panel-web-stop(); }
                        web-submit(text) => { root.panel-web-submit(text); }
                        web-download => { root.panel-web-download(); }
                        close => { root.panel-close(); }
                        escape => { root.panel-escape(); }
                        pressed => { root.focus-panel(); root.panel-pressed(); }
                    }
                    // The splitter: 8 px of hit area centred on the slot left edge. While it moves, the slot
                    // follows the pointer and the grid keeps its width; one fit follows the release (rule 24).
                    splitter := Rectangle {
                        property <length> start-slot;
                        property <length> start-pointer;
                        x: Px.snap(root.panel-slot-x - self.width / 2);
                        y: 0px;
                        width: Px.snap(8px);
                        height: parent.height;
                        visible: root.panel-shown;
                        background: transparent;
                        splitter-ta := TouchArea {
                            mouse-cursor: MouseCursor.col-resize;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                    splitter.start-slot = root.panel-slot-w;
                                    splitter.start-pointer = splitter.absolute-position.x + self.mouse-x;
                                    root.panel-drag-w = root.panel-slot-w;
                                    root.panel-splitting = true;
                                } else if (root.panel-splitting && ((e.kind == PointerEventKind.up && e.button == PointerEventButton.left) || e.kind == PointerEventKind.cancel)) {
                                    root.end-splitter();
                                }
                            }
                            moved => {
                                if (root.panel-splitting) {
                                    root.panel-drag-w = Px.snap(min(max(splitter.start-slot + (splitter.start-pointer - (splitter.absolute-position.x + self.mouse-x)), root.panel-slot-min), root.panel-slot-max));
                                }
                            }
                        }
                    }
                    settings-view := SettingsView {
                        visible: root.front-kind == 1;
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                    }
                    start-screen := StartScreen {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        visible: root.front-kind == 2;
                        shown: root.front-kind == 2;
                        places: root.places;
                        version-text: root.version-text;
                        new-key: root.new-key;
                        settings-key: root.settings-key;
                        new-terminal => { root.start-new(); }
                        place-picked(p) => { root.place-picked(p); }
                        settings => { root.start-settings(); }
                        github => { root.start-github(); }
                        tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                    }

                    // Command help (M7 Task 43) and the find bar share the top right of the page by
                    // stacking only: the one opened last is on top. The bar sits over the grid's area
                    // alone, so it is drawn here, after the panel, and the panel's z lifts above it
                    // when the panel was opened later.
                    help-panel := HelpPanel {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        z: root.help-on-top ? 3 : 1;
                    }
                    find := FindBar {
                        x: 0px;
                        y: 0px;
                        width: root.grid-w;
                        height: parent.height;
                        z: 2;
                        visible: root.front-kind == 0;
                        open: root.find-open;
                        query <=> root.find-query;
                        readout: root.find-readout;
                        can-step: root.find-can-step;
                        query-edited(q) => { root.find-edited(q); }
                        next => { root.find-next(); }
                        previous => { root.find-prev(); }
                        close => { root.find-close(); }
                    }

                    if root.overlay-visible: Rectangle {
                        x: parent.width - self.width - 8px;
                        y: 8px;
                        width: 300px;
                        height: overlay-col.preferred-height + 16px;
                        background: #000000cc;
                        border-radius: 4px;
                        overlay-col := VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: root.overlay-text;
                                color: Theme.text;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 24px;
                                border-radius: 4px;
                                background: switch-ta.has-hover ? Theme.hover-hi : #ffffff12;
                                Text {
                                    text: "Switch grid renderer";
                                    color: Theme.text;
                                    font-size: 12px;
                                }
                                switch-ta := TouchArea {
                                    clicked => { root.toggle-grid-renderer(); }
                                }
                            }
                        }
                    }

                    // TermEdge: the page's top line, and with the sidebar open its left line and rounded corner.
                    if root.side-mode: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: Px.hair();
                        background: Theme.divider;
                    }
                    if root.side-mode && !root.sidebar-collapsed: Rectangle {
                        x: 0px;
                        y: 10px;
                        width: Px.hair();
                        height: parent.height - 10px;
                        background: Theme.divider;
                    }
                    // The terminal's cut corner: the outside of the arc in the sidebar's colour.
                    if root.side-mode && !root.sidebar-collapsed: Path {
                        x: 0px;
                        y: 0px;
                        width: 10px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M0 0H10A10 10 0 0 0 0 10Z";
                        fill: Theme.secondary;
                    }
                    if root.side-mode && !root.sidebar-collapsed: Path {
                        x: 0px;
                        y: 0px;
                        width: 10px;
                        height: 10px;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M10 0A10 10 0 0 0 0 10";
                        fill: transparent;
                        stroke: Theme.divider;
                        stroke-width: Px.hair();
                    }
                }

                sb := TabSidebar {
                    x: 0px;
                    y: 0px;
                    width: root.sidebar-width;
                    height: parent.height;
                    visible: root.side-mode;
                    rows: root.tab-rows;
                    collapsed: root.sidebar-collapsed;
                    revealed: root.sidebar-revealed;
                    side-width: root.sidebar-width;
                    sliding: root.sidebar-sliding;
                    slot-now: root.sidebar-slot-now;
                    slide-now: root.sidebar-slide-now;
                    carrying: root.carrying;
                    find-key: root.find-tab-key;
                    new-tab-title: root.new-tab-title;
                    plugin-rows: root.plugin-rows;
                    hover-action(a, b) => { root.tab-hover-action(a, b); }
                    plugin-fold(s) => { root.plugin-fold(s); }
                    plugin-header-menu(s, x, y) => { root.plugin-header-menu(s, x, y); }
                    plugin-item(s, i, b) => { root.plugin-item(s, i, b); }
                    press(a, b, c, d, e, f) => { root.title-pressed(); root.side-press(a, b, c, d, e, f); }
                    drag-moved(a) => { root.side-moved(a); }
                    drag-released() => { root.side-released(); }
                    closed(a) => { root.tab-closed(a); }
                    tab-menu(a, b, c) => { root.tab-menu(a, b, c); }
                    new-tab() => { root.new-tab(); }
                    plus-menu(a, b) => { root.plus-menu(a, b); }
                    find-edited(a) => { root.side-find-edited(a); }
                    find-accepted() => { root.side-find-accepted(); }
                    find-escape() => { root.side-find-escape(); }
                    grip-moved(a) => { root.grip-moved(a); }
                    grip-released(a) => { root.grip-released(a); }
                    tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
                }
            }
        }

        // (4) OVERLAYS, last so they are on top. Each is pointer-transparent while closed.
        // The pop layer (PT LAYER.pop): the update notice and the Settings dropdown, under every menu.
        unote := UpdateNotice {
            text: root.update-notice;
            x: root.update-chip-x + root.update-chip-w - self.width;
            y: Px.snap(root.update-chip-y + root.update-chip-h + 8px);
            dismissed => { root.update-notice-dismissed(); }
        }
        SelectMenu {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: SettingsBridge.select-open;
            options: SettingsBridge.select-options;
            value: SettingsBridge.select-value;
            menu-x: SettingsBridge.select-x;
            menu-y: SettingsBridge.select-y;
            menu-w: SettingsBridge.select-w;
            menu-h: SettingsBridge.select-h;
            highlight <=> SettingsBridge.select-highlight;
            chosen(id) => { SettingsBridge.select-chosen(id); }
            dismissed => { SettingsBridge.select-dismissed(); }
            outside-right(x, y) => { SettingsBridge.select-dismissed(); root.menu-outside-right(x, y); }
            key(k) => { SettingsBridge.select-key(k); }
        }
        // The Plugins dropdown (plugins phase 4), under the menus: its header menu opens over it.
        pdrop := PluginsDropdown {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: root.plugins-open && !root.side-mode;
            rows: root.plugin-rows;
            anchor-right: top-plugins.absolute-position.x + top-plugins.width - top-plugins.gap;
            anchor-top: Px.snap(Theme.bar-height + 2px);
            dismissed => { root.plugins-dismissed(); }
            outside-right(x, y) => { root.plugins-dismissed(); root.menu-outside-right(x, y); }
            fold(s) => { root.plugin-fold(s); }
            header-menu(s, x, y) => { root.plugin-header-menu(s, x, y); }
            item(s, i, b) => { root.plugin-item(s, i, b); }
            tip(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
        }
        menu := ContextMenu {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: root.menu-open;
            rows: root.menu-rows;
            at-x: root.menu-x;
            at-y: root.menu-y;
            picked(i) => { root.menu-picked(i); }
            trailing(i) => { root.menu-trailing(i); }
            dismissed => { root.menu-dismissed(); }
            outside-right(x, y) => { root.menu-outside-right(x, y); }
        }
        ov := OverflowList {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: root.overflow-open;
            rows: root.overflow-rows;
            anchor-right: root.overflow-right;
            anchor-bottom: root.overflow-bottom;
            picked(id) => { root.overflow-picked(id); }
            row-menu(id, x, y) => { root.overflow-row-menu(id, x, y); }
            dismissed => { root.overflow-dismissed(); }
            outside-right(x, y) => { root.overflow-outside-right(x, y); }
            accepted => { root.overflow-accepted(); }
            query-edited(q) => { root.overflow-query-edited(q); }
        }
        // The Settings overlays (M7 Task 41), above the page and below the dialog. Each is
        // pointer-transparent while closed. The Command help panel joins them in Task 43.
        Timer {
            interval: 600ms;
            running: SettingsBridge.pencil-pending;
            triggered => { SettingsBridge.pencil-pending = false; }
        }
        ThemeEditor {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: SettingsBridge.editor-open;
            wells: SettingsBridge.editor-wells;
            preview: SettingsBridge.editor-preview;
            well-edited(k, t) => { SettingsBridge.editor-well-edited(k, t); }
            well-committed(k) => { SettingsBridge.editor-well-committed(k); }
            well-swatch(k, x, y, w, h) => { SettingsBridge.editor-well-swatch(k, x, y, w, h); }
            save => { SettingsBridge.editor-save(); }
            cancel => { SettingsBridge.editor-cancel(); }
            swatch-back: SettingsBridge.swatch-back;
            swatch-back-taken => { SettingsBridge.swatch-back = ""; }
            focus-restore => { SettingsBridge.pencil-pending = SettingsBridge.pencil-id != ""; }
            tip(t, x, y, w, h) => { SettingsBridge.tip(t, x, y, w, h); }
        }
        ask := AskThree {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: SettingsBridge.ask-open;
            answered(n) => { SettingsBridge.ask-answered(n); }
        }
        // The Dictation page's one-line question before a download (M8 Task 25).
        dict-ask := DictAsk {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: SettingsBridge.dict-ask-open;
            text: SettingsBridge.dict-ask-text;
            answered(n) => { SettingsBridge.dict-ask-answered(n); }
        }
        ColourPopover {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: SettingsBridge.picker-open;
            pop-x: SettingsBridge.picker-x;
            pop-y: SettingsBridge.picker-y;
            label: SettingsBridge.picker-label;
            hue: SettingsBridge.picker-hue;
            sat: SettingsBridge.picker-sat;
            val: SettingsBridge.picker-val;
            alpha: SettingsBridge.picker-alpha;
            solid-colour: SettingsBridge.picker-solid;
            start-colour: SettingsBridge.picker-start;
            now-colour: SettingsBridge.picker-now;
            hue-colour: SettingsBridge.picker-hue-colour;
            alpha-on: SettingsBridge.picker-alpha-on;
            alpha-disabled: SettingsBridge.picker-alpha-disabled;
            dropper-on: SettingsBridge.picker-dropper-on;
            format-name: SettingsBridge.picker-format;
            sv-text: SettingsBridge.picker-sv-text;
            hue-text: SettingsBridge.picker-hue-text;
            alpha-text: SettingsBridge.picker-alpha-text;
            sv-now: SettingsBridge.picker-sv-now;
            hue-now: SettingsBridge.picker-hue-now;
            alpha-now: SettingsBridge.picker-alpha-now;
            sv-moved(x, y, k) => { SettingsBridge.picker-sv(x, y, k); }
            hue-moved(x, k) => { SettingsBridge.picker-hue-moved(x, k); }
            alpha-moved(x, k) => { SettingsBridge.picker-alpha-moved(x, k); }
            slider-key(w, k, s) => { SettingsBridge.picker-key(w, k, s); }
            format-clicked => { SettingsBridge.picker-format-clicked(); }
            dropper-clicked => { SettingsBridge.picker-dropper(); }
            escape-pressed => {
                SettingsBridge.swatch-back = SettingsBridge.editor-open ? "editor:" + SettingsBridge.picker-label : SettingsBridge.picker-label;
                SettingsBridge.picker-escape();
            }
            outside-pressed => { SettingsBridge.picker-outside(); }
            focus-left => { SettingsBridge.picker-focus-left(); }
            tip(t, x, y, w, h) => { SettingsBridge.tip(t, x, y, w, h); }
        }
        // The update window: a modal, above the Settings overlays, below the close question (M9 Task 30).
        uwin := UpdateWindow {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: root.update-open;
            title: root.update-title;
            current-text: root.update-sub;
            sections: root.update-sections;
            empty-note: root.update-empty-note;
            more-text: root.update-more;
            status: root.update-status;
            pct-text: root.update-pct-text;
            pct: root.update-pct;
            running: root.update-running;
            active: root.update-active;
            cancel-label: root.update-cancel-label;
            cancel-enabled: root.update-cancel-enabled;
            cancel-tip: root.update-cancel-tip;
            install-enabled: root.update-install-enabled;
            notes-max-h: root.update-notes-max-h;
            install => { root.update-install(); }
            cancel => { root.update-cancel(); }
            abort => { root.update-abort(); }
            tip-request(a, b, c, d, e) => { root.tip-request(a, b, c, d, e); }
        }
        dlg := Dialog {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            open: root.dialog-open;
            title: root.dialog-title;
            body: root.dialog-body;
            primary-label: root.dialog-primary;
            danger: root.dialog-danger;
            opened-by-key: root.dialog-by-key;
            cancel => { root.dialog-cancel(); }
            confirm => { root.dialog-confirm(); }
        }
        // The Copied badge shows even over a dialog (PT LAYER.toast); the tip is above it.
        // Centred over the terminal, not the window: a web panel's browser window sits above anything drawn, and the
        // window's middle is inside it once the slot is wide.
        badge := CopiedBadge {
            x: root.grid-left;
            y: 0px;
            width: root.grid-w;
            height: root.height;
            phase: root.copied-phase;
        }
        tipbox := Tip {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            text: root.tip-text;
            at-x: root.tip-x;
            at-y: root.tip-y;
            visible-tip: root.tip-visible;
            side: root.tip-side;
        }
        // The window edge (the DWM border does not show on a frameless window, docs/material.md E4):
        // one device pixel in the colour edge_for answers; transparent when none, maximised or full screen.
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            visible: Theme.edge.alpha > 0;
            background: transparent;
            border-width: Px.hair();
            border-color: Theme.edge;
        }
    }
}
