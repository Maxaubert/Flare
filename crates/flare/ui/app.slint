// The Settings tab (M7 Task 1): every file is listed so the compiler checks it, and the
// previews, the real components and the two globals are reachable from Rust.
export { SetKind, BlockKind, SetOption, SetButton, SetRow, SetSection, RailItem, SetHit, WallCard, HelpRowData, HelpChip, EditorWell, RowLook } from "settings/types.slint";
export { ControlsPreview } from "settings/controls.slint";
export { SliderPreview } from "settings/slider.slint";
