// The start screen (Task 22). PT EmptyState.tsx and index.css (.p-start-in): the window with no
// tab open. The mark and the name, a short list (New terminal, the folders last used, Settings)
// and a quiet footer. No greeting, no explanation.
//
// Every row and divider sits at a whole device pixel (Px.snap), so the hover fill and the
// dividers stay crisp at 100 to 300 percent: the nav's spacing is written out, not a layout's.
import { Theme, Px } from "theme.slint";
import { Glyphs } from "glyphs.slint";
import { AppMark } from "mark.slint";
import { Place } from "types.slint";

// One row of the nav: a 16 px glyph, a name, an optional near-end text that takes the spare
// width, an optional "Pinned" tag and an optional hint at the right (the key).
component StartRow inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <string> near;
    in property <string> hint;
    in property <bool> pinned;
    in property <color> ink: Theme.text-soft;
    callback activated();
    callback hovered(bool);

    height: 36px;
    border-radius: 3px;
    background: ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        // From the left, as PT's flex row: the glyphs make one column down the nav. The glyph
        // sits in a 16 px column, centred on the row (a layout puts a fixed-height child at
        // its top).
        Rectangle {
            width: 16px;
            // Slint fits a stroked path into its box less the stroke: the box is the glyph grown by one stroke, moved
            // back by half of it, so the 24 units cover the 16 px the svg covers and the centre stays put (Task 52).
            Path {
                x: 0 - self.stroke-width / 2;
                y: Px.snap((parent.height - 16px) / 2) - self.stroke-width / 2;
                width: 16px + self.stroke-width;
                height: 16px + self.stroke-width;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.glyph;
                fill: transparent;
                stroke: ta.has-hover ? Theme.accent-hi : Theme.icon;
                stroke-width: 1.6 * 16px / 24;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            text: root.name;
            color: ta.has-hover ? Theme.text : root.ink;
            font-size: 13px;
            font-family: Theme.font-ui;
            overflow: elide;
            vertical-alignment: center;
            // The name does not shrink, but a long one is capped at 60% of the row so the
            // "Pinned" tag and the near end always stay on screen.
            horizontal-stretch: root.near == "" ? 1 : 0;
            // With no near end the name takes the spare width, so the key sits at the right.
            max-width: root.near == "" ? root.width : root.width * 0.6;
        }
        if root.near != "" : Text {
            text: root.near;
            color: Theme.dim;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.pinned : Text {
            text: "Pinned";
            color: Theme.dim;
            font-size: 11px;
            font-family: Theme.font-ui;
            vertical-alignment: center;
        }
        if root.hint != "" : Text {
            text: root.hint;
            color: Theme.dim;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            vertical-alignment: center;
        }
    }

    // Keyboard focus: a 2 px ring in the accent. Enter and Space activate the focused row.
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 3px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: Theme.accent-hi;
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            fs.focus();
            root.activated();
        }
        changed has-hover => {
            root.hovered(self.has-hover);
        }
    }
}

// The divider block: 8 above and below a 1-pixel line (a hairline at the device pixel rule).
component NavDivider inherits Rectangle {
    height: 17px;
    Rectangle {
        y: Px.snap(8px);
        width: parent.width;
        height: Px.hair();
        background: Theme.divider;
    }
}

export component StartScreen inherits Rectangle {
    in property <[Place]> places;
    in property <string> version-text;          // "Version 0.1.0" or ""
    in property <string> new-key;               // from the chord table, e.g. Ctrl+T
    in property <string> settings-key;          // from the chord table, e.g. Ctrl+,
    in property <bool> shown;                   // rising edge plays the entrance
    callback new-terminal();
    callback place-picked(string);
    callback settings();
    callback github();
    callback tip(string, length, length, length, length); // a place row's full path

    // Where the New row landed (logical px); the tests read the nav from it.
    out property <length> new-y: new-row.absolute-position.y;

    background: Theme.ground;

    property <length> foot-h: 36px;
    property <length> nav-w: min(340px, root.width - 48px);
    property <length> nav-h: root.places.length > 0 ? 112px + root.places.length * 38px : 93px;
    // mark (84) + 16 + title (28) + 40 + nav
    property <length> block-h: 84px + 16px + 28px + 40px + root.nav-h;
    property <length> block-top: Px.snap((root.height - root.foot-h - root.block-h) / 2);
    // The entrance: 0 to 1 over 420 ms on the ease-out of PT's `.p-start-in`.
    property <float> t: root.shown ? 1 : 0;
    animate t { duration: 420ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    // Everything above the footer: it rises 6 px and fades in with t.
    content := Rectangle {
        x: 0;
        y: (1 - root.t) * 6px;
        width: root.width;
        height: root.height - root.foot-h;
        opacity: root.t;

        AppMark {
            x: Px.snap((root.width - 84px) / 2);
            y: root.block-top;
            size: 84px;
            fill: Theme.accent-solid;
        }

        Text {
            x: 0;
            y: root.block-top + 100px;
            width: root.width;
            height: 28px;
            text: "Flare";
            color: Theme.text;
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.22px;
            font-family: Theme.font-ui;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        nav := Rectangle {
            x: Px.snap((root.width - root.nav-w) / 2);
            y: root.block-top + 168px;
            width: root.nav-w;
            height: root.nav-h;

            new-row := StartRow {
                y: 0;
                width: nav.width;
                glyph: Glyphs.plus-start;
                name: "New terminal";
                hint: root.new-key;
                ink: Theme.text;
                activated => { root.new-terminal(); }
            }

            if root.places.length > 0 : NavDivider {
                y: Px.snap(38px);
                width: nav.width;
            }

            for p[i] in root.places : StartRow {
                y: Px.snap(57px + i * 38px);
                width: nav.width;
                glyph: Glyphs.folder;
                name: p.name;
                near: p.near;
                pinned: p.pinned;
                activated => { root.place-picked(p.path); }
                hovered(h) => {
                    root.tip(h ? p.path : "", self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                }
            }

            NavDivider {
                y: Px.snap(root.places.length > 0 ? 57px + root.places.length * 38px : 38px);
                width: nav.width;
            }

            StartRow {
                y: Px.snap(root.places.length > 0 ? 76px + root.places.length * 38px : 57px);
                width: nav.width;
                glyph: Glyphs.cog;
                name: "Settings";
                hint: root.settings-key;
                ink: Theme.text-soft;
                activated => { root.settings(); }
            }
        }
    }

    // The footer: GitHub at the left (a rounded hover, a focus ring), the version at the right.
    footer := Rectangle {
        x: 0;
        y: root.height - root.foot-h;
        width: root.width;
        height: root.foot-h;

        gh := Rectangle {
            x: 12px;
            y: (parent.height - 24px) / 2;
            width: 64px;
            height: 24px;
            border-radius: Theme.radius-button;
            background: gh-ta.has-hover ? Theme.hover : transparent;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "GitHub";
                color: gh-ta.has-hover ? Theme.text : Theme.dim;
                font-size: 11.5px;
                font-family: Theme.font-ui;
                vertical-alignment: center;
            }

            gh-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.github(); }
            }
        }

        Text {
            x: 0;
            width: parent.width - 20px;
            height: parent.height;
            text: root.version-text;
            color: Theme.dim;
            font-size: 11.5px;
            font-family: Theme.font-ui;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

export component StartScreenPreview inherits Window {
    width: 600px;
    height: 400px;
    background: Theme.ground;

    in property <[Place]> places;
    in property <string> version-text: "Version 0.1.0";
    in property <string> new-key;               // the tests set it from the chord table
    in property <string> settings-key;
    in property <bool> shown: true;
    out property <length> new-y: sc.new-y;

    callback new-terminal();
    callback place-picked(string);
    callback settings();
    callback github();
    callback tip(string, length, length, length, length);

    sc := StartScreen {
        width: root.width;
        height: root.height;
        places: root.places;
        version-text: root.version-text;
        new-key: root.new-key;
        settings-key: root.settings-key;
        shown: root.shown;
        new-terminal => { root.new-terminal(); }
        place-picked(p) => { root.place-picked(p); }
        settings => { root.settings(); }
        github => { root.github(); }
        tip(a, b, c, d, e) => { root.tip(a, b, c, d, e); }
    }
}
