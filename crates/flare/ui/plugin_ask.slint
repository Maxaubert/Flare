// A plugin's question in Flare's own dialog (the `fill` permission, 2026-10-28), centred and in the plugin's own look
// (2026-11-08, spec: unlock B and fill approval B; plugin_look.slint): a fill to approve ("Fill <login>?", a card with
// the site and who asked in which tab, wide Deny and Fill, "Deny for this session" as a link), or a secret the plugin
// asks for (`secret.ask`: its logo, the title as the heading, the optional sub under it, one masked field with the
// label as its placeholder and an eye to show it, a full-width button with the plugin's word, Cancel as a link).
// The words under each say whose question it is: the plugin's name comes from Flare, never from the plugin.
// Fill is pressed by the pointer only: no key presses it (Enter and Space press the Deny button that has the focus),
// so a key sent at the window cannot approve a fill. Escape and a press outside the box are Deny (or Cancel).
// Fill takes no press for its first moment (ARM-DELAY): a question that pops up under a click already on its way
// (an agent can time its fill to the person's clicks) is never approved by that click.
// The field's text is cleared as the dialog closes; it is handed to the glue once, with the button or Enter.
import { Theme, Px } from "theme.slint";
import { PluginLook, PluginInk, PluginLogo } from "plugin_look.slint";

// A button of the question: primary (the brand's colour), outlined, or a link (words only).
component AskButton inherits Rectangle {
    in property <PluginLook> look;
    in property <string> label;
    in property <bool> primary;
    in property <bool> link;
    in property <bool> enabled: true;
    in property <bool> ringed;
    // True leaves out the accessible default action, so only the pointer presses it (a fill's Fill).
    in property <bool> pointer-only;
    callback clicked();
    height: 36px;
    min-width: lbl.preferred-width + (root.link ? 12px : 32px);
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? (ta.has-hover && root.enabled ? PluginInk.accent(root.look).brighter(0.1) : PluginInk.accent(root.look))
        : (!root.link && ta.has-hover && root.enabled ? PluginInk.card(root.look) : transparent);
    border-width: root.primary || root.link ? 0px : Px.hair();
    border-color: PluginInk.line(root.look);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled && !root.pointer-only {
            root.clicked();
        }
    }
    lbl := Text {
        text: root.label;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-family: Theme.font-ui;
        font-size: 13px;
        font-weight: 600;
        color: root.primary ? PluginInk.on-accent(root.look) : (root.link ? PluginInk.accent-hi(root.look) : PluginInk.text(root.look));
    }
    // The keyboard focus ring, 2 px outside the button.
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.ringed && root.enabled ? PluginInk.accent-hi(root.look) : transparent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component PluginAsk inherits Rectangle {
    in property <bool> open;
    // 0 a fill to approve, 1 a secret to type.
    in property <int> kind;
    // The heading: "Fill <login>?", or the secret's title.
    in property <string> title;
    // A secret's sub line (an account), or "".
    in property <string> sub;
    // What the field is for (a secret's placeholder).
    in property <string> label;
    // The secret's button ("OK" when the plugin names none).
    in property <string> button;
    // A fill's card: the site, who asked and where, and the letter on its tile.
    in property <string> site;
    in property <string> asker;
    in property <string> letter;
    // Whose question it is, from Flare.
    in property <string> foot;
    in property <PluginLook> look;
    // A fill's answer: 0 Deny, 1 Fill, 2 Deny for this session.
    callback fill-answer(int);
    // A secret's answer: the button with the text, or Cancel.
    callback secret-answer(bool, string);

    // The Deny button that holds the keys in a fill (0 Deny, 1 Deny for this session); never Fill.
    property <int> focus-idx: 0;
    property <bool> by-key;
    // Fill takes presses (ARM-DELAY after the question went up).
    property <bool> armed;
    // The eye: the secret is shown as typed.
    property <bool> reveal;
    out property <bool> allow-armed: root.armed;
    out property <bool> field-has-focus: field.has-focus;
    out property <bool> revealed: root.reveal;
    // Where the buttons are, for the e2e's pointer (it presses them as the person would).
    out property <length> allow-x: allow-btn.absolute-position.x;
    out property <length> allow-y: allow-btn.absolute-position.y;
    out property <length> allow-w: allow-btn.width;
    out property <length> allow-h: allow-btn.height;
    out property <length> deny-x: root.kind == 1 ? cancel-btn.absolute-position.x : deny-btn.absolute-position.x;
    out property <length> deny-y: root.kind == 1 ? cancel-btn.absolute-position.y : deny-btn.absolute-position.y;
    out property <length> deny-w: root.kind == 1 ? cancel-btn.width : deny-btn.width;
    out property <length> deny-h: root.kind == 1 ? cancel-btn.height : deny-btn.height;
    out property <length> session-x: session-btn.absolute-position.x;
    out property <length> session-y: session-btn.absolute-position.y;
    out property <length> session-w: session-btn.width;
    out property <length> session-h: session-btn.height;
    out property <length> ok-x: ok-btn.absolute-position.x;
    out property <length> ok-y: ok-btn.absolute-position.y;
    out property <length> ok-w: ok-btn.width;
    out property <length> ok-h: ok-btn.height;
    out property <length> eye-x: eye.absolute-position.x;
    out property <length> eye-y: eye.absolute-position.y;
    out property <length> box-x: box.x;
    out property <length> box-y: box.y;
    out property <length> box-w: box.width;
    out property <length> box-h: box.height;

    function cancel() {
        if root.kind == 1 {
            field.text = "";
            root.secret-answer(false, "");
        } else {
            root.fill-answer(0);
        }
    }
    function send-secret() {
        let t = field.text;
        field.text = "";
        root.secret-answer(true, t);
    }

    visible: root.open;
    width: 100%;
    height: 100%;
    changed open => {
        field.text = "";
        root.reveal = false;
        if root.open {
            root.focus-idx = 0;
            root.by-key = false;
            root.armed = false;
            if root.kind == 1 {
                field.focus();
            } else {
                fs.focus();
            }
        }
    }

    // ARM-DELAY: long enough to outlast a click begun before the question showed, short enough not to be felt.
    Timer {
        interval: 700ms;
        running: root.open && root.kind == 0 && !root.armed;
        triggered => { root.armed = true; }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.cancel();
            }
        }
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if root.kind == 0 && (e.text == Key.Return || e.text == " ") {
                root.by-key = true;
                root.fill-answer(root.focus-idx == 1 ? 2 : 0);
                return accept;
            }
            if root.kind == 0 && (e.text == Key.Tab || e.text == Key.Backtab) && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.by-key = true;
                root.focus-idx = 1 - root.focus-idx;
                return accept;
            }
            return reject;
        }
    }

    box := Rectangle {
        width: min(380px, root.width - 48px);
        height: col.preferred-height;
        x: Px.snap((root.width - self.width) / 2);
        y: Px.snap((root.height - self.height) / 2);
        background: PluginInk.bg(root.look);
        border-radius: 14px;
        border-width: Px.hair();
        border-color: PluginInk.line(root.look);
        drop-shadow-offset-y: 20px;
        drop-shadow-blur: 50px;
        drop-shadow-color: #000000bb;
        // Presses inside the box never reach the scrim.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }
        col := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 22px;
            padding-bottom: 16px;
            HorizontalLayout {
                alignment: center;
                PluginLogo {
                    look: root.look;
                    size: root.kind == 1 ? 44px : 40px;
                }
            }
            Rectangle { height: 10px; }
            Text {
                text: root.title;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-family: Theme.font-ui;
                font-size: 16px;
                font-weight: 650;
                color: PluginInk.text(root.look);
            }
            if root.kind == 1 && root.sub != "": Text {
                text: root.sub;
                horizontal-alignment: center;
                font-family: Theme.font-ui;
                font-size: 12.5px;
                color: PluginInk.dim(root.look);
                overflow: elide;
            }
            Rectangle { height: root.kind == 1 ? 14px : 12px; }
            // A fill: the site's card.
            if root.kind == 0: Rectangle {
                height: 54px;
                background: PluginInk.card(root.look);
                border-width: Px.hair();
                border-color: PluginInk.line(root.look);
                border-radius: 10px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: root.look.branded ? #0d1117 : Theme.ground;
                            Text {
                                text: root.letter;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-family: Theme.font-ui;
                                font-size: 15px;
                                font-weight: 600;
                                color: #ffffff;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.site;
                            font-family: Theme.font-ui;
                            font-size: 13.5px;
                            font-weight: 600;
                            color: PluginInk.text(root.look);
                            overflow: elide;
                        }
                        Text {
                            text: root.asker;
                            font-family: Theme.font-ui;
                            font-size: 12.5px;
                            color: PluginInk.muted(root.look);
                            overflow: elide;
                        }
                    }
                }
            }
            // A secret: the masked field, its placeholder and the eye.
            Rectangle {
                visible: root.kind == 1;
                height: root.kind == 1 ? 42px : 0px;
                border-radius: 8px;
                background: PluginInk.field(root.look);
                border-width: Px.hair();
                border-color: field.has-focus ? PluginInk.accent-hi(root.look) : PluginInk.line(root.look);
                // The glow of the focused field.
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 11px;
                    border-width: 3px;
                    border-color: field.has-focus ? PluginInk.accent-hi(root.look).with-alpha(0.2) : transparent;
                }
                if field.text == "": Text {
                    x: 12px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: root.label;
                    vertical-alignment: center;
                    font-family: Theme.font-ui;
                    font-size: 13.5px;
                    color: PluginInk.dim(root.look);
                    overflow: elide;
                }
                field := TextInput {
                    x: 12px;
                    width: parent.width - 48px;
                    height: parent.height;
                    enabled: root.kind == 1;
                    single-line: true;
                    input-type: root.reveal ? InputType.text : InputType.password;
                    font-family: Theme.font-ui;
                    font-size: 13.5px;
                    color: PluginInk.text(root.look);
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-label: root.label;
                    accepted => { root.send-secret(); }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.cancel();
                            return accept;
                        }
                        return reject;
                    }
                }
                eye := Rectangle {
                    x: parent.width - 36px;
                    width: 32px;
                    height: parent.height;
                    accessible-role: AccessibleRole.button;
                    accessible-label: root.reveal ? "Hide what you typed" : "Show what you typed";
                    accessible-action-default => { root.reveal = !root.reveal; }
                    Path {
                        x: (parent.width - 17px) / 2 - 0.9px;
                        y: (parent.height - 17px) / 2 - 0.9px;
                        width: 17px + 1.8px;
                        height: 17px + 1.8px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.reveal ? "M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12ZM9.5 12a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0-5 0M4 4l16 16" : "M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12ZM9.5 12a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0-5 0";
                        fill: transparent;
                        stroke: eta.has-hover ? PluginInk.text(root.look) : PluginInk.muted(root.look);
                        stroke-width: 1.8px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                    eta := TouchArea {
                        clicked => {
                            root.reveal = !root.reveal;
                            field.focus();
                        }
                    }
                }
            }
            Rectangle { height: root.kind == 1 ? 12px : 16px; }
            // A secret: the full-width button. A fill: Deny and Fill, side by side.
            ok-btn := AskButton {
                visible: root.kind == 1;
                height: root.kind == 1 ? 36px : 0px;
                look: root.look;
                label: root.button;
                primary: true;
                clicked => { root.send-secret(); }
            }
            HorizontalLayout {
                visible: root.kind == 0;
                height: root.kind == 0 ? 36px : 0px;
                spacing: 8px;
                deny-btn := AskButton {
                    horizontal-stretch: 1;
                    look: root.look;
                    label: "Deny";
                    ringed: root.by-key && root.focus-idx == 0;
                    clicked => { root.cancel(); }
                }
                allow-btn := AskButton {
                    horizontal-stretch: 1;
                    look: root.look;
                    label: "Fill";
                    primary: true;
                    enabled: root.armed;
                    // Pointer only: a screen reader reads it, but no key or default action presses it.
                    pointer-only: true;
                    clicked => { root.fill-answer(1); }
                }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                alignment: center;
                cancel-btn := AskButton {
                    visible: root.kind == 1;
                    width: root.kind == 1 ? self.min-width : 0px;
                    look: root.look;
                    label: "Cancel";
                    link: true;
                    clicked => { root.cancel(); }
                }
                session-btn := AskButton {
                    visible: root.kind == 0;
                    width: root.kind == 0 ? self.min-width : 0px;
                    look: root.look;
                    label: "Deny for this session";
                    link: true;
                    ringed: root.by-key && root.focus-idx == 1;
                    clicked => { root.fill-answer(2); }
                }
            }
            Rectangle { height: 4px; }
            Text {
                text: root.foot;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: PluginInk.dim(root.look);
            }
        }
    }
}
