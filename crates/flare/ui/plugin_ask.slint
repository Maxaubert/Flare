// A plugin's question in Flare's own dialog (the `fill` permission, 2026-10-28), centred and in the plugin's own look
// (2026-11-08, spec: unlock B and fill approval B; plugin_look.slint): a fill to approve ("Fill <login>?", a card with
// the site and who asked in which tab, wide Deny and Fill, nothing under them since 2026-11-10), or a secret the plugin
// asks for (`secret.ask`: its logo, the title as the heading, the optional sub under it, one masked field with the
// label as its placeholder and an eye to show it, a full-width button with the plugin's word, Cancel as a link).
// A secret ask with an `error` (2026-11-15, the approved mockup C) shows that line in the sub's place in the error
// colour, and the field gets a red edge with a soft red glow; it is empty and has the keys as always.
// A secret ends at Cancel: Max took the short grey "Asked by <plugin>" line under it out (rule 1266, 2026-11-16).
// Fill is pressed by the pointer only: no key presses it (Enter and Space press Deny, which holds the keys),
// so a key sent at the window cannot approve a fill. Escape and a press outside the box are Deny (or Cancel).
// Fill takes no press for its first moment (ARM-DELAY): a question that pops up under a click already on its way
// (an agent can time its fill to the person's clicks) is never approved by that click.
// The field's text is cleared as the dialog closes; it is handed to the glue once, with the button or Enter.
// A secret ask with `verify` (2026-11-16, rule 1274, Max's approved mockup) stays open after Unlock while the plugin
// checks: the field dimmed and read-only (it keeps the dots), the button off with a small spinner, the checking line
// in the sub's place, Cancel still works. Then a green check with the plugin's heading and line (Flare closes it
// after 0.8 s), or back to the field in place with the red error line, the field cleared and holding the keys, or
// the plugin's plain end line under its logo. The green is a theme token (`PluginInk.ok`).
import { Theme, Px, BrandInk } from "theme.slint";
import { PluginLook, PluginInk, PluginLogo } from "plugin_look.slint";

// A button of the question: primary (the brand's colour), outlined, or a link (words only).
component AskButton inherits Rectangle {
    in property <PluginLook> look;
    in property <string> label;
    in property <bool> primary;
    in property <bool> link;
    in property <bool> enabled: true;
    in property <bool> ringed;
    // True leaves out the accessible default action, so only the pointer presses it (a fill's Fill).
    in property <bool> pointer-only;
    // A small spinner in place of the label (a secret being checked, the mockup's button); the button is off then.
    in property <bool> busy;
    callback clicked();
    property <angle> turn: 0deg;
    height: 36px;
    min-width: lbl.preferred-width + (root.link ? 12px : 32px);
    border-radius: 8px;
    opacity: root.enabled ? 1 : (root.busy ? 0.55 : 0.45);
    background: root.primary ? (ta.has-hover && root.enabled ? PluginInk.accent(root.look).brighter(0.1) : PluginInk.accent(root.look))
        : (!root.link && ta.has-hover && root.enabled ? PluginInk.card(root.look) : transparent);
    border-width: root.primary || root.link ? 0px : Px.hair();
    border-color: PluginInk.line(root.look);
    accessible-role: button;
    accessible-label: root.busy ? "Checking" : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled && !root.pointer-only {
            root.clicked();
        }
    }
    // The spinner turns (the Computer sharing dialog's pattern): a 16 px ring in a faint ink with a full quarter.
    Timer {
        interval: 50ms;
        running: root.busy;
        triggered => { root.turn = root.turn + 18deg; }
    }
    if root.busy: Rectangle {
        x: (root.width - 16px) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 2px;
        border-color: (root.primary ? PluginInk.on-accent(root.look) : PluginInk.text(root.look)).with-alpha(0.35);
    }
    // One stroke wider than its 16 px box, moved back by half a stroke: Slint fits a stroked Path into its box less
    // one stroke (the eye's pattern; `ui_tests::icons_misc` measures it).
    if root.busy: Path {
        x: (root.width - 16px) / 2 - 1px;
        y: (root.height - 16px) / 2 - 1px;
        width: 16px + 2px;
        height: 16px + 2px;
        viewbox-width: 16;
        viewbox-height: 16;
        // The quarter is drawn at its angle (a Path does not turn with transform-rotation), as one cubic curve.
        commands: "M" + (8 + 7 * cos(root.turn - 90deg)) + " " + (8 + 7 * sin(root.turn - 90deg))
            + "C" + (8 + 7 * cos(root.turn - 90deg) - 3.866 * sin(root.turn - 90deg)) + " " + (8 + 7 * sin(root.turn - 90deg) + 3.866 * cos(root.turn - 90deg))
            + " " + (8 + 7 * cos(root.turn) + 3.866 * sin(root.turn)) + " " + (8 + 7 * sin(root.turn) - 3.866 * cos(root.turn))
            + " " + (8 + 7 * cos(root.turn)) + " " + (8 + 7 * sin(root.turn));
        fill: transparent;
        stroke: root.primary ? PluginInk.on-accent(root.look) : PluginInk.text(root.look);
        stroke-width: 2px;
    }
    lbl := Text {
        visible: !root.busy;
        text: root.label;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-family: Theme.font-ui;
        font-size: 13px;
        font-weight: 600;
        color: root.primary ? PluginInk.on-accent(root.look) : (root.link ? PluginInk.accent-hi(root.look) : PluginInk.text(root.look));
    }
    // The keyboard focus ring, 2 px outside the button.
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.ringed && root.enabled ? PluginInk.accent-hi(root.look) : transparent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component PluginAsk inherits Rectangle {
    in property <bool> open;
    // 0 a fill to approve, 1 a secret to type.
    in property <int> kind;
    // The heading: "Fill <login>?", or the secret's title.
    in property <string> title;
    // A secret's sub line (an account), or "".
    in property <string> sub;
    // A secret's error line (why the last answer failed), or "". Shown in the sub's place, in red.
    in property <string> error;
    // What the field is for (a secret's placeholder).
    in property <string> label;
    // The secret's button ("OK" when the plugin names none).
    in property <string> button;
    // A fill's card: the site, who asked and where, and the letter on its tile.
    in property <string> site;
    in property <string> asker;
    in property <string> letter;
    in property <PluginLook> look;
    // A secret's stage (`secret.ask` with `verify`, 2026-11-16, Max's approved mockup): 0 the field, 1 checking what
    // was sent (the field dimmed and read-only, a spinner in the button, Cancel still works), 2 checked and right (a
    // green check, the result's heading and line; Flare closes it a moment later), 3 ended by the plugin with a plain
    // line (its logo, the heading and the line). An ask without `verify` stays at 0.
    in property <int> stage;
    // A `verify` ask: the field keeps what was sent while it is checked (it is cleared when it comes back as wrong).
    in property <bool> verify;
    // The line under the title while checking, in the sub's place ("Checking the password...").
    in property <string> checking;
    // The heading and the line of a result (stages 2 and 3).
    in property <string> result-title;
    in property <string> result-line;
    // A fill's answer: 0 Deny, 1 Fill.
    callback fill-answer(int);
    // A secret's answer: the button with the text, or Cancel.
    callback secret-answer(bool, string);

    // A key was pressed in a fill: Deny, which holds the keys (never Fill), shows its ring.
    property <bool> by-key;
    // Fill takes presses (ARM-DELAY after the question went up).
    property <bool> armed;
    // The eye: the secret is shown as typed.
    property <bool> reveal;
    // A secret's field, button, Cancel and foot are up (any stage but a result).
    property <bool> asking: root.kind == 1 && root.stage < 2;
    // The line under a secret's title: a result's line, the checking line, the error (in red) or the sub.
    property <string> under: root.kind != 1 ? "" : root.stage >= 2 ? root.result-line : root.stage == 1 ? root.checking : root.error-shown ? root.error : root.sub;
    out property <bool> allow-armed: root.armed;
    out property <bool> field-has-focus: field.has-focus;
    // The secret shows its error: the red line and the field's red edge.
    out property <bool> error-shown: root.kind == 1 && root.stage == 0 && root.error != "";
    // The stages as the tests read them: checking (field read-only, the button off with its spinner) and a result.
    out property <bool> checking-shown: root.kind == 1 && root.stage == 1;
    out property <bool> result-shown: root.kind == 1 && root.stage >= 2;
    out property <bool> field-read-only: field.read-only;
    out property <bool> field-empty: field.text == "";
    out property <bool> ok-enabled: ok-btn.enabled;
    // Where the mark above the title is (the logo, or a result's green check), for the UI tests.
    out property <length> mark-x: mark.absolute-position.x;
    out property <length> mark-y: mark.absolute-position.y;
    out property <length> mark-w: mark.width;
    out property <length> mark-h: mark.height;
    // Where the field is, for the UI tests (its edge).
    out property <length> field-x: fbox.absolute-position.x;
    out property <length> field-y: fbox.absolute-position.y;
    out property <length> field-w: fbox.width;
    out property <length> field-h: fbox.height;
    out property <bool> revealed: root.reveal;
    // Where the buttons are, for the e2e's pointer (it presses them as the person would).
    out property <length> allow-x: allow-btn.absolute-position.x;
    out property <length> allow-y: allow-btn.absolute-position.y;
    out property <length> allow-w: allow-btn.width;
    out property <length> allow-h: allow-btn.height;
    out property <length> deny-x: root.kind == 1 ? cancel-btn.absolute-position.x : deny-btn.absolute-position.x;
    out property <length> deny-y: root.kind == 1 ? cancel-btn.absolute-position.y : deny-btn.absolute-position.y;
    out property <length> deny-w: root.kind == 1 ? cancel-btn.width : deny-btn.width;
    out property <length> deny-h: root.kind == 1 ? cancel-btn.height : deny-btn.height;
    out property <length> ok-x: ok-btn.absolute-position.x;
    out property <length> ok-y: ok-btn.absolute-position.y;
    out property <length> ok-w: ok-btn.width;
    out property <length> ok-h: ok-btn.height;
    out property <length> eye-x: eye.absolute-position.x;
    out property <length> eye-y: eye.absolute-position.y;
    out property <length> box-x: box.x;
    out property <length> box-y: box.y;
    out property <length> box-w: box.width;
    out property <length> box-h: box.height;

    function cancel() {
        if root.kind == 1 {
            // A result closes by itself in a moment: nothing to cancel.
            if root.stage >= 2 {
                return;
            }
            field.text = "";
            root.secret-answer(false, "");
        } else {
            root.fill-answer(0);
        }
    }
    function send-secret() {
        // Sent once: while it is checked the field is read-only and the button off.
        if root.stage != 0 {
            return;
        }
        let t = field.text;
        if !root.verify {
            field.text = "";
        }
        root.secret-answer(true, t);
    }

    visible: root.open;
    width: 100%;
    height: 100%;
    // Back from checking (the plugin said wrong, or the check ran out of time): the field is cleared and has the keys.
    changed stage => {
        if root.open && root.kind == 1 && root.stage == 0 {
            field.text = "";
            field.focus();
        }
        if root.stage != 0 {
            root.reveal = false;
        }
    }
    changed open => {
        field.text = "";
        root.reveal = false;
        if root.open {
            root.by-key = false;
            root.armed = false;
            if root.kind == 1 {
                field.focus();
            } else {
                fs.focus();
            }
        }
    }

    // ARM-DELAY: long enough to outlast a click begun before the question showed, short enough not to be felt.
    Timer {
        interval: 700ms;
        running: root.open && root.kind == 0 && !root.armed;
        triggered => { root.armed = true; }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.cancel();
            }
        }
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if root.kind == 0 && (e.text == Key.Return || e.text == " ") {
                root.by-key = true;
                root.fill-answer(0);
                return accept;
            }
            // Tab stays on Deny, the one button the keys reach, and shows its ring.
            if root.kind == 0 && (e.text == Key.Tab || e.text == Key.Backtab) && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                root.by-key = true;
                return accept;
            }
            return reject;
        }
    }

    box := Rectangle {
        width: min(380px, root.width - 48px);
        height: col.preferred-height;
        x: Px.snap((root.width - self.width) / 2);
        y: Px.snap((root.height - self.height) / 2);
        background: PluginInk.bg(root.look);
        border-radius: 14px;
        border-width: Px.hair();
        border-color: PluginInk.line(root.look);
        drop-shadow-offset-y: 20px;
        drop-shadow-blur: 50px;
        drop-shadow-color: BrandInk.shadow;
        // Presses inside the box never reach the scrim.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }
        col := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 22px;
            // A fill ends at Deny and Fill: the same room under them as at the sides.
            padding-bottom: root.kind == 0 ? 20px : 16px;
            HorizontalLayout {
                alignment: center;
                mark := Rectangle {
                    width: root.kind == 1 ? 44px : 40px;
                    height: self.width;
                    // A right answer: the green check on a soft round tile of its colour (the mockup's `.okc`).
                    if root.kind == 1 && root.stage == 2: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: self.width / 2;
                        background: PluginInk.ok(root.look).with-alpha(0.15);
                        // One stroke wider than its 24 px box, moved back by half a stroke (the eye's pattern).
                        Path {
                            x: (parent.width - 24px) / 2 - 1.5px;
                            y: (parent.height - 24px) / 2 - 1.5px;
                            width: 24px + 3px;
                            height: 24px + 3px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M5 12.5L9.5 17L19 7.5";
                            fill: transparent;
                            stroke: PluginInk.ok(root.look);
                            stroke-width: 3px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    if !(root.kind == 1 && root.stage == 2): PluginLogo {
                        look: root.look;
                        size: parent.width;
                    }
                }
            }
            Rectangle { height: root.kind == 1 && root.stage == 2 ? 12px : 10px; }
            Text {
                text: root.kind == 1 && root.stage >= 2 ? root.result-title : root.title;
                wrap: word-wrap;
                horizontal-alignment: center;
                font-family: Theme.font-ui;
                font-size: 16px;
                font-weight: 650;
                color: PluginInk.text(root.look);
            }
            // Under the title: a result's line, the checking line, the error (in red) or the sub.
            if root.under != "": Text {
                text: root.under;
                horizontal-alignment: center;
                wrap: root.stage >= 2 ? word-wrap : no-wrap;
                font-family: Theme.font-ui;
                font-size: 12.5px;
                color: root.error-shown ? PluginInk.error(root.look) : PluginInk.dim(root.look);
                overflow: elide;
            }
            Rectangle { height: root.kind == 1 ? (root.stage >= 2 ? 8px : 14px) : 12px; }
            // A fill: the site's card.
            if root.kind == 0: Rectangle {
                height: 54px;
                background: PluginInk.card(root.look);
                border-width: Px.hair();
                border-color: PluginInk.line(root.look);
                border-radius: 10px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: root.look.branded ? BrandInk.site : Theme.ground;
                            Text {
                                text: root.letter;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-family: Theme.font-ui;
                                font-size: 15px;
                                font-weight: 600;
                                color: BrandInk.plate;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.site;
                            font-family: Theme.font-ui;
                            font-size: 13.5px;
                            font-weight: 600;
                            color: PluginInk.text(root.look);
                            overflow: elide;
                        }
                        Text {
                            text: root.asker;
                            font-family: Theme.font-ui;
                            font-size: 12.5px;
                            color: PluginInk.muted(root.look);
                            overflow: elide;
                        }
                    }
                }
            }
            // A secret: the masked field, its placeholder and the eye. With an error: a red edge and a red glow.
            fbox := Rectangle {
                visible: root.asking;
                height: root.asking ? 42px : 0px;
                // Checking: dimmed (the mockup's 0.6) and read-only.
                opacity: root.stage == 1 ? 0.6 : 1;
                border-radius: 8px;
                background: PluginInk.field(root.look);
                border-width: Px.hair();
                border-color: root.error-shown ? PluginInk.error-edge(root.look) : (field.has-focus ? PluginInk.accent-hi(root.look) : PluginInk.line(root.look));
                // The glow of the focused field, red while it shows an error.
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 11px;
                    border-width: 3px;
                    border-color: root.error-shown ? PluginInk.error-edge(root.look).with-alpha(0.22) : (field.has-focus ? PluginInk.accent-hi(root.look).with-alpha(0.2) : transparent);
                }
                if field.text == "": Text {
                    x: 12px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: root.label;
                    vertical-alignment: center;
                    font-family: Theme.font-ui;
                    font-size: 13.5px;
                    color: PluginInk.dim(root.look);
                    overflow: elide;
                }
                field := TextInput {
                    x: 12px;
                    width: parent.width - 48px;
                    height: parent.height;
                    enabled: root.kind == 1;
                    read-only: root.stage == 1;
                    single-line: true;
                    input-type: root.reveal ? InputType.text : InputType.password;
                    font-family: Theme.font-ui;
                    font-size: 13.5px;
                    color: PluginInk.text(root.look);
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-label: root.label;
                    accessible-description: root.error-shown ? root.error : "";
                    accepted => { root.send-secret(); }
                    key-pressed(e) => {
                        if e.text == Key.Escape {
                            root.cancel();
                            return accept;
                        }
                        return reject;
                    }
                }
                eye := Rectangle {
                    x: parent.width - 36px;
                    width: 32px;
                    height: parent.height;
                    accessible-role: AccessibleRole.button;
                    accessible-label: root.reveal ? "Hide what you typed" : "Show what you typed";
                    accessible-action-default => { root.reveal = !root.reveal; }
                    Path {
                        x: (parent.width - 17px) / 2 - 0.9px;
                        y: (parent.height - 17px) / 2 - 0.9px;
                        width: 17px + 1.8px;
                        height: 17px + 1.8px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.reveal ? "M2 12C2 12 5.5 6 12 6C18.5 6 22 12 22 12C22 12 18.5 18 12 18C5.5 18 2 12 2 12ZM9.5 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M4 4l16 16" : "M2 12C2 12 5.5 6 12 6C18.5 6 22 12 22 12C22 12 18.5 18 12 18C5.5 18 2 12 2 12ZM9.5 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0";
                        fill: transparent;
                        stroke: eta.has-hover ? PluginInk.text(root.look) : PluginInk.muted(root.look);
                        stroke-width: 1.8px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                    eta := TouchArea {
                        enabled: root.stage == 0;
                        clicked => {
                            root.reveal = !root.reveal;
                            field.focus();
                        }
                    }
                }
            }
            Rectangle { height: root.kind == 1 ? (root.asking ? 12px : 0px) : 16px; }
            // A secret: the full-width button. A fill: Deny and Fill, side by side.
            ok-btn := AskButton {
                visible: root.asking;
                height: root.asking ? 36px : 0px;
                look: root.look;
                label: root.button;
                primary: true;
                enabled: root.stage == 0;
                busy: root.stage == 1;
                clicked => { root.send-secret(); }
            }
            HorizontalLayout {
                visible: root.kind == 0;
                height: root.kind == 0 ? 36px : 0px;
                spacing: 8px;
                deny-btn := AskButton {
                    horizontal-stretch: 1;
                    look: root.look;
                    label: "Deny";
                    ringed: root.by-key;
                    clicked => { root.cancel(); }
                }
                allow-btn := AskButton {
                    horizontal-stretch: 1;
                    look: root.look;
                    label: "Fill";
                    primary: true;
                    enabled: root.armed;
                    // Pointer only: a screen reader reads it, but no key or default action presses it.
                    pointer-only: true;
                    clicked => { root.fill-answer(1); }
                }
            }
            // A secret: Cancel as a link, the last row (no line under it, 2026-11-16). A fill ends at its buttons.
            Rectangle { height: root.asking ? 6px : 0px; }
            HorizontalLayout {
                visible: root.asking;
                height: root.asking ? 36px : 0px;
                alignment: center;
                cancel-btn := AskButton {
                    width: self.min-width;
                    look: root.look;
                    label: "Cancel";
                    link: true;
                    clicked => { root.cancel(); }
                }
            }
        }
    }
}
