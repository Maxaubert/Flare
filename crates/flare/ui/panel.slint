// The panel slot (Surfaces stage 1): a header (title, close) and one native viewer, an image or a
// read-only text file. A web page has no header: its address row is the top, with the close at its end. The slot is placed by app.slint (right of the grid, after a splitter); this
// file draws what is inside it. While the panel is closed nothing is drawn, no timer or animation
// exists, and the controller keeps the picture and the rows empty.
//
// Whole device pixels everywhere (`Px.snap`), as the rest of the chrome. Nothing here moves on its own.

import { Theme, Px, SettingsFixed, SettingsInk } from "theme.slint";
import { Glyphs } from "glyphs.slint";
import { ViewThumb } from "scrollbar.slint";
import { ChangesView, ConvoFileRow, ConvoDiffRow } from "convo.slint";
import { FindBar } from "find.slint";

// The header's close button: 20 px, the glyph 10 px, as the tab strip's close.
component PanelClose inherits Rectangle {
    in property <string> label: "Close panel";
    callback clicked();
    width: Px.snap(20px);
    height: Px.snap(20px);
    border-radius: Theme.radius-button;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Path {
        x: (parent.width - 10px) / 2 - self.stroke-width / 2;
        y: (parent.height - 10px) / 2 - self.stroke-width / 2;
        width: 10px + self.stroke-width;
        height: 10px + self.stroke-width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Glyphs.close;
        fill: transparent;
        stroke: ta.has-hover ? Theme.text : Theme.icon;
        stroke-width: 2.2 * 10px / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The side panel's fading scroll thumb (scrollbar.slint).
component PanelThumb inherits ViewThumb {}

// An image: fitted to the slot (never enlarged), or at one image pixel to one device pixel with
// scrollbars of its own after a click. A picture with transparency sits on a checkerboard.
component ImageView inherits Rectangle {
    in property <image> picture;
    in property <image> checker;
    in property <bool> has-alpha;
    in-out property <bool> actual;
    callback pressed();

    // The picture's own size in device pixels, as logical lengths.
    out property <length> nat-w: root.picture.width * 1phx;
    out property <length> nat-h: root.picture.height * 1phx;
    // The share of its own size the picture is drawn at when it is fitted.
    out property <float> fit: (root.nat-w <= 0px || root.nat-h <= 0px) ? 1.0 : min(1.0, min(root.width / root.nat-w, root.height / root.nat-h));
    out property <bool> can-zoom: root.fit < 0.9999;
    out property <bool> zoomed: root.actual && root.can-zoom;
    // What is drawn now.
    out property <length> shown-w: root.zoomed ? root.nat-w : Px.snap(root.nat-w * root.fit);
    out property <length> shown-h: root.zoomed ? root.nat-h : Px.snap(root.nat-h * root.fit);
    out property <length> image-x: img-box.absolute-position.x;
    out property <length> image-y: img-box.absolute-position.y;

    public function scroll-by(dx: length, dy: length) {
        flick.content-x = min(0px, max(root.width - flick.content-width, flick.content-x + dx));
        flick.content-y = min(0px, max(root.height - flick.content-height, flick.content-y + dy));
    }
    public function toggle() {
        if (root.can-zoom) {
            root.actual = !root.actual;
        }
    }
    changed zoomed => {
        // Zooming in starts on the middle of the picture.
        flick.content-x = root.zoomed ? min(0px, (root.width - flick.content-width) / 2) : 0px;
        flick.content-y = root.zoomed ? min(0px, (root.height - flick.content-height) / 2) : 0px;
    }

    clip: true;
    flick := Flickable {
        width: root.width;
        height: root.height;
        interactive: root.zoomed;
        content-width: max(root.shown-w, root.width);
        content-height: max(root.shown-h, root.height);
        img-box := Rectangle {
            x: Px.snap((flick.content-width - self.width) / 2);
            y: Px.snap((flick.content-height - self.height) / 2);
            width: root.shown-w;
            height: root.shown-h;
            if root.has-alpha: Image {
                width: parent.width;
                height: parent.height;
                source: root.checker;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
            }
            Image {
                width: parent.width;
                height: parent.height;
                source: root.picture;
                image-fit: fill;
            }
            TouchArea {
                mouse-cursor: root.can-zoom ? MouseCursor.pointer : MouseCursor.default;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.pressed();
                    }
                }
                clicked => { root.toggle(); }
            }
        }
    }
    PanelThumb {
        x: root.width - self.width;
        y: 0px;
        view-h: root.height;
        content-h: flick.content-height;
        scrolled: flick.content-y;
    }
}

// A text file: monospace, read-only, a line-number gutter, only the rows in view are drawn.
component TextView inherits Rectangle {
    in property <[string]> lines;
    in property <int> max-cols;
    in property <string> foot;   // "" or a note under the text (the file was cut)
    // Wrapped rows: the line number of each row (0 on a continuation row); empty when the rows are the lines.
    in property <[int]> nums;
    // The rows are wrapped to the width (no horizontal scroll), and how many lines the file has.
    in property <bool> wrapped;
    // The columns the shown rows were wrapped to (0 while unwrapped). While a splitter drag narrows the slot the rows
    // keep these columns, so the view stays as wide as they need (a temporary sideways scroll) instead of cutting them.
    in property <int> wrapped-cols;
    in property <int> number-count;
    // The selection the controller holds, as rows and columns: from column `sel-a-col` of row `sel-a-row` to column
    // `sel-b-col` of row `sel-b-row` (not included); the rows between are drawn whole.
    in property <bool> sel-on;
    in property <int> sel-a-row;
    in property <int> sel-a-col;
    in property <int> sel-b-row;
    in property <int> sel-b-col;
    callback pressed();
    // The left button went down, moved while held and went up over the text, in the content's own coordinates (the
    // controller works out the row and the character, and drives the scroll past an edge).
    callback text-down(length, length, bool);
    callback text-move(length, length);
    callback text-up();

    out property <length> row-h: Px.snap(18px);
    out property <length> foot-h: root.foot == "" ? 0px : Px.snap(22px);
    out property <length> view-h: root.height - root.foot-h;
    out property <int> line-count: root.lines.length;
    out property <length> content-h: root.line-count * root.row-h;
    out property <length> char-w: probe.preferred-width;
    property <int> numbered: root.number-count > 0 ? root.number-count : root.line-count;
    property <int> digits: root.numbered >= 100000 ? 6 : (root.numbered >= 10000 ? 5 : (root.numbered >= 1000 ? 4 : 3));
    out property <length> gutter-w: Px.snap(root.digits * root.char-w + 20px);
    // The columns that fit beside the gutter, for the controller to wrap to. The thumb's strip and a little air are
    // kept clear so a full row never runs under the scrollbar.
    out property <int> wrap-cols: root.char-w <= 0px ? 0 : max(8, floor((root.width - root.gutter-w - Px.snap(16px)) / root.char-w));
    property <int> first: max(0, floor(-flick.content-y / root.row-h + 0.01));
    property <int> count: ceil(root.view-h / root.row-h) + 2;
    out property <int> first-line: root.first;
    out property <length> content-w: flick.content-width;
    out property <length> scroll-x: flick.content-x;
    out property <length> scroll-y: flick.content-y;

    public function scroll-by(dx: length, dy: length) {
        flick.content-x = min(0px, max(root.width - flick.content-width, flick.content-x + dx));
        flick.content-y = min(0px, max(root.view-h - flick.content-height, flick.content-y + dy));
    }
    public function scroll-to(top: bool) {
        flick.content-y = top ? 0px : min(0px, root.view-h - flick.content-height);
    }
    // Puts `row` at the top (kept inside the content), for a re-wrap that keeps the reader's line.
    public function scroll-to-row(row: int) {
        flick.content-y = min(0px, max(root.view-h - flick.content-height, -row * root.row-h));
    }
    // Scrolls just enough to show column `col` of row `row` (the end of a selection a key moved).
    public function reveal(row: int, col: int) {
        if (row * root.row-h < -flick.content-y) {
            flick.content-y = min(0px, -row * root.row-h);
        } else if ((row + 1) * root.row-h > -flick.content-y + root.view-h) {
            flick.content-y = max(root.view-h - flick.content-height, root.view-h - (row + 1) * root.row-h);
        }
        if (col * root.char-w < -flick.content-x) {
            flick.content-x = min(0px, -col * root.char-w);
        } else if (root.gutter-w + (col + 1) * root.char-w > -flick.content-x + root.width - Px.snap(16px)) {
            flick.content-x = max(root.width - flick.content-width, root.width - Px.snap(16px) - root.gutter-w - (col + 1) * root.char-w);
        }
    }
    // Wrapping flips: every row starts at the left edge again.
    changed wrapped => {
        flick.content-x = 0px;
    }
    // The rows were re-made at another width: the viewport stays inside the new content.
    changed wrapped-cols => {
        flick.content-x = min(0px, max(root.width - flick.content-width, flick.content-x));
    }
    changed line-count => {
        flick.content-y = min(0px, max(root.view-h - flick.content-height, flick.content-y));
    }

    clip: true;
    // Measures one character; never drawn.
    probe := Text {
        visible: false;
        text: "M";
        font-family: SettingsFixed.font-mono;
        font-size: 12px;
    }
    flick := Flickable {
        width: root.width;
        height: root.view-h;
        // A drag with the mouse selects; the wheel, the keys and the scrollbar scroll (a wheel scrolls whatever this
        // says). A touch still pans.
        mouse-drag-pan-enabled: false;
        content-width: root.wrapped ? max(root.width, root.gutter-w + root.wrapped-cols * root.char-w + Px.snap(16px)) : max(root.width, root.gutter-w + (root.max-cols + 2) * root.char-w);
        content-height: max(root.content-h, root.view-h);
        for k in root.count: Rectangle {
            property <int> n: root.first + k;
            // The row's share of the selection, and whether a line ends on it (its break is drawn as half a column).
            property <bool> in-sel: root.sel-on && self.n >= root.sel-a-row && self.n <= root.sel-b-row;
            property <bool> ends-line: root.nums.length == 0 || self.n + 1 >= root.nums.length || root.nums[self.n + 1] > 0;
            property <length> sel-x0: self.n == root.sel-a-row ? root.sel-a-col * root.char-w : 0px;
            property <length> sel-x1: self.n == root.sel-b-row ? root.sel-b-col * root.char-w : max(row-text.preferred-width, self.sel-x0) + (self.ends-line ? root.char-w / 2 : 0px);
            y: self.n * root.row-h;
            height: root.row-h;
            width: flick.content-width;
            visible: self.n < root.line-count;
            Rectangle {
                x: root.gutter-w + parent.sel-x0;
                width: max(0px, parent.sel-x1 - parent.sel-x0);
                height: parent.height;
                visible: parent.in-sel && parent.sel-x1 > parent.sel-x0;
                background: SettingsInk.selection;
            }
            Text {
                x: 0px;
                width: root.gutter-w - 10px;
                height: parent.height;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.nums.length == 0 ? "" + (parent.n + 1) : (parent.n < root.nums.length && root.nums[parent.n] > 0 ? "" + root.nums[parent.n] : "");
                font-family: SettingsFixed.font-mono;
                font-size: 12px;
                color: Theme.dim2;
            }
            row-text := Text {
                x: root.gutter-w;
                height: parent.height;
                vertical-alignment: center;
                text: root.lines[parent.n];
                wrap: no-wrap;
                font-family: SettingsFixed.font-mono;
                font-size: 12px;
                color: Theme.text;
            }
        }
        TouchArea {
            width: flick.content-width;
            height: flick.content-height;
            mouse-cursor: MouseCursor.text;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.pressed();
                    if (e.button == PointerEventButton.left) {
                        root.text-down(self.mouse-x, self.mouse-y, e.modifiers.shift);
                    }
                }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    root.text-up();
                }
            }
            moved => {
                if (self.pressed) {
                    root.text-move(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
    PanelThumb {
        x: root.width - self.width;
        y: 0px;
        view-h: root.view-h;
        content-h: flick.content-height;
        scrolled: flick.content-y;
    }
    if root.foot != "": Rectangle {
        y: root.view-h;
        width: root.width;
        height: root.foot-h;
        background: Theme.side-flat;
        Rectangle {
            width: parent.width;
            height: Px.hair();
            background: Theme.divider;
        }
        Text {
            x: Px.snap(10px);
            width: parent.width - Px.snap(20px);
            height: parent.height;
            vertical-alignment: center;
            text: root.foot;
            font-family: Theme.font-ui;
            font-size: 11.5px;
            color: Theme.dim;
            overflow: elide;
        }
    }
}


// One of the browser bar's buttons: a 24 px square with a 12 px glyph, dimmed when it cannot act.
component WebButton inherits Rectangle {
    in property <string> path;
    in property <string> label;
    in property <bool> live: true;
    // A toggle that is on (the header's wrap button): a resting fill and the full ink.
    in property <bool> on: false;
    callback activated();
    width: Px.snap(24px);
    height: Px.snap(24px);
    border-radius: Theme.radius-button;
    background: root.live && ta.has-hover ? (root.on ? Theme.hover-hi : Theme.hover) : (root.on ? Theme.hover : transparent);
    opacity: root.live ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.live) { root.activated(); } }
    Path {
        x: (parent.width - 12px) / 2 - self.stroke-width / 2;
        y: (parent.height - 12px) / 2 - self.stroke-width / 2;
        width: 12px + self.stroke-width;
        height: 12px + self.stroke-width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.path;
        fill: transparent;
        stroke: root.live && (ta.has-hover || root.on) ? Theme.text : Theme.icon;
        stroke-width: 2.2 * 12px / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea {
        enabled: root.live;
        clicked => { root.activated(); }
    }
}

// The view control over a markdown file (2026-11-10): Compiled, Markdown or Code, the one on show pressed. Flare's own
// chrome in the header, drawn outside the page. Shorter words when the panel is narrow.
component MdViewSwitch inherits Rectangle {
    in property <int> current;
    in property <bool> compact;
    callback picked(int);
    property <[string]> names: root.compact ? ["Doc", "Md", "Code"] : ["Compiled", "Markdown", "Code"];
    property <[string]> labels: ["Show compiled", "Show the markdown", "Show as code"];
    width: lay.preferred-width;
    height: Px.snap(22px);
    border-radius: Theme.radius-button;
    border-width: Px.hair();
    border-color: Theme.divider;
    lay := HorizontalLayout {
        padding: Px.hair();
        spacing: 0px;
        for name[i] in root.names: Rectangle {
            width: Px.snap(word.preferred-width + 14px);
            border-radius: Theme.radius-button;
            background: i == root.current ? Theme.hover-hi : (ta.has-hover ? Theme.hover : transparent);
            accessible-role: button;
            accessible-label: root.labels[i];
            accessible-checkable: true;
            accessible-checked: i == root.current;
            accessible-action-default => { root.picked(i); }
            word := Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: name;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: i == root.current || ta.has-hover ? Theme.text : Theme.dim;
            }
            ta := TouchArea {
                clicked => { root.picked(i); }
            }
        }
    }
}

// The browser bar of a web panel: back, forward, reload (stop while a page loads), the address and the
// panel's close. It is the top of the panel (a web page has no header, Max 2026-10-27). Enter opens what
// is typed, Escape puts the address of the page back and hands the keys to the terminal.
component WebBar inherits Rectangle {
    in property <string> url;
    // Why the last thing asked of the page did not happen (the header's line on other panels), dim at the
    // field's right end.
    in property <string> notice;
    in property <bool> loading;
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <string> draft;
    out property <bool> input-has-focus: input.has-focus;
    out property <length> field-x: field.absolute-position.x;
    out property <length> field-y: field.absolute-position.y;
    out property <length> field-w: field.width;
    out property <length> field-h: field.height;
    callback back();
    callback forward();
    callback reload();
    callback stop();
    callback submit(string);
    callback escape();
    callback close();
    // "Draw arrow", left of the close button (rule 256): pressed while the person draws. The address field gives up
    // only its room (rule 1267: no "Ask agent" button beside it any more).
    in property <bool> draw-shown;
    in property <bool> draw-active;
    callback draw-arrow();
    out property <length> draw-x: draw-btn.absolute-position.x;
    out property <length> draw-y: draw-btn.absolute-position.y;
    out property <length> draw-w: draw-btn.width;
    out property <length> close-x: close-btn.absolute-position.x;
    out property <length> close-w: close-btn.width;
    public function focus-address() { input.focus(); input.select-all(); }

    // The field shows the address of the page unless it is being typed in.
    changed url => {
        if (!input.has-focus) {
            root.draft = root.url;
        }
    }
    init => { root.draft = root.url; }

    background: Theme.tabs;
    WebButton {
        x: Px.snap(8px);
        y: (parent.height - self.height) / 2;
        path: Glyphs.chevron-left;
        label: "Back";
        live: root.can-back;
        activated => { root.back(); }
    }
    WebButton {
        x: Px.snap(8px + 24px + 2px);
        y: (parent.height - self.height) / 2;
        path: Glyphs.chevron-right;
        label: "Forward";
        live: root.can-forward;
        activated => { root.forward(); }
    }
    WebButton {
        x: Px.snap(8px + 2 * (24px + 2px));
        y: (parent.height - self.height) / 2;
        path: root.loading ? Glyphs.close : Glyphs.reload;
        label: root.loading ? "Stop loading" : "Reload";
        activated => { if (root.loading) { root.stop(); } else { root.reload(); } }
    }
    field := Rectangle {
        x: Px.snap(8px + 3 * (24px + 2px) + 4px);
        y: (parent.height - self.height) / 2;
        width: (root.draw-shown ? draw-btn.x : close-btn.x) - self.x - Px.snap(4px);
        height: Px.snap(24px);
        background: Theme.ground;
        border-radius: Theme.radius-sm;
        border-width: Px.hair();
        border-color: input.has-focus ? Theme.dim : Theme.divider;
        clip: true;
        notice-text := Text {
            x: parent.width - Px.snap(8px) - self.width;
            width: root.notice == "" ? 0px : min(self.preferred-width, Px.snap(parent.width * 0.5));
            height: parent.height;
            visible: root.notice != "";
            vertical-alignment: center;
            text: root.notice;
            font-family: Theme.font-ui;
            font-size: 11.5px;
            color: Theme.dim;
            overflow: elide;
        }
        FocusScope {
            x: Px.snap(8px);
            width: parent.width - Px.snap(16px) - (root.notice == "" ? 0px : notice-text.width + Px.snap(8px));
            height: parent.height;
            capture-key-pressed(event) => {
                if (event.text == Key.Return) {
                    root.submit(input.text);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.draft = root.url;
                    root.escape();
                    return accept;
                }
                reject
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.draft;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accessible-role: text-input;
                accessible-label: "Address";
                changed has-focus => {
                    if (self.has-focus) {
                        self.select-all();
                    } else {
                        root.draft = root.url;
                    }
                }
            }
            if input.text == "" : Text {
                width: parent.width;
                height: parent.height;
                text: "Type an address";
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.dim2;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    draw-btn := WebButton {
        x: close-btn.x - Px.snap(4px) - self.width;
        y: (parent.height - self.height) / 2;
        visible: root.draw-shown;
        path: Glyphs.point-arrow;
        label: root.draw-active ? "Stop drawing the arrow" : "Draw arrow";
        on: root.draw-active;
        activated => { root.draw-arrow(); }
    }
    close-btn := WebButton {
        x: parent.width - self.width - Px.snap(8px);
        y: (parent.height - self.height) / 2;
        path: Glyphs.close;
        label: "Close panel";
        activated => { root.close(); }
    }
    Rectangle {
        y: parent.height - Px.hair();
        width: parent.width;
        height: Px.hair();
        background: Theme.divider;
    }
}

// The strip over a pop-up (rule 249): Flare's own chrome, drawn outside the page so a page cannot fake it, naming the
// site the pop-up came from (never the page's title), with a Close button. The pop-up sits under it.
component PopupStrip inherits Rectangle {
    in property <string> text;
    callback close();
    background: Theme.tabs;
    Text {
        x: Px.snap(12px);
        width: close-btn.x - self.x - Px.snap(8px);
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-family: Theme.font-ui;
        font-size: 12px;
        color: Theme.text;
        overflow: elide;
    }
    close-btn := Rectangle {
        x: parent.width - self.width - Px.snap(8px);
        y: (parent.height - self.height) / 2;
        width: Px.snap(close-text.preferred-width + 20px);
        height: Px.snap(22px);
        border-radius: Theme.radius-button;
        border-width: Px.hair();
        border-color: Theme.divider;
        background: close-ta.has-hover ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: "Close pop-up";
        accessible-action-default => { root.close(); }
        close-text := Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "Close";
            font-family: Theme.font-ui;
            font-size: 12px;
            color: Theme.text;
        }
        close-ta := TouchArea {
            clicked => { root.close(); }
        }
    }
    Rectangle {
        y: parent.height - Px.hair();
        width: parent.width;
        height: Px.hair();
        background: Theme.divider;
    }
}

// What the slot shows while there is no picture or text: a note in the middle (reading, or why not).
component PanelNote inherits Rectangle {
    in property <string> text;
    Text {
        x: Px.snap(16px);
        width: parent.width - Px.snap(32px);
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        text: root.text;
        font-family: Theme.font-ui;
        font-size: 12.5px;
        color: Theme.dim;
    }
}

// One device of the device panel's list (kind 5, state 2): its name, its system and whether it runs now.
export struct DeviceRow {
    name: string,
    os: string,
    booted: bool,
}

// One point of the agent's swipe trail over the device picture (rule 1321): device points and its opacity.
export struct DeviceTrailPoint {
    x: float,
    y: float,
    a: float,
}

// A row of the device panel's More menu (Shake, Volume, Choose device, Shut down).
component DeviceMenuRow inherits Rectangle {
    in property <string> text;
    callback activated();
    height: Px.snap(28px);
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.activated(); }
    Text {
        x: Px.snap(12px);
        width: parent.width - Px.snap(24px);
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-family: Theme.font-ui;
        font-size: 12.5px;
        color: Theme.side-text;
        overflow: elide;
    }
    ta := TouchArea {
        clicked => { root.activated(); }
    }
}

export component PanelSlot inherits Rectangle {
    // The slot is drawn only while open. Everything else is set by app.slint from the controller.
    in property <bool> open;
    // 0 nothing yet (a note), 1 image, 2 text, 3 a web page (the browser's own window covers the box),
    // 4 the Changes of the conversation (stage 6), 5 a device (a phone simulator, issue 248).
    in property <int> kind;
    in property <string> title;
    in property <string> sub;
    in property <string> note;
    in property <image> picture;
    in property <image> checker;
    in property <bool> has-alpha;
    in-out property <bool> actual;
    in property <[string]> lines;
    in property <int> max-cols;
    in property <string> foot;
    // The conversation (kind 4): the changed files and the selected file's diff rows.
    in property <[ConvoFileRow]> convo-files;
    in property <[ConvoDiffRow]> convo-rows;
    in property <int> convo-max-cols;
    in property <string> convo-selected;
    public function convo-reset-scroll() {
        changes.reset-scroll();
    }
    out property <int> convo-list-built: changes.list-built;
    out property <int> convo-list-first: changes.list-first;
    out property <int> convo-diff-built: changes.diff-built;
    out property <int> convo-diff-first: changes.diff-first;
    out property <length> convo-diff-row-h: changes.diff-row-h;
    out property <length> convo-list-row-h: changes.list-row-h;
    callback convo-select(string);
    callback convo-open(string);
    // A web page (kind 3): the bar, and the still drawn while an overlay hides the browser window.
    in property <string> web-url;
    // A mini-app: no bar (the address is Flare's own and the page cannot navigate).
    in property <bool> web-app;
    in property <bool> web-loading;
    in property <bool> web-can-back;
    in property <bool> web-can-forward;
    in property <image> web-still;
    in property <bool> web-has-still;
    in property <bool> web-missing-runtime;
    // macOS (CEF, port phase 5): the page is a picture Flare draws here, and the pointer, the wheel and the keys over
    // it are handed to the browser. Off (Windows): the page is a window of its own above this box.
    in property <image> web-frame;
    in property <bool> web-live;
    // kind: 0 down, 1 up, 2 move, 3 leave; button: 0 left, 1 middle, 2 right; mods: 1 shift, 2 ctrl, 4 alt, 8 cmd.
    callback web-pointer(int, length, length, int, int);
    callback web-wheel(length, length, length, length, int);
    callback web-key(bool, string, int, bool);
    public function focus-page() { page-keys.focus(); }
    public function focus-page-find() { page-find.focus-input(); }
    // macOS: the page's own scope has the keys (the window then leaves every key to it; the key filter hands the
    // app's chords back), and the pointer is over the page (the zoom keys zoom the page then).
    out property <bool> web-page-focused: root.web-live && page-keys.has-focus;
    property <bool> page-hover;
    out property <bool> web-hovered: root.web-live && root.page-hover;
    // macOS: Flare's find bar over the page (WebView2 has its own), and the page's status text (a link's address
    // under the pointer) at the page's bottom left, where WebView2 draws its status bar.
    in property <bool> web-find-open;
    in-out property <string> web-find-query;
    in property <string> web-find-readout;
    in property <bool> web-find-can-step;
    out property <bool> web-find-focused: root.open && page-find.input-has-focus;
    callback web-find-edited(string);
    callback web-find-next();
    callback web-find-previous();
    callback web-find-close();
    in property <string> web-status;
    // A web page (not a mini-app) has no header: the bar is its head, and the page starts under it (Max
    // 2026-10-27: more room for the page). An agent at work shows only in the page's edge glow and its
    // cursor; the page title stays the tab's and `web.state`'s.
    property <bool> bar-only: root.kind == 3 && !root.web-app;
    out property <length> bar-h: root.bar-only ? Px.snap(32px) : 0px;
    // A pop-up over the page (rule 249): the strip's words ("Pop-up from <site>"), empty while none is open. The
    // strip takes its height from the page's box, so the pop-up's view sits under it.
    in property <string> web-popup;
    out property <length> popup-h: root.bar-only && root.web-popup != "" ? Px.snap(30px) : 0px;
    callback web-popup-close();
    out property <length> web-x: web-box.absolute-position.x;
    out property <length> web-y: web-box.absolute-position.y;
    out property <length> web-w: web-box.width;
    out property <length> web-h: web-box.height;
    out property <bool> web-input-focused: root.open && web-bar.input-has-focus;
    out property <length> web-field-x: web-bar.field-x;
    out property <length> web-field-w: web-bar.field-w;
    out property <string> web-draft: web-bar.draft;
    out property <length> web-close-x: web-bar.close-x;
    out property <length> web-close-w: web-bar.close-w;
    callback web-back();
    callback web-forward();
    callback web-reload();
    callback web-stop();
    callback web-submit(string);
    callback web-download();
    public function focus-address() { web-bar.focus-address(); }

    // The device panel (kind 5, issue 248, mockup A of 2026-11-19): the device's screen bare with its corner
    // radius, letterboxed to its aspect, and the person's pointer, wheel and keys over it handed to the controller
    // (`device_ctl.rs`), which maps them to device points. Nothing here moves on its own: the booting line's seconds
    // come from the controller.
    in property <image> device-frame;
    in property <bool> device-has-frame;
    // The screen in device points in its current orientation (0 while unknown), and its corner radius in points.
    in property <float> device-pt-w;
    in property <float> device-pt-h;
    in property <float> device-radius-pt;
    // The ring's picture is portrait (the framebuffer never turns, spike S5): Slint turns it clockwise by this many
    // degrees for the interface's orientation. A CPU picture comes already turned (0).
    in property <int> device-turn;
    // 0 the picture, 1 one line and at most one button (a setup state, rule 1318), 2 the device list, 3 booting.
    in property <int> device-state;
    in property <string> device-line;
    in property <string> device-button;
    // The licence screen (Android setup, spec "Setup", 2): a second button, [Cancel], and Google's licence text under
    // the line, in a box that scrolls.
    in property <bool> device-has-cancel;
    in property <string> device-detail;
    // An Android device is on show: its More menu has Back and Recents instead of Shake (rule 1371).
    in property <bool> device-android;
    in property <[DeviceRow]> device-rows;
    // Still pictures: the line under the badge ("" while live). The slow mark: why the view is slow ("" none).
    in property <string> device-still;
    in property <string> device-slow;
    // A line along the bottom of the picture: "Connecting touch...", "Driven from <tab>. View only here."
    in property <string> device-foot;
    // The header's device buttons (a device the tab drives is on show).
    in property <bool> device-controls;
    // The agent's touch indicators over the picture (rule 1321, device panel PR 5), pushed by the controller on its
    // tick (nothing here moves on its own): the finger dot in device points with its opacity, its ripples (each one's
    // progress 0 to 1), a long press's filled dot, the agent's name beside it, the swipe trail, the keyboard badge
    // and the edge glow's opacity (0 for none). Drawn by Slint over the picture, so never in `device_look`.
    in property <bool> device-dot;
    in property <float> device-dot-x;
    in property <float> device-dot-y;
    in property <float> device-dot-alpha;
    in property <bool> device-dot-held;
    in property <[float]> device-ripples;
    in property <string> device-tag;
    in property <[DeviceTrailPoint]> device-trail;
    in property <string> device-badge;
    in property <float> device-glow;
    // Where the dot's middle and the badge are drawn in the window (the tests and the e2e read them).
    out property <length> device-dot-wx: device-box.absolute-position.x + (device-box.width - root.device-pic-w) / 2 + root.device-dot-x * root.device-fit * 1px;
    out property <length> device-dot-wy: device-box.absolute-position.y + (device-box.height - root.device-pic-h) / 2 + root.device-dot-y * root.device-fit * 1px;
    out property <bool> device-badge-shown: root.open && root.kind == 5 && root.device-state == 0 && root.device-badge != "";
    // kind: 0 down, 1 up, 2 move, 3 leave; button: 0 left, 1 middle, 2 right, 3 other; mods: 1 shift, 2 ctrl,
    // 4 alt, 8 cmd. Points are in the device box (`device-box`), the controller letterboxes them.
    callback device-pointer(int, length, length, int, int);
    callback device-wheel(length, length, length, length, int);
    callback device-key(bool, string, int, bool);
    // A header button or a menu row: home, lock, rotate_left, rotate_right, shake, volume_up, volume_down,
    // choose, shutdown.
    callback device-act(string);
    // The setup state's one button (Get Xcode, Open Xcode, Boot, Boot again).
    callback device-setup();
    callback device-cancel();
    callback device-pick(int);
    property <bool> device-menu-open: false;
    out property <bool> device-menu-shown: root.open && root.kind == 5 && root.device-menu-open;
    out property <bool> device-focused: root.open && root.kind == 5 && device-keys.has-focus;
    public function focus-device() { device-keys.focus(); }
    // Where the device box and the letterboxed picture are in the window, for the controller, ui.rect and the tests.
    out property <length> device-x: device-box.absolute-position.x;
    out property <length> device-y: device-box.absolute-position.y;
    out property <length> device-w: device-box.width;
    out property <length> device-h: device-box.height;
    property <float> device-fit: (root.device-pt-w > 0 && root.device-pt-h > 0) ? min(device-box.width / 1px / root.device-pt-w, device-box.height / 1px / root.device-pt-h) : 0;
    out property <length> device-pic-w: root.device-pt-w * root.device-fit * 1px;
    out property <length> device-pic-h: root.device-pt-h * root.device-fit * 1px;
    out property <length> device-pic-x: device-box.absolute-position.x + (device-box.width - root.device-pic-w) / 2;
    out property <length> device-pic-y: device-box.absolute-position.y + (device-box.height - root.device-pic-h) / 2;
    out property <length> device-button-x: device-setup-btn.absolute-position.x;
    out property <length> device-button-y: device-setup-btn.absolute-position.y;
    out property <length> device-button-w: device-setup-btn.width;
    out property <length> device-button-h: device-setup-btn.height;
    out property <bool> device-button-shown: root.open && root.kind == 5 && (root.device-state == 1 || root.device-state == 3) && root.device-button != "";
    out property <bool> device-slow-shown: root.open && root.kind == 5 && root.device-slow != "";
    out property <bool> device-still-shown: root.open && root.kind == 5 && root.device-still != "";
    out property <bool> device-controls-shown: root.open && root.kind == 5 && root.device-controls;
    out property <length> device-rotate-x: device-rotr-btn.absolute-position.x;
    out property <length> device-home-x: device-home-btn.absolute-position.x;
    out property <length> device-head-y: device-home-btn.absolute-position.y;

    // The panel's own pieces in the window, for ui.rect and the tests.
    out property <length> header-h: root.bar-only ? 0px : Px.snap(32px);
    out property <length> body-x: body.absolute-position.x;
    out property <length> body-y: body.absolute-position.y;
    out property <length> body-w: body.width;
    out property <length> body-h: body.height;
    out property <length> image-x: img.image-x;
    out property <length> image-y: img.image-y;
    out property <length> image-w: img.shown-w;
    out property <length> image-h: img.shown-h;
    out property <bool> image-zoomed: img.zoomed;
    out property <bool> image-can-zoom: img.can-zoom;
    out property <length> text-gutter-w: txt.gutter-w;
    out property <int> text-first-line: txt.first-line;
    out property <int> text-wrap-cols: txt.wrap-cols;
    out property <length> text-content-w: txt.content-w;
    out property <length> text-scroll-x: txt.scroll-x;
    out property <length> text-scroll-y: txt.scroll-y;
    public function text-scroll-to-row(row: int) { txt.scroll-to-row(row); }
    public function text-scroll-by(dx: length, dy: length) { txt.scroll-by(dx, dy); }
    public function text-reveal(row: int, col: int) { txt.reveal(row, col); }
    // What the controller needs to turn a point of the text into a row and a character.
    out property <length> text-char-w: txt.char-w;
    out property <length> text-row-h: txt.row-h;
    out property <length> text-view-h: txt.view-h;
    // The selection to draw (`TextView`), and the pointer over the text.
    in property <bool> sel-on;
    in property <int> sel-a-row;
    in property <int> sel-a-col;
    in property <int> sel-b-row;
    in property <int> sel-b-col;
    callback text-down(length, length, bool);
    callback text-move(length, length);
    callback text-up();
    out property <length> wrap-button-x: wrap-btn.absolute-position.x;
    out property <length> wrap-button-y: wrap-btn.absolute-position.y;
    out property <length> wrap-button-w: wrap-btn.width;
    // The slot holds the keys (the controller moves them here on a click or the focus chord).
    out property <bool> has-focus: root.open && (keys.has-focus || (root.kind == 5 && device-keys.has-focus));

    // The header's wrap button (a text file): the setting, and a press to flip it. `wrapped` says the rows are wrapped now.
    in property <bool> wrap-on;
    in property <bool> wrapped;
    in property <int> wrapped-cols;
    in property <[int]> line-nums;
    in property <int> number-count;
    // "Draw arrow" (rule 256): a web page or a mini-app of a tab with an agent (the window says), gone when the panel is
    // too narrow for it. There is no "Ask agent" button (rule 1267): what the person marks reaches a Claude agent
    // quietly (rule 1268).
    in property <bool> draw-on;
    in property <bool> draw-active;
    callback draw-arrow();
    property <bool> draw-shown: root.draw-on && root.kind == 3 && root.width >= 200px;
    out property <bool> draw-visible: root.open && root.draw-shown;
    out property <length> draw-x: root.bar-only ? web-bar.draw-x : head-draw-btn.absolute-position.x;
    out property <length> draw-y: root.bar-only ? web-bar.draw-y : head-draw-btn.absolute-position.y;
    out property <length> draw-w: root.bar-only ? web-bar.draw-w : head-draw-btn.width;
    // The view control (a markdown file, in any of its views): Compiled 0, Markdown 1, Code 2, and a pick.
    in property <bool> md-file;
    in property <int> md-view;
    callback md-view-picked(int);
    out property <bool> md-visible: root.open && root.md-file && !root.bar-only;
    out property <length> md-x: md-switch.absolute-position.x;
    out property <length> md-y: md-switch.absolute-position.y;
    out property <length> md-w: md-switch.width;
    // The room the wrap button takes in the header (a text file only), and with "Draw arrow" and the view control beside it.
    property <length> head-wrap: root.kind == 2 ? Px.snap(28px) : 0px;
    property <length> head-md: root.md-file ? md-switch.width + Px.snap(6px) : 0px;
    property <length> head-draw: root.draw-shown ? Px.snap(24px + 4px) : 0px;
    // The device's buttons (Home, Lock, Rotate left, Rotate right, More, each 24 px with 2 px between, and the
    // rule before the close) and the slow mark.
    property <length> head-device: root.kind == 5 && root.device-controls ? 5 * Px.snap(24px) + 4 * Px.snap(2px) + Px.snap(10px) : 0px;
    property <length> head-slow: root.kind == 5 && root.device-slow != "" ? slow-mark.width + Px.snap(6px) : 0px;
    property <length> head-extra: root.head-wrap + root.head-draw + root.head-md + root.head-device + root.head-slow;
    callback wrap-toggled();
    callback close();
    callback escape();
    callback pressed();
    public function focus-panel() { keys.focus(); }

    background: transparent;

    // Zero-sized: it never takes a pointer; the keys of the panel come here once it has the focus.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            if (root.kind == 2) {
                if (event.text == Key.UpArrow) { txt.scroll-by(0px, txt.row-h); return accept; }
                if (event.text == Key.DownArrow) { txt.scroll-by(0px, -txt.row-h); return accept; }
                if (event.text == Key.PageUp) { txt.scroll-by(0px, txt.view-h - txt.row-h); return accept; }
                if (event.text == Key.PageDown) { txt.scroll-by(0px, -(txt.view-h - txt.row-h)); return accept; }
                if (event.text == Key.Home) { txt.scroll-to(true); return accept; }
                if (event.text == Key.End) { txt.scroll-to(false); return accept; }
                if (event.text == Key.LeftArrow) { txt.scroll-by(Px.snap(24px), 0px); return accept; }
                if (event.text == Key.RightArrow) { txt.scroll-by(-Px.snap(24px), 0px); return accept; }
            }
            if (root.kind == 4) {
                if (event.text == Key.UpArrow) { changes.scroll-by(0px, changes.diff-row-h); return accept; }
                if (event.text == Key.DownArrow) { changes.scroll-by(0px, -changes.diff-row-h); return accept; }
                if (event.text == Key.PageUp) { changes.scroll-by(0px, changes.page()); return accept; }
                if (event.text == Key.PageDown) { changes.scroll-by(0px, -changes.page()); return accept; }
                if (event.text == Key.Home) { changes.scroll-to(true); return accept; }
                if (event.text == Key.End) { changes.scroll-to(false); return accept; }
                if (event.text == Key.LeftArrow && changes.in-diff) { changes.scroll-by(Px.snap(24px), 0px); return accept; }
                if (event.text == Key.RightArrow && changes.in-diff) { changes.scroll-by(-Px.snap(24px), 0px); return accept; }
                if (event.text == Key.Backspace && changes.in-diff) { changes.back(); return accept; }
            }
            if (root.kind == 1) {
                if (event.text == Key.UpArrow) { img.scroll-by(0px, Px.snap(24px)); return accept; }
                if (event.text == Key.DownArrow) { img.scroll-by(0px, -Px.snap(24px)); return accept; }
                if (event.text == Key.LeftArrow) { img.scroll-by(Px.snap(24px), 0px); return accept; }
                if (event.text == Key.RightArrow) { img.scroll-by(-Px.snap(24px), 0px); return accept; }
                if (event.text == " " || event.text == "\n") { img.toggle(); return accept; }
            }
            return reject;
        }
    }

    // Everything below is always in the tree and drawn only while open; the controller keeps the
    // picture and the rows empty while the slot is closed or shows the other kind.
    Rectangle {
        visible: root.open;
        width: root.width;
        height: root.height;
        clip: true;
        background: Theme.ground;
        // A click anywhere in the slot, on the header or beside a picture, gives it the keys.
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.pressed();
                }
            }
        }
        // The header (none on a web page: its bar holds the close).
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-h;
            visible: !root.bar-only;
            background: Theme.tabs;
            Text {
                x: Px.snap(12px);
                width: parent.width - Px.snap(12px) - Px.snap(8px) - close-btn.width - Px.snap(8px) - root.head-extra - (root.sub == "" ? 0px : Px.snap(sub-text.preferred-width + 10px));
                height: parent.height;
                vertical-alignment: center;
                text: root.title;
                font-family: Theme.font-ui;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            sub-text := Text {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(8px) - root.head-extra - self.preferred-width;
                height: parent.height;
                vertical-alignment: center;
                visible: root.sub != "";
                text: root.sub;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: Theme.dim;
            }
            // The wrap button sits left of the close button, on a text file only.
            wrap-btn := WebButton {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(4px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 2;
                path: Glyphs.wrap;
                label: root.wrap-on ? "Wrap long lines: on" : "Wrap long lines: off";
                on: root.wrap-on;
                activated => { root.wrap-toggled(); }
            }
            head-draw-btn := WebButton {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(4px) - root.head-wrap - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.draw-shown;
                path: Glyphs.point-arrow;
                label: root.draw-active ? "Stop drawing the arrow" : "Draw arrow";
                on: root.draw-active;
                activated => { root.draw-arrow(); }
            }
            md-switch := MdViewSwitch {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(4px) - root.head-wrap - root.head-draw - Px.snap(2px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.md-file;
                current: root.md-view;
                compact: root.width < 460px;
                picked(i) => { root.md-view-picked(i); }
            }
            // The device's buttons, right to left from the close: a rule, More, Rotate right, Rotate left, Lock, Home.
            Rectangle {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(6px);
                y: (parent.height - self.height) / 2;
                width: Px.hair();
                height: Px.snap(14px);
                visible: root.kind == 5 && root.device-controls;
                background: Theme.divider;
            }
            device-more-btn := WebButton {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(10px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 5 && root.device-controls;
                path: Glyphs.device-more;
                label: "More";
                on: root.device-menu-open;
                activated => { root.device-menu-open = !root.device-menu-open; }
            }
            device-rotr-btn := WebButton {
                x: device-more-btn.x - Px.snap(2px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 5 && root.device-controls;
                path: Glyphs.device-rotate-right;
                label: "Rotate right";
                activated => { root.device-act("rotate_right"); }
            }
            device-rotl-btn := WebButton {
                x: device-rotr-btn.x - Px.snap(2px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 5 && root.device-controls;
                path: Glyphs.device-rotate-left;
                label: "Rotate left";
                activated => { root.device-act("rotate_left"); }
            }
            device-lock-btn := WebButton {
                x: device-rotl-btn.x - Px.snap(2px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 5 && root.device-controls;
                path: Glyphs.badge-lock;
                label: "Lock";
                activated => { root.device-act("lock"); }
            }
            device-home-btn := WebButton {
                x: device-lock-btn.x - Px.snap(2px) - self.width;
                y: (parent.height - self.height) / 2;
                visible: root.kind == 5 && root.device-controls;
                path: Glyphs.home;
                label: "Home";
                activated => { root.device-act("home"); }
            }
            // The slow mark (the CPU path): a small word, its reason under it while the pointer rests on it.
            slow-mark := Rectangle {
                x: parent.width - close-btn.width - Px.snap(8px) - Px.snap(4px) - root.head-device - self.width;
                y: (parent.height - self.height) / 2;
                width: Px.snap(slow-text.preferred-width + 10px);
                height: Px.snap(17px);
                visible: root.kind == 5 && root.device-slow != "";
                border-radius: Theme.radius-button;
                border-width: Px.hair();
                border-color: Theme.widget-warn.with-alpha(0.35);
                accessible-role: text;
                accessible-label: "Slow view: " + root.device-slow;
                slow-text := Text {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "slow";
                    font-family: Theme.font-ui;
                    font-size: 10.5px;
                    color: Theme.widget-warn;
                }
                slow-ta := TouchArea {}
            }
            close-btn := PanelClose {
                x: parent.width - self.width - Px.snap(8px);
                y: (parent.height - self.height) / 2;
                clicked => { root.close(); }
            }
            Rectangle {
                y: parent.height - Px.hair();
                width: parent.width;
                height: Px.hair();
                background: Theme.divider;
            }
        }
        web-bar := WebBar {
            x: 0px;
            y: root.header-h;
            width: parent.width;
            height: root.bar-h;
            visible: root.bar-only;
            url: root.web-url;
            notice: root.sub;
            draw-shown: root.draw-shown;
            draw-active: root.draw-active;
            draw-arrow => { root.draw-arrow(); }
            loading: root.web-loading;
            can-back: root.web-can-back;
            can-forward: root.web-can-forward;
            back => { root.web-back(); }
            forward => { root.web-forward(); }
            reload => { root.web-reload(); }
            stop => { root.web-stop(); }
            submit(text) => { root.web-submit(text); }
            escape => { root.escape(); }
            close => { root.close(); }
        }
        if root.popup-h > 0px: PopupStrip {
            x: 0px;
            y: root.header-h + root.bar-h;
            width: parent.width;
            height: root.popup-h;
            text: root.web-popup;
            close => { root.web-popup-close(); }
        }
        body := Rectangle {
            x: 0px;
            y: root.header-h + root.bar-h + root.popup-h;
            width: parent.width;
            height: parent.height - root.header-h - root.bar-h - root.popup-h;
            clip: true;
            // Where the browser window sits: the body less half the splitter's grab zone (the zone is centred
            // on the slot's edge, and a child window takes the mouse above anything drawn, so none of it may
            // lie under the page). While an overlay hides the window, a still of its last frame is drawn here.
            web-box := Rectangle {
                x: Px.snap(4px);
                width: parent.width - Px.snap(4px);
                height: parent.height;
                visible: root.kind == 3;
                background: root.web-has-still ? Theme.ground : transparent;
                if root.web-has-still: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.web-still;
                    image-fit: fill;
                }
                // The page's picture at its own width: while the splitter is held the page keeps its width (rule 230)
                // and its edge moves, as WebView2's window does on Windows, so the picture is never stretched across
                // the box and a click lands where it is drawn (rule 1174). A pixel or two off (rounding) still fills.
                if root.web-live && !root.web-has-still: Image {
                    x: 0px;
                    width: abs(root.web-frame.width * 1phx - parent.width) > 2phx ? root.web-frame.width * 1phx : parent.width;
                    height: parent.height;
                    source: root.web-frame;
                    image-fit: fill;
                }
                page-keys := FocusScope {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.web-live;
                    property <int> mods-now: 0;
                    key-pressed(e) => {
                        root.web-key(true, e.text, (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0), e.repeat);
                        accept
                    }
                    key-released(e) => {
                        root.web-key(false, e.text, (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0), false);
                        accept
                    }
                    if root.web-live: TouchArea {
                        width: parent.width;
                        height: parent.height;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                page-keys.focus();
                            }
                            // Buttons: 0 left, 1 middle, 2 right, 3 back, 4 forward, 5 any other.
                            root.web-pointer(
                                e.kind == PointerEventKind.down ? 0 : (e.kind == PointerEventKind.up ? 1 : (e.kind == PointerEventKind.move ? 2 : 3)),
                                self.mouse-x, self.mouse-y,
                                e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.middle ? 1 : (e.button == PointerEventButton.right ? 2 : (e.button == PointerEventButton.back ? 3 : (e.button == PointerEventButton.forward ? 4 : 5)))),
                                (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0));
                        }
                        changed has-hover => {
                            root.page-hover = self.has-hover;
                            if !self.has-hover {
                                root.web-pointer(3, self.mouse-x, self.mouse-y, 0, 0);
                            }
                        }
                        scroll-event(e) => {
                            root.web-wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0));
                            accept
                        }
                    }
                }
                if root.web-live && root.web-status != "": Rectangle {
                    property <length> pad: Px.snap(6px);
                    x: 0px;
                    y: parent.height - self.height;
                    width: min(status-text.preferred-width + 2 * self.pad, parent.width * 2 / 3);
                    height: Px.snap(20px);
                    background: Theme.side-flat;
                    border-width: Px.hair();
                    border-color: Theme.divider;
                    status-text := Text {
                        x: parent.pad;
                        width: parent.width - 2 * parent.pad;
                        height: parent.height;
                        text: root.web-status;
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        color: Theme.dim2;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
                page-find := FindBar {
                    width: parent.width;
                    height: parent.height;
                    visible: root.web-live;
                    placeholder: "Find in page";
                    open: root.web-find-open;
                    query <=> root.web-find-query;
                    readout: root.web-find-readout;
                    can-step: root.web-find-can-step;
                    query-edited(q) => { root.web-find-edited(q); }
                    next => { root.web-find-next(); }
                    previous => { root.web-find-previous(); }
                    close => { root.web-find-close(); }
                }
            }
            device-box := Rectangle {
                x: Px.snap(4px);
                width: parent.width - Px.snap(4px);
                height: parent.height;
                visible: root.kind == 5;
                // The screen: bare, the device's corner radius, letterboxed (no bezel, spec "Non-goals").
                device-pic := Rectangle {
                    x: (parent.width - root.device-pic-w) / 2;
                    y: (parent.height - root.device-pic-h) / 2;
                    width: root.device-pic-w;
                    height: root.device-pic-h;
                    visible: root.device-state == 0 && root.device-has-frame;
                    border-radius: root.device-radius-pt * root.device-fit * 1px;
                    clip: true;
                    background: black;
                    Image {
                        // A quarter turn lays the portrait picture across: its own size is the box's, swapped.
                        property <bool> across: root.device-turn == 90 || root.device-turn == 270;
                        width: self.across ? parent.height : parent.width;
                        height: self.across ? parent.width : parent.height;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        transform-rotation: root.device-turn * 1deg;
                        source: root.device-frame;
                        image-fit: fill;
                    }
                    // The agent's indicators (rule 1321): the trail, the ripples, the finger dot and its name, then
                    // the edge glow. Device points times the fit are window lengths inside the picture.
                    for p in root.device-trail: Rectangle {
                        x: (p.x * root.device-fit - 3) * 1px;
                        y: (p.y * root.device-fit - 3) * 1px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.agent-touch.with-alpha(0.6 * p.a);
                    }
                    for r in root.device-dot ? root.device-ripples : []: Rectangle {
                        property <float> d: (44 + 44 * r) * root.device-fit;
                        x: (root.device-dot-x * root.device-fit - self.d / 2) * 1px;
                        y: (root.device-dot-y * root.device-fit - self.d / 2) * 1px;
                        width: self.d * 1px;
                        height: self.d * 1px;
                        border-radius: self.d / 2 * 1px;
                        border-width: max(1px, 2 * root.device-fit * 1px);
                        border-color: Theme.agent-touch.with-alpha(0.8 * (1 - r) * root.device-dot-alpha);
                    }
                    if root.device-dot: Rectangle {
                        property <float> d: 44 * root.device-fit;
                        x: (root.device-dot-x * root.device-fit - self.d / 2) * 1px;
                        y: (root.device-dot-y * root.device-fit - self.d / 2) * 1px;
                        width: self.d * 1px;
                        height: self.d * 1px;
                        border-radius: self.d / 2 * 1px;
                        background: Theme.agent-touch.with-alpha((root.device-dot-held ? 0.7 : 0.35) * root.device-dot-alpha);
                        border-width: max(1px, 2 * root.device-fit * 1px);
                        border-color: Theme.agent-touch.with-alpha(0.8 * root.device-dot-alpha);
                    }
                    if root.device-dot && root.device-tag != "": Rectangle {
                        x: (root.device-dot-x * root.device-fit + 22 * root.device-fit + 4) * 1px;
                        y: (root.device-dot-y * root.device-fit - 9) * 1px;
                        width: tag-text.preferred-width + 12px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.agent-touch.with-alpha(0.9 * root.device-dot-alpha);
                        tag-text := Text {
                            x: 6px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.device-tag;
                            font-family: Theme.font-ui;
                            font-size: 11px;
                            color: white.with-alpha(root.device-dot-alpha);
                        }
                    }
                    if root.device-glow > 0: Rectangle {
                        border-radius: parent.border-radius;
                        border-width: 3px;
                        border-color: Theme.agent-touch.with-alpha(0.9 * root.device-glow);
                    }
                    if root.device-glow > 0: Rectangle {
                        x: 3px;
                        y: 3px;
                        width: parent.width - 6px;
                        height: parent.height - 6px;
                        border-radius: max(0px, parent.border-radius - 3px);
                        border-width: 6px;
                        border-color: Theme.agent-touch.with-alpha(0.3 * root.device-glow);
                    }
                }
                // The keyboard badge: a pill under the finger dot, or at the bottom centre with no dot.
                if root.device-state == 0 && root.device-badge != "": Rectangle {
                    property <length> pic-x: (parent.width - root.device-pic-w) / 2;
                    property <length> pic-y: (parent.height - root.device-pic-h) / 2;
                    width: badge-text.preferred-width + 20px;
                    height: 24px;
                    x: root.device-dot ? max(0px, min(parent.width - self.width, self.pic-x + root.device-dot-x * root.device-fit * 1px - self.width / 2)) : (parent.width - self.width) / 2;
                    y: root.device-dot ? min(parent.height - self.height, self.pic-y + (root.device-dot-y + 30) * root.device-fit * 1px) : self.pic-y + root.device-pic-h - self.height - 24px;
                    border-radius: 12px;
                    background: Theme.agent-touch;
                    accessible-role: text;
                    accessible-label: root.device-badge;
                    badge-text := Text {
                        x: 10px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.device-badge;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: white;
                    }
                }
                device-keys := FocusScope {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.kind == 5 && root.device-state == 0 && root.device-has-frame;
                    key-pressed(e) => {
                        // The window's chords (Cmd or Ctrl held) stay the window's.
                        if e.modifiers.control || e.modifiers.meta {
                            return reject;
                        }
                        root.device-key(true, e.text, (e.modifiers.shift ? 1 : 0) + (e.modifiers.alt ? 4 : 0), e.repeat);
                        accept
                    }
                    key-released(e) => {
                        if e.modifiers.control || e.modifiers.meta {
                            return reject;
                        }
                        root.device-key(false, e.text, (e.modifiers.shift ? 1 : 0) + (e.modifiers.alt ? 4 : 0), false);
                        accept
                    }
                    if root.device-state == 0 && root.device-has-frame: TouchArea {
                        width: parent.width;
                        height: parent.height;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                device-keys.focus();
                                root.device-menu-open = false;
                            }
                            root.device-pointer(
                                e.kind == PointerEventKind.down ? 0 : (e.kind == PointerEventKind.up ? 1 : (e.kind == PointerEventKind.move ? 2 : 3)),
                                self.mouse-x, self.mouse-y,
                                e.button == PointerEventButton.left ? 0 : (e.button == PointerEventButton.middle ? 1 : (e.button == PointerEventButton.right ? 2 : 3)),
                                (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0));
                        }
                        changed has-hover => {
                            if !self.has-hover {
                                root.device-pointer(3, self.mouse-x, self.mouse-y, 0, 0);
                            }
                        }
                        scroll-event(e) => {
                            root.device-wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, (e.modifiers.shift ? 1 : 0) + (e.modifiers.control ? 2 : 0) + (e.modifiers.alt ? 4 : 0) + (e.modifiers.meta ? 8 : 0));
                            accept
                        }
                    }
                }
                // Still pictures: the badge at the top left of the panel (spec "Fallbacks", rule 1312).
                if root.device-still != "": Rectangle {
                    x: Px.snap(8px);
                    y: Px.snap(10px);
                    width: Px.snap(still-text.preferred-width + 26px);
                    height: Px.snap(20px);
                    border-radius: Px.snap(10px);
                    background: Theme.side-flat;
                    border-width: Px.hair();
                    border-color: Theme.divider;
                    accessible-role: text;
                    accessible-label: "Still pictures";
                    Rectangle {
                        x: Px.snap(8px);
                        y: (parent.height - self.height) / 2;
                        width: Px.snap(6px);
                        height: Px.snap(6px);
                        border-radius: Px.snap(3px);
                        background: Theme.widget-warn;
                    }
                    still-text := Text {
                        x: Px.snap(20px);
                        height: parent.height;
                        vertical-alignment: center;
                        text: "Still";
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        color: Theme.text-soft;
                    }
                }
                // One line along the bottom: the still line, or "Connecting touch...", or "Driven from ...".
                if (root.device-state == 0) && (root.device-still != "" || root.device-foot != ""): Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: Px.snap(foot-text.preferred-height + 16px);
                    background: Theme.ground.with-alpha(0.9);
                    // At the top: an element with no y is centred.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: Px.hair();
                        background: Theme.divider;
                    }
                    foot-text := Text {
                        x: Px.snap(12px);
                        width: parent.width - Px.snap(24px);
                        height: parent.height;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        text: root.device-still != "" ? root.device-still : root.device-foot;
                        font-family: Theme.font-ui;
                        font-size: 11.5px;
                        color: Theme.dim;
                    }
                }
                // A setup state (rule 1318): one line and at most one button; booting adds a still ring (nothing
                // here moves on its own: the seconds in the line come from the controller).
                Rectangle {
                    visible: root.device-state == 1 || root.device-state == 3;
                    VerticalLayout {
                    x: Px.snap(16px);
                    width: parent.width - Px.snap(32px);
                    alignment: center;
                    spacing: Px.snap(12px);
                    if root.device-state == 3: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: Px.snap(18px);
                            height: Px.snap(18px);
                            border-radius: Px.snap(9px);
                            border-width: Px.snap(2px);
                            border-color: Theme.accent-solid;
                        }
                    }
                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: root.device-line;
                        font-family: Theme.font-ui;
                        font-size: 12.5px;
                        color: Theme.dim;
                    }
                    // Google's licence text (Android setup, spec "Setup", 2): read before anything is downloaded.
                    if root.device-detail != "": Rectangle {
                        height: Px.snap(min(220px, root.height * 0.45));
                        border-radius: Theme.radius-button;
                        border-width: Px.hair();
                        border-color: Theme.divider;
                        clip: true;
                        accessible-role: text;
                        accessible-label: root.device-detail;
                        licence-flick := Flickable {
                            x: Px.snap(8px);
                            y: Px.snap(6px);
                            width: parent.width - Px.snap(16px);
                            height: parent.height - Px.snap(12px);
                            content-width: self.width;
                            content-height: licence-text.preferred-height;
                            licence-text := Text {
                                width: licence-flick.width;
                                wrap: word-wrap;
                                text: root.device-detail;
                                font-family: Theme.font-ui;
                                font-size: 11px;
                                color: Theme.dim;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Px.snap(8px);
                        height: root.device-button != "" ? Px.snap(28px) : 0px;
                        device-setup-btn := Rectangle {
                            width: root.device-button != "" ? Px.snap(setup-text.preferred-width + 28px) : 0px;
                            height: Px.snap(28px);
                            border-radius: Theme.radius-button;
                            background: setup-ta.has-hover ? Theme.hover : transparent;
                            border-width: Px.hair();
                            border-color: Theme.divider;
                            accessible-role: button;
                            accessible-label: root.device-button;
                            accessible-action-default => { root.device-setup(); }
                            setup-text := Text {
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: root.device-button;
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.text;
                            }
                            setup-ta := TouchArea {
                                clicked => { root.device-setup(); }
                            }
                        }
                        // The licence's second button: back out, nothing downloaded.
                        if root.device-has-cancel: Rectangle {
                            width: Px.snap(cancel-text.preferred-width + 28px);
                            height: Px.snap(28px);
                            border-radius: Theme.radius-button;
                            background: cancel-ta.has-hover ? Theme.hover : transparent;
                            border-width: Px.hair();
                            border-color: Theme.divider;
                            accessible-role: button;
                            accessible-label: "Cancel";
                            accessible-action-default => { root.device-cancel(); }
                            cancel-text := Text {
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                text: "Cancel";
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.text;
                            }
                            cancel-ta := TouchArea {
                                clicked => { root.device-cancel(); }
                            }
                        }
                    }
                    }
                }
                // Choose a device: the list (iPhones first, newest first, a dot on the ones that run).
                if root.device-state == 2: VerticalLayout {
                    x: (parent.width - self.width) / 2;
                    width: min(parent.width - Px.snap(32px), Px.snap(260px));
                    alignment: center;
                    spacing: Px.snap(12px);
                    Text {
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        text: root.device-line;
                        font-family: Theme.font-ui;
                        font-size: 12.5px;
                        color: Theme.dim;
                    }
                    Rectangle {
                        height: Px.snap(34px) * root.device-rows.length;
                        border-radius: Theme.radius-button;
                        border-width: Px.hair();
                        border-color: Theme.divider;
                        clip: true;
                        for row[i] in root.device-rows: Rectangle {
                            y: Px.snap(34px) * i;
                            height: Px.snap(34px);
                            background: row-ta.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: row.name;
                            accessible-action-default => { root.device-pick(i); }
                            // At the row's top: an element with no y is centred, which drew the rule through the text.
                            if i > 0: Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: Px.hair();
                                background: Theme.divider;
                            }
                            if row.booted: Rectangle {
                                x: Px.snap(10px);
                                y: (parent.height - self.height) / 2;
                                width: Px.snap(6px);
                                height: Px.snap(6px);
                                border-radius: Px.snap(3px);
                                background: Theme.accent;
                            }
                            Text {
                                x: Px.snap(22px);
                                width: parent.width * 0.6 - Px.snap(22px);
                                height: parent.height;
                                vertical-alignment: center;
                                text: row.name;
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                x: parent.width * 0.6;
                                width: parent.width * 0.4 - Px.snap(10px);
                                height: parent.height;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                text: row.booted ? row.os + ", on" : row.os;
                                font-family: Theme.font-ui;
                                font-size: 11.5px;
                                color: Theme.dim;
                                overflow: elide;
                            }
                            row-ta := TouchArea {
                                clicked => { root.device-pick(i); }
                            }
                        }
                    }
                }
            }
            img := ImageView {
                width: parent.width;
                height: parent.height;
                visible: root.kind == 1;
                picture: root.picture;
                checker: root.checker;
                has-alpha: root.has-alpha;
                actual <=> root.actual;
                pressed => { root.pressed(); }
            }
            txt := TextView {
                width: parent.width;
                height: parent.height;
                visible: root.kind == 2;
                lines: root.lines;
                max-cols: root.max-cols;
                foot: root.foot;
                nums: root.line-nums;
                wrapped: root.wrapped;
                wrapped-cols: root.wrapped-cols;
                number-count: root.number-count;
                sel-on: root.sel-on;
                sel-a-row: root.sel-a-row;
                sel-a-col: root.sel-a-col;
                sel-b-row: root.sel-b-row;
                sel-b-col: root.sel-b-col;
                pressed => { root.pressed(); }
                text-down(x, y, shift) => { root.text-down(x, y, shift); }
                text-move(x, y) => { root.text-move(x, y); }
                text-up => { root.text-up(); }
            }
            changes := ChangesView {
                width: parent.width;
                height: parent.height;
                visible: root.kind == 4;
                files: root.convo-files;
                rows: root.convo-rows;
                max-cols: root.convo-max-cols;
                selected: root.convo-selected;
                select(p) => { root.convo-select(p); }
                open(p) => { root.convo-open(p); }
                pressed => { root.pressed(); }
            }
            if root.note != "": PanelNote {
                width: parent.width;
                height: parent.height;
                text: root.note;
            }
            if root.web-missing-runtime && root.kind == 3: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height / 2 + Px.snap(56px);
                width: Px.snap(190px);
                height: Px.snap(28px);
                border-radius: Theme.radius-button;
                background: dl-ta.has-hover ? Theme.hover : transparent;
                border-width: Px.hair();
                border-color: Theme.divider;
                accessible-role: button;
                accessible-label: "Open the download page";
                accessible-action-default => { root.web-download(); }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Open the download page";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-family: Theme.font-ui;
                    font-size: 12px;
                    color: Theme.text;
                }
                dl-ta := TouchArea {
                    clicked => { root.web-download(); }
                }
            }
        }
        // The device's More menu, under its button; a press outside it closes it.
        if root.device-menu-shown: TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.device-menu-open = false; }
        }
        if root.device-menu-shown: Rectangle {
            x: parent.width - self.width - Px.snap(30px);
            y: root.header-h - Px.snap(2px);
            width: Px.snap(170px);
            height: menu-col.preferred-height;
            border-radius: Theme.radius-button;
            background: Theme.side-flat;
            border-width: Px.hair();
            border-color: Theme.divider;
            drop-shadow-offset-y: Px.snap(6px);
            drop-shadow-blur: Px.snap(18px);
            drop-shadow-color: black.with-alpha(0.5);
            menu-col := VerticalLayout {
                padding-top: Px.snap(4px);
                padding-bottom: Px.snap(4px);
                // Each source's own buttons (rule 1371): Android has Back and Recents, iOS Shake.
                for item in root.device-android ? [
                    { act: "back", text: "Back" },
                    { act: "recents", text: "Recents" },
                    { act: "volume_up", text: "Volume up" },
                    { act: "volume_down", text: "Volume down" },
                    { act: "choose", text: "Choose device" },
                    { act: "shutdown", text: "Shut down" },
                ] : [
                    { act: "shake", text: "Shake" },
                    { act: "volume_up", text: "Volume up" },
                    { act: "volume_down", text: "Volume down" },
                    { act: "choose", text: "Choose device" },
                    { act: "shutdown", text: "Shut down" },
                ]: DeviceMenuRow {
                    text: item.text;
                    activated => {
                        root.device-menu-open = false;
                        root.device-act(item.act);
                    }
                }
            }
        }
        // The slow mark's reason, under it while the pointer rests on it.
        if root.kind == 5 && root.device-slow != "" && slow-ta.has-hover: Rectangle {
            x: max(Px.snap(8px), parent.width - Px.snap(260px) - Px.snap(8px));
            y: root.header-h + Px.snap(4px);
            width: Px.snap(260px);
            height: Px.snap(slow-tip.preferred-height + 12px);
            border-radius: Theme.radius-button;
            background: Theme.side-flat;
            border-width: Px.hair();
            border-color: Theme.divider;
            slow-tip := Text {
                x: Px.snap(8px);
                width: parent.width - Px.snap(16px);
                height: parent.height;
                vertical-alignment: center;
                wrap: word-wrap;
                text: root.device-slow;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: Theme.side-text;
            }
        }
        // The slot's left edge: a hairline, the splitter's visible part.
        Rectangle {
            x: 0px;
            width: Px.hair();
            height: parent.height;
            background: Theme.divider;
        }
    }
}
