// The tab sidebar (Task 21): PT TabSidebar.tsx. One card per tab, an icon band at its left,
// the name over its folder, the ring or X at its end; a find box above, a New tab button below,
// a grip on its right edge. Every edge between surfaces is a whole device pixel (Px).
import { Theme, Px } from "theme.slint";
import { Glyphs } from "glyphs.slint";
import { TabRow } from "types.slint";
import { MarkRing, MarkBar, AgentIcon } from "tabmark.slint";
import { LoadingRing } from "tabs.slint";

// One 46 px slot of the column; the visible card moves inside it by the carry offset.
component SideRow inherits Rectangle {
    in property <TabRow> tab;
    in property <int> index;
    in property <bool> carrying;
    callback press(length /*pointer y, window*/);
    callback drag-moved(length);
    callback drag-released();
    callback closed();
    callback tab-menu(length, length);
    callback tip(string, length, length, length, length);

    property <bool> left-held: false;
    property <bool> hov: ta.has-hover || xta.has-hover;
    // The ring of a tab coming back; the X slides in beside it on hover.
    property <int> ring-state: root.tab.mark-kind == 1 ? root.tab.mark-state : 0;
    property <bool> has-ring: root.tab.loading || root.ring-state != 0;
    property <length> x-w: root.has-ring ? (root.hov ? 18px : 0px) : 18px;
    property <length> end-w: root.has-ring ? (18px + (root.hov ? 20px : 0px)) : 18px;
    // Where the card's 8 px corner curve ends on the bar's bottom device row, rounded up to a whole device pixel.
    // The software renderer ignores a clip's border-radius, so the Bar starts and ends here instead of
    // being clipped by the corner: no bar pixel ever lies outside the rounded card, in either renderer.
    property <float> inset-css: 8 - Math.sqrt(64 - Math.pow(8 - 0.5 / Px.scale, 2));
    property <length> bar-inset: Math.ceil(root.inset-css * Px.scale) / Px.scale * 1px;
    height: 46px;

    card := Rectangle {
        x: 8px;
        y: root.tab.offset;
        width: parent.width - 16px;
        height: 46px;
        border-radius: 8px;
        clip: true;
        background: root.tab.active ? Theme.accent-hi.with-alpha(0.14)
            : (root.hov ? Theme.text.with-alpha(0.06) : Theme.text.with-alpha(0.03));

        ta := TouchArea {
            mouse-cursor: root.carrying ? MouseCursor.grabbing : MouseCursor.default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.left-held = true;
                    root.tip("", 0px, 0px, 0px, 0px);
                    root.press(self.mouse-y + card.absolute-position.y);
                } else if (e.kind == PointerEventKind.up) {
                    if (e.button == PointerEventButton.left) {
                        root.left-held = false;
                        root.drag-released();
                    } else if (e.button == PointerEventButton.middle) {
                        root.closed();
                    } else if (e.button == PointerEventButton.right) {
                        root.tab-menu(self.mouse-x + card.absolute-position.x, self.mouse-y + card.absolute-position.y);
                    }
                }
            }
            moved => {
                if (root.left-held) {
                    root.drag-moved(self.mouse-y + card.absolute-position.y);
                }
            }
            changed has-hover => {
                if (self.has-hover && !self.pressed) {
                    root.tip(root.tab.tip != "" ? root.tab.tip : root.tab.label,
                        card.absolute-position.x, card.absolute-position.y, card.width, card.height);
                } else if (!self.has-hover && !xta.has-hover) {
                    root.tip("", 0px, 0px, 0px, 0px);
                }
            }
        }

        // The icon band: a square the card's height, a shade lighter than the card.
        Rectangle {
            x: 0px;
            width: 46px;
            height: 46px;
            background: Theme.text.with-alpha(0.05);
            AgentIcon {
                x: (46px - 18px) / 2;
                y: (46px - 18px) / 2;
                kind: root.tab.settings ? 3 : root.tab.agent;
                ink: Theme.side-text;
            }
        }

        // The name over the folder it sits in.
        VerticalLayout {
            x: 56px;
            y: 0px;
            width: max(0px, card.width - 56px - 8px - root.end-w - 10px);
            height: 46px;
            alignment: center;
            padding-top: 4px;
            padding-bottom: 4px;
            Text {
                text: root.tab.label;
                color: Theme.side-text;
                font-size: 13px;
                font-weight: root.tab.active ? 600 : 400;
                overflow: elide;
            }
            if !root.tab.settings && root.tab.folder != "": Text {
                text: root.tab.folder;
                color: Theme.side-dim;
                font-size: 11.5px;
                overflow: elide;
            }
        }

        // The Bar mark along the row's foot, inside the card's rounded corners.
        if root.tab.mark-kind >= 2 : MarkBar {
            x: root.bar-inset;
            y: card.height - self.height;
            width: card.width - 2 * root.bar-inset;
            kind: root.tab.mark-kind;
            state: root.tab.mark-state;
            colour: root.tab.mark-color;
            rainbow: root.tab.mark-rainbow;
        }

        // The end: the loading ring or the mark ring when there is one, and the X.
        end := Rectangle {
            x: card.width - 8px - root.end-w;
            y: (46px - 18px) / 2;
            width: root.end-w;
            height: 18px;
            clip: true;
            animate width { duration: 150ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

            if root.tab.loading: LoadingRing {
                x: 0px;
                width: 18px;
                height: 18px;
            }
            if !root.tab.loading && root.ring-state != 0: Rectangle {
                x: 0px;
                width: 18px;
                height: 18px;
                MarkRing {
                    x: Px.snap((parent.width - self.width) / 2);
                    y: Px.snap((parent.height - self.height) / 2);
                    state: root.ring-state;
                    ink: Theme.side-text;
                }
            }
            Rectangle {
                x: root.has-ring ? 20px : 0px;
                width: root.x-w;
                height: 18px;
                clip: true;
                animate width { duration: 150ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 2px;
                    opacity: (root.tab.active || root.hov) ? 1 : 0;
                    background: xta.has-hover ? Theme.hover-hi : transparent;
                    // Slint fits the path into its box less the stroke: the box is grown by one stroke and moved back by half.
                    Path {
                        width: 10px + 2.4 * 10px / 24;
                        height: 10px + 2.4 * 10px / 24;
                        x: 4px - (2.4 * 10px / 24) / 2;
                        y: 4px - (2.4 * 10px / 24) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Glyphs.close;
                        fill: transparent;
                        stroke: xta.has-hover ? Theme.text : Theme.icon;
                        stroke-width: 2.4 * 10px / 24;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                }
            }
        }
        // Above the row's own TouchArea, so a press on the X never starts a carry.
        xta := TouchArea {
            x: end.x + (root.tab.loading ? 20px : 0px);
            y: end.y;
            width: root.has-ring ? root.x-w : 18px;
            height: 18px;
            enabled: root.tab.active || root.hov || root.has-ring;
            clicked => { root.closed(); }
        }
    }
}

export component TabSidebar inherits Rectangle {
    in property <[TabRow]> rows;                // `kept` hides a row; `offset` is the carry offset along y
    in property <bool> collapsed;               // not pinned: takes no room, slides over the terminal
    in property <bool> revealed;                // collapsed and slid out
    in property <length> side-width: 220px;     // 150..420, already Px.snap'd by the glue
    in property <bool> sliding;                 // a pin/unpin slide is running: the SLOT animates too
    in property <bool> carrying;
    in-out property <string> find-text <=> find-input.text;
    in property <string> find-key;
    in property <string> new-tab-title;
    out property <bool> find-has-focus: find-input.has-focus;
    out property <length> slot-width: collapsed ? 0px : side-width;
    out property <length> slot-visual: slot.width;
    out property <length> panel-left: panel.x;
    callback press(string, int, length, length, length, length);
    callback drag-moved(length);
    callback drag-released();
    callback closed(string);
    callback tab-menu(string, length, length);
    callback new-tab();
    callback plus-menu(length, length);
    callback find-edited(string);
    callback find-accepted();
    callback find-escape();
    callback grip-moved(length);
    callback grip-released(length);
    callback tip(string, length, length, length, length);
    public function focus-find() { find-input.focus(); }

    // The room it takes now: eases to `slot-width` while a pin/unpin slide runs.
    slot := Rectangle {
        width: root.slot-width;
        height: 0px;
        animate width { duration: root.sliding ? 240ms : 0ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }

    // Hidden, the panel waits side-width + CORNER_R off the edge, so its right edge and the cut travel together.
    // The slide is eased by this helper and the panel takes it rounded to a whole device pixel: on a
    // fractional x the panel's edge and the corner's edge each cover part of one pixel and leave a seam
    // (the e2e verticalTabs corner read 4 px short on such a frame).
    slide := Rectangle {
        x: (root.collapsed && !root.revealed) ? -(root.side-width + 10px) : 0px;
        width: 0px;
        height: 0px;
        animate x {
            duration: (root.collapsed || root.sliding) ? 240ms : 0ms;
            easing: cubic-bezier(0.16, 1, 0.3, 1);
        }
    }

    panel := Rectangle {
        x: Px.snap(slide.x);
        y: 0px;
        width: root.side-width;
        height: root.height;
        background: Theme.secondary;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            // The find box: margins 8 / 10 / 8 / 8, 32 high.
            Rectangle {
                height: 50px;
                Rectangle {
                    x: 8px;
                    y: 10px;
                    width: parent.width - 16px;
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.hover;
                    border-width: find-input.has-focus ? Px.hair() : 0px;
                    border-color: Theme.accent-hi;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: stretch;
                        // The 14 px slot; the path is grown by one stroke and moved back by half (see the close X).
                        Rectangle {
                            width: 14px;
                            Path {
                                width: 14px + 1.8 * 14px / 24;
                                height: 14px + 1.8 * 14px / 24;
                                x: -(1.8 * 14px / 24) / 2;
                                y: (32px - 14px) / 2 - (1.8 * 14px / 24) / 2;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: Glyphs.search;
                                fill: transparent;
                                stroke: Theme.dim;
                                stroke-width: 1.8 * 14px / 24;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            FocusScope {
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.find-escape();
                                        return accept;
                                    }
                                    reject
                                }
                                find-input := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accessible-role: text-input;
                                    accessible-label: "Find a tab";
                                    edited => { root.find-edited(self.text); }
                                    accepted => { root.find-accepted(); }
                                }
                            }
                            if find-input.text == "": Text {
                                text: "Find a tab";
                                color: Theme.dim;
                                font-size: 13px;
                                vertical-alignment: center;
                                height: parent.height;
                                x: 0px;
                                width: parent.width;
                                overflow: elide;
                            }
                        }
                        if find-input.text == "": Text {
                            text: root.find-key;
                            color: Theme.dim2;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // The rows: a Flickable with no bar, 8 under the last card.
            flick := Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: rows-col.preferred-height + 8px;
                interactive: false;
                rows-col := VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    for row[i] in root.rows: SideRow {
                        tab: row;
                        index: i;
                        visible: row.kept;
                        height: row.kept ? 46px : 0px;
                        carrying: root.carrying;
                        press(y) => {
                            root.press(row.id, i, y, rows-col.absolute-position.y,
                                flick.absolute-position.y, flick.absolute-position.y + flick.height);
                        }
                        drag-moved(y) => { root.drag-moved(y); }
                        drag-released => { root.drag-released(); }
                        closed => { root.closed(row.id); }
                        tab-menu(x, y) => { root.tab-menu(row.id, x, y); }
                        tip(t, x, y, w, h) => { root.tip(t, x, y, w, h); }
                    }
                }
            }

            // The foot: a hairline on top, then the New tab button.
            Rectangle {
                height: Px.hair() + 8px + 34px + 8px;
                Rectangle {
                    y: 0px;
                    height: Px.hair();
                    background: Theme.divider;
                }
                Rectangle {
                    x: 8px;
                    y: Px.hair() + 8px;
                    width: parent.width - 16px;
                    height: 34px;
                    border-radius: 6px;
                    border-width: Px.hair();
                    border-color: Theme.divider;
                    background: foot-ta.has-hover ? Theme.hover-hi : Theme.hover;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        // The 13 px slot; the path is grown by one stroke and moved back by half (see the close X).
                        Rectangle {
                            width: 13px;
                            Path {
                                width: 13px + 2.2 * 13px / 24;
                                height: 13px + 2.2 * 13px / 24;
                                x: -(2.2 * 13px / 24) / 2;
                                y: (34px - 13px) / 2 - (2.2 * 13px / 24) / 2;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: Glyphs.plus-sidebar;
                                fill: transparent;
                                stroke: Theme.text;
                                stroke-width: 2.2 * 13px / 24;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                        }
                        Text {
                            text: "New tab";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    foot-ta := TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                root.new-tab();
                            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.plus-menu(self.mouse-x + self.absolute-position.x, self.mouse-y + self.absolute-position.y);
                            }
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip(root.new-tab-title, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                            } else {
                                root.tip("", 0px, 0px, 0px, 0px);
                            }
                        }
                    }
                }
            }
        }

        // Collapsed: the OUTSIDE corner where the panel meets the bar, and its right line.
        if root.collapsed: Rectangle {
            x: parent.width;
            y: 0px;
            width: 10px;
            height: 10px;
            Path {
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M0 0H10A10 10 0 0 0 0 10Z";
                fill: Theme.secondary;
            }
            Path {
                width: 10px;
                height: 10px;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M10 0A10 10 0 0 0 0 10";
                fill: transparent;
                stroke: Theme.divider;
                stroke-width: Px.hair();
            }
        }
        if root.collapsed: Rectangle {
            x: parent.width - Px.hair();
            y: 10px;
            width: Px.hair();
            height: parent.height - 10px;
            background: Theme.divider;
        }

        // The grip: a 6 px target on the right edge, a hairline inside it.
        if !(root.collapsed && !root.revealed): grip := TouchArea {
            x: parent.width - Px.snap(3px);
            y: 0px;
            width: Px.snap(6px);
            height: parent.height;
            mouse-cursor: MouseCursor.col-resize;
            moved => {
                if (self.pressed) {
                    root.grip-moved(root.side-width + (self.mouse-x - self.pressed-x));
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    root.grip-released(root.side-width + (self.mouse-x - self.pressed-x));
                }
            }
            Rectangle {
                x: Px.snap(2px);
                width: Px.hair();
                background: grip.pressed ? Theme.accent-hi
                    : (grip.has-hover ? Theme.accent-hi.with-alpha(0.6) : transparent);
                animate background { duration: 150ms; }
            }
        }
    }
}

export component TabSidebarPreview inherits Window {
    title: "Flare sidebar";
    width: 700px;
    height: 500px;
    background: Theme.ground;
    in property <[TabRow]> rows;
    in property <bool> collapsed;
    in property <bool> revealed;
    in property <length> side-width: 220px;
    in property <bool> sliding;
    in property <bool> carrying;
    in-out property <string> find-text <=> sb.find-text;
    // The label comes from the chord table (the tests set it); never typed by hand here.
    in property <string> find-key;
    in property <string> new-tab-title: "New tab (Ctrl+T). Right-click for recent folders";
    out property <bool> find-has-focus: sb.find-has-focus;
    out property <length> slot-width: sb.slot-width;
    out property <length> slot-visual: sb.slot-visual;
    out property <length> panel-left: sb.panel-left;
    out property <float> win-scale: 1px / 1phx;
    callback press(string, int, length, length, length, length);
    callback drag-moved(length);
    callback drag-released();
    callback closed(string);
    callback tab-menu(string, length, length);
    callback new-tab();
    callback plus-menu(length, length);
    callback find-edited(string);
    callback find-accepted();
    callback find-escape();
    callback grip-moved(length);
    callback grip-released(length);
    callback tip(string, length, length, length, length);
    public function focus-find() { sb.focus-find(); }
    changed win-scale => { Px.scale = root.win-scale; }
    init => { Px.scale = root.win-scale; }

    sb := TabSidebar {
        x: 0px;
        y: 0px;
        width: root.side-width;
        height: root.height;
        rows: root.rows;
        collapsed: root.collapsed;
        revealed: root.revealed;
        side-width: root.side-width;
        sliding: root.sliding;
        carrying: root.carrying;
        find-key: root.find-key;
        new-tab-title: root.new-tab-title;
        press(a, b, c, d, e, f) => { root.press(a, b, c, d, e, f); }
        drag-moved(y) => { root.drag-moved(y); }
        drag-released => { root.drag-released(); }
        closed(id) => { root.closed(id); }
        tab-menu(id, x, y) => { root.tab-menu(id, x, y); }
        new-tab => { root.new-tab(); }
        plus-menu(x, y) => { root.plus-menu(x, y); }
        find-edited(t) => { root.find-edited(t); }
        find-accepted => { root.find-accepted(); }
        find-escape => { root.find-escape(); }
        grip-moved(w) => { root.grip-moved(w); }
        grip-released(w) => { root.grip-released(w); }
        tip(t, x, y, w, h) => { root.tip(t, x, y, w, h); }
    }
}
