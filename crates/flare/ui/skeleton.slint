// The resume skeleton (M6, Task 26): the page of lines a restored agent tab shows while its
// conversation resumes (PT ResumeSkeleton.tsx). The ground and the ink come from the theme; a
// line is the ink at 7 percent; the lines pulse on MarkMotion's clock and stand still when asked.
import { Px, Theme } from "theme.slint";
import { MarkMotion } from "tabmark.slint";

// One line: 11 px high (snapped), 4 px corners, the ink at 7 percent.
component SkeletonLine inherits Rectangle {
    in property <length> line-w;
    in property <color> ink;
    width: Px.snap(root.line-w);
    height: Px.snap(11px);
    border-radius: 4px;
    background: root.ink.with-alpha(0.07);
}

export component ResumeSkeleton inherits Rectangle {
    in property <bool> leaving: false;        // fading out: 180 ms, then the Rust side drops it
    in property <color> ground;               // the terminal ground (--p-bg)
    in property <color> ink;                  // the theme's text colour (--p-text)

    // The padding is 16 px on the left, right and top; the column is the width inside it.
    property <length> pad: Px.snap(16px);
    property <length> inner-w: root.width - 2 * root.pad;
    // The header's logo column is 9 percent of the width, at least 64 px; a 24 px gap follows.
    property <length> logo-w: Px.snap(max(64px, root.inner-w * 0.09));
    property <length> text-w: root.inner-w - root.logo-w - Px.snap(24px);
    property <length> block-gap: Px.snap(26px);
    property <length> line-gap: Px.snap(10px);

    background: root.ground;
    clip: true;
    opacity: root.leaving ? 0 : 1;
    animate opacity { duration: 180ms; easing: ease; }

    // The whole page pulses: 1.0 when still, otherwise the clock's pulse.
    Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.inner-w;
        height: root.height - root.pad;
        opacity: MarkMotion.still ? 1.0 : MarkMotion.pulse;

        VerticalLayout {
            width: parent.width;
            spacing: root.block-gap;

            HorizontalLayout {
                spacing: Px.snap(24px);
                height: Px.snap(53px);
                VerticalLayout {
                    width: root.logo-w;
                    spacing: root.line-gap;
                    SkeletonLine { line-w: root.logo-w * 0.9; ink: root.ink; }
                    SkeletonLine { line-w: root.logo-w; ink: root.ink; }
                    SkeletonLine { line-w: root.logo-w * 0.9; ink: root.ink; }
                }
                VerticalLayout {
                    width: root.text-w;
                    spacing: root.line-gap;
                    SkeletonLine { line-w: root.text-w * 0.26; ink: root.ink; }
                    SkeletonLine { line-w: root.text-w * 0.20; ink: root.ink; }
                    SkeletonLine { line-w: root.text-w * 0.38; ink: root.ink; }
                }
            }

            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.62; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.88; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.94; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.71; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.38; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.79; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.91; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.56; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.84; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.67; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.92; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.88; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.44; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.58; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.93; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.81; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.74; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.29; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.86; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.90; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.63; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.70; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.95; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.83; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.52; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.89; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.61; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.92; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.77; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.85; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.40; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.66; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.90; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.58; ink: root.ink; }
            }
            VerticalLayout {
                width: root.inner-w;
                spacing: root.line-gap;
                SkeletonLine { line-w: root.inner-w * 0.83; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.94; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.72; ink: root.ink; }
                SkeletonLine { line-w: root.inner-w * 0.47; ink: root.ink; }
            }
        }
    }
}

// The skeleton alone in a 400 x 300 window, for the component tests and the screenshots.
export component SkeletonPreview inherits Window {
    width: 400px;
    height: 300px;
    background: Theme.ground;

    in-out property <bool> leaving: false;
    in-out property <color> ground: Theme.ground;
    in-out property <color> ink: Theme.text;
    out property <float> win-scale: 1px / 1phx;
    changed win-scale => { Px.scale = self.win-scale; }
    init => { Px.scale = self.win-scale; }

    ResumeSkeleton {
        width: root.width;
        height: root.height;
        leaving: root.leaving;
        ground: root.ground;
        ink: root.ink;
    }
}
