// The agent board (Surfaces stage 7): one row for every tab that has an agent, with the agent's state, the folder, how
// long it has been in that state and, for a question, what it asks. A click on a row goes to that tab.
//
// The rows are made in Rust from what the agent hub already holds, so nothing here reads a file or polls. Row heights
// are fixed numbers (a plain row, a row with a question) that the e2e probe repeats, and every edge is a whole device
// pixel (`Px.snap`), as the rest of the chrome.

import { Theme, Px } from "theme.slint";
import { MarkRing } from "tabmark.slint";

// One tab with an agent. state: 0 idle, 1 working, 2 question, 3 finished, 4 failed (the tab marks' numbers).
export struct BoardRowUi {
    tab: string,
    name: string,
    agent: string,     // "Claude", "Codex"
    state: int,
    ink: color,        // the state's mark colour
    folder: string,
    status: string,    // "Working for 4m 12s", "Waiting 2m 00s"
    detail: string,    // the question, or why it failed; "" for the others
    current: bool,     // the tab in front
}

// A plain row, and a row that also carries a detail (up to two lines of the question).
export global BoardMetrics {
    out property <length> row-plain: 56px;
    out property <length> row-detail: 92px;
}

export component BoardView inherits Rectangle {
    in property <[BoardRowUi]> rows;
    callback pick(string);
    callback pressed();

    out property <int> row-count: root.rows.length;
    out property <length> content-h: col.preferred-height;

    public function scroll-by(dy: length) {
        flick.content-y = min(0px, max(root.height - flick.content-height, flick.content-y + dy));
    }
    public function scroll-to(top: bool) {
        flick.content-y = top ? 0px : min(0px, root.height - flick.content-height);
    }

    clip: true;
    flick := Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: max(col.preferred-height, root.height);
        col := VerticalLayout {
            width: flick.content-width;
            y: 0px;
            alignment: start;
            for r[i] in root.rows: Rectangle {
                height: Px.snap(r.detail == "" ? BoardMetrics.row-plain : BoardMetrics.row-detail);
                background: ta.has-hover ? Theme.hover : (r.current ? Theme.accent.with-alpha(0.12) : (r.state == 2 ? Theme.accent.with-alpha(0.07) : transparent));
                accessible-role: button;
                accessible-label: r.name + ", " + r.agent + ", " + r.status + (r.detail == "" ? "" : ", " + r.detail);
                accessible-action-default => { root.pick(r.tab); }

                // The state: the tab's own mark, or a quiet dot for an agent with nothing to say.
                if r.state != 0: MarkRing {
                    x: Px.snap(14px);
                    y: Px.snap(15px);
                    state: r.state;
                    ink: r.ink;
                }
                if r.state == 0: Rectangle {
                    x: Px.snap(17px);
                    y: Px.snap(18px);
                    width: Px.snap(6px);
                    height: Px.snap(6px);
                    border-radius: Px.snap(3px);
                    background: Theme.dim;
                }
                agent-text := Text {
                    x: parent.width - self.preferred-width - Px.snap(12px);
                    y: Px.snap(10px);
                    text: r.agent;
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: Theme.dim;
                }
                Text {
                    x: Px.snap(36px);
                    y: Px.snap(10px);
                    width: max(0px, agent-text.x - Px.snap(36px) - Px.snap(8px));
                    text: r.name;
                    wrap: no-wrap;
                    overflow: elide;
                    font-family: Theme.font-ui;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    x: Px.snap(36px);
                    y: Px.snap(31px);
                    width: parent.width - Px.snap(36px) - Px.snap(12px);
                    text: r.status + (r.folder == "" ? "" : "   " + r.folder);
                    wrap: no-wrap;
                    overflow: elide;
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: r.state == 2 || r.state == 4 ? r.ink : Theme.dim;
                }
                if r.detail != "": Text {
                    x: Px.snap(36px);
                    y: Px.snap(53px);
                    width: parent.width - Px.snap(36px) - Px.snap(12px);
                    height: Px.snap(32px);
                    text: r.detail;
                    wrap: word-wrap;
                    overflow: elide;
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: Theme.text;
                }
                Rectangle {
                    y: parent.height - Px.hair();
                    height: Px.hair();
                    background: Theme.divider;
                }
                ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.pressed();
                        }
                    }
                    clicked => { root.pick(r.tab); }
                }
            }
        }
    }
    // A thin thumb on the right edge, as the other panels'.
    Rectangle {
        visible: flick.content-height > root.height + 1px;
        x: root.width - self.width;
        y: 0px;
        width: Px.snap(6px);
        height: root.height;
        Rectangle {
            property <length> len: max(Px.snap(24px), root.height * root.height / max(flick.content-height, 1px));
            property <length> travel: root.height - self.len;
            property <float> at: flick.content-height > root.height ? min(1.0, max(0.0, -flick.content-y / (flick.content-height - root.height))) : 0.0;
            x: 0px;
            y: Px.snap(self.at * self.travel);
            width: parent.width;
            height: self.len;
            border-radius: Px.snap(3px);
            background: Theme.dim.with-alpha(0.45);
        }
    }
}
