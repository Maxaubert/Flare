// Prism Terminal's chrome tokens for its default theme 'pt-default', copied from
// PT v0.55.6 src/renderer/src/lib/__snapshots__/chromeTheme.opacity.test.ts.snap
// ("an opaque accent ... > pt-default", the glass entry at full alpha) and
// src/renderer/src/index.css. M4 derives these from the theme instead.
export global Theme {
    in property <color> ground: #171717;      // --p-bg, --p-tabs, --p-title
    in property <color> text: #dedacf;        // --p-text
    in property <color> icon: #929089;        // --p-icon
    in property <color> dim: #929089;         // --p-dim
    in property <color> hover-hi: #ffffff1c;  // --p-hover-hi
    in property <color> divider: #ffffff12;   // --p-divider
    in property <color> accent: #fe8f34;      // --p-accent
    in property <color> accent-hi: #f6a25b;   // --p-accent-hi
    out property <color> close-hover: #fb2c36cc; // Tailwind v4 red-500 at 80%
    out property <color> clawd: #d77757;       // Clawd as Claude Code draws it (flare_agent::icon::CLAWD_ORANGE); the agent's colour, never themed
    out property <[color]> agy: [#15aabf, #40c057, #94d82d, #fab005, #fd7e14, #fa5252, #e64980, #be4bdb, #7950f2, #4c6ef5]; // the agy icon (flare_agent::icon::AGY_COLOURS), along the arch; never themed
    out property <length> bar-height: 36px;    // chromeLayout.ts BAR_H
    out property <length> radius-button: 4px;  // Tailwind `rounded`
    out property <length> term-padding: 4px;   // TerminalPanel `p-1`

    // Task 19: pt-default's remaining chrome tokens (opaque values; the CSS variable is the comment).
    in property <color> tabs: #171717;        // --p-tabs (the title row and the strip)
    in property <color> tab-active: #171717;  // --p-tab-active
    in property <color> secondary: #0d0d0d;   // --p-secondary (the sidebar and the bar beside it)
    in property <color> text-soft: #c2bfb5;   // --p-text-soft
    in property <color> dim2: #716f6a;        // --p-dim2
    in property <color> hover: #ffffff0f;     // --p-hover
    in property <color> side-flat: #1f1f1e;   // --p-side-flat (menus, tips, dialogs, the +N list)
    in property <color> side-text: #dedacf;   // --p-side-text
    in property <color> side-dim: #959390;    // --p-side-dim
    in property <color> accent-solid: #fe8f34; // --p-accent-solid (the app mark, the loading ring)
    in property <color> on-accent: #0b0b0f;   // --p-on-accent
    in property <color> tree-folder: #f6a25b; // --p-tree-folder (folder glyphs)
    in property <color> control: #1e1e1d;     // --p-control

    // Task 22: the rest of the 31 chrome tokens, settable from the theme (pt-default values).
    in property <color> ground-solid: #171717; // --p-bg-solid
    in property <color> side: #171717;         // --p-side
    in property <color> title: #171717;        // --p-title
    in property <color> line: #ffffff17;       // --p-line
    in property <color> track: #5e5c59;        // --p-track
    in property <color> preview: #31302f;      // --p-preview
    in property <color> sel-bg: #fe8f34;       // --p-sel-bg
    in property <color> switch-knob: #0b0b0f;  // --p-switch-knob
    in property <color> pressed: #3d3c39;      // --p-pressed
    in property <color> pressed-ink: #dedacf;  // --p-pressed-ink

    // Flare's own inks (flare_theme::chrome::FLARE_EXTRA_TOKENS), each held on the fill it is drawn on.
    in property <color> secondary-text: #dedacf; // --f-secondary-text (text on the picked Secondary)
    in property <color> secondary-icon: #929089; // --f-secondary-icon (glyphs on the picked Secondary)
    in property <color> accent-ink: #f6a25b;     // --f-accent-ink (the accent as small text, 4.5:1)
    in property <color> hover-ink: #dedacf;      // --f-hover-ink (text on the chosen rail page)
    in property <color> pressed-text: #dedacf;   // --f-pressed-ink (text on a chosen segment)
    in property <color> track-off: #5e5c59;      // --f-track (the OFF switch track, 3:1 on the ground)

    // The window's own clear colour (PT's setBackgroundColor): the solid ground, or transparent under glass.
    in property <color> window-clear: #171717;
    // The thinnest a chrome glyph stroke may be, in device pixels: 2 under glass, 0 on a solid window
    // (audit V7; the title buttons and the new-tab +). Set from Rust beside window-clear.
    in property <float> glyph-stroke-floor: 0;
    // The window edge colour from edge_for (docs/material.md E4); transparent for none, maximised or full screen.
    in property <color> edge: transparent;
    // True when the measured ground is light (WCAG relative luminance above 0.4); set from Rust.
    in property <bool> light: false;
    out property <color> danger-fill: #b4353f; // Dialog danger
    out property <color> scrim: #00000080;     // Modal bg-black/50
    out property <string> font-ui: "Segoe UI"; // --p-font-ui

    // Milestone 5: the find bar's corner radius (--p-radius-sm) and the find inks (Prism Terminal's
    // findOptions; not theme-derived there either).
    out property <length> radius-sm: 3px;
    out property <color> find-match: #4a5160;
    out property <color> find-match-border: #6b7482;

    // M8 Task 26: the dictation widget's warning glyph (PT overlay.css .icon.warn), the same in every theme.
    out property <color> widget-warn: #f0b45a;
}

// Device-pixel helpers (Task 19). A global cannot use phx, so the window sets Px.scale from
// `1px / 1phx` (the window's scale factor) once at start and on every scale change.
export global Px {
    in-out property <float> scale: 1.0;
    // Rounds a length to a whole number of device pixels.
    pure public function snap(l: length) -> length { return round(l / 1px * scale) / scale * 1px; }
    // A hairline: max(1, floor(scale)) device pixels, the Chromium rule Prism Terminal's borders obeyed.
    pure public function hair() -> length { return max(1.0, floor(scale)) / scale * 1px; }
}

// Milestone 7 (Task 4): the settings tokens, Prism Terminal v0.55.6's numbers (Tailwind classes in PT/,
// measured in Task 3). This file is the one token file: every fixed settings colour lives here.
export global SettingsShape {
    out property <length> radius: 2px;          // --p-radius
    out property <length> radius-sm: 3px;       // --p-radius-sm
    out property <length> panel-radius: 5px;    // max(4, radius + 3)
    out property <length> tile-radius: 4px;     // max(4, radius - 1)
    out property <length> rail-w: 244px;
    out property <length> rail-narrow-w: 56px;
    out property <length> narrow-below: 760px;
    out property <length> row-min-h: 58px;
    out property <length> tile: 32px;
    out property <length> column-max: 960px;
    out property <length> switch-w: 36px;
    out property <length> switch-h: 20px;
    out property <length> switch-knob: 16px;
    out property <length> control-h: 32px;
    out property <length> select-min-w: 168px;
    out property <length> option-h: 28px;
    out property <length> slider-w: 168px;
    out property <length> slider-track-h: 6px;
    out property <length> slider-thumb: 18px;
    out property <length> popover-w: 226px;
    out property <length> sv-w: 200px;
    out property <length> sv-h: 140px;
    out property <length> bar-h: 12px;
    out property <length> bar-thumb: 16px;
    out property <length> card-w: 196px;
    out property <length> wall-gap: 12px;
    out property <length> help-min-w: 420px;
    out property <length> help-max-w: 1100px;
}

export global SettingsInk {
    // every one derived from Theme tokens, so a theme switch moves them with no code
    out property <color> panel-fill: Theme.text.with-alpha(0.036);       // color-mix(text 3.6%, transparent)
    out property <color> tile-fill: Theme.text.with-alpha(0.06);
    out property <color> row-hover: Theme.text.with-alpha(0.025);
    out property <color> sub: Theme.dim.mix(Theme.text, 0.72);            // color-mix(dim 72%, text)
    out property <color> warn: Theme.light ? SettingsFixed.warn-light.mix(Theme.text, 0.75) : SettingsFixed.warn-dark.mix(Theme.text, 0.85);
    out property <color> focus-edge: Theme.text.with-alpha(0.22);
    out property <color> flash: Theme.accent-hi.with-alpha(0.16);
    out property <color> help-stripe: Theme.text.with-alpha(0.04);
    out property <color> help-hover: Theme.text.with-alpha(0.09);
    out property <color> help-active: Theme.text.with-alpha(0.13);
    out property <color> help-well: Theme.light ? SettingsFixed.black.with-alpha(0.04) : SettingsFixed.black.with-alpha(0.16);
    out property <color> help-field: Theme.light ? SettingsFixed.black.with-alpha(0.03) : SettingsFixed.black.with-alpha(0.14);
    out property <color> help-focus-glow: Theme.accent.with-alpha(0.16);
    out property <color> selection: Theme.accent.with-alpha(0.45);
}

export global SettingsFixed {
    out property <color> warn-dark: #e0a84b;
    out property <color> warn-light: #a46400;
    out property <color> checker-a: #c4c4c4;
    out property <color> checker-b: #f4f4f4;
    out property <color> hue-red: #ff0000;
    out property <color> hue-yellow: #ffff00;
    out property <color> hue-green: #00ff00;
    out property <color> hue-cyan: #00ffff;
    out property <color> hue-blue: #0000ff;
    out property <color> hue-magenta: #ff00ff;
    out property <color> white: #ffffff;
    out property <color> black: #000000;
    out property <color> copied: #8fd47a;
    out property <color> copied-fill: #8fd47a29;   // 16 percent
    out property <color> copy-failed: #e0a100;
    out property <color> shadow: #00000040;
    out property <color> modal-shadow: #00000099;   // Modal.tsx: 0 24px 70px rgba(0,0,0,.6)
    in-out property <string> font-text: "Segoe UI Variable Text";
    in-out property <string> font-display: "Segoe UI Variable Display";
    out property <string> font-fallback: "Segoe UI";
    out property <string> font-mono: "Cascadia Mono";
}

// The icon artwork's own colours (assets/icon/flare-color.svg: the orange flame and the golden one over it,
// each a gradient from the first stop to the second), fixed: never part of a theme.
export global IconArt {
    out property <color> orange-from: #FF4800;
    out property <color> orange-to: #FF4000;
    out property <color> gold-from: #FFC500;
    out property <color> gold-to: #FFD000;
}

// Reduced motion, app-wide (parity line 37, PT index.css: every transition and animation drops to
// 0.01 ms). Rust sets `reduced` from `crate::e2e::animations_enabled()` with the other globals; every
// `animate` duration in the UI is wrapped in `Motion.d()` (scan: `no_animate_block_bypasses_the_motion_global`).
export global Motion {
    in property <bool> reduced: false;
    pure public function d(ms: duration) -> duration {
        return reduced ? 0ms : ms;
    }
}
