{
  "id": "notes",
  "name": "Notes",
  "version": "1.0.0",
  "protocol": 1,
  "description": "A notes panel the agent can add a line to, with the append_note tool.",
  "permissions": ["panel", "tools"],
  "panel": {
    "entry": "index.html",
    "title": "Notes"
  },
  "tools": [
    {
      "name": "append_note",
      "description": "Adds one line to the end of the Notes panel.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The line to add."
          }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    }
  ]
}
